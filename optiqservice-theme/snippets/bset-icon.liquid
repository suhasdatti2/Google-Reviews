{%- comment -%}
  Line icons, shared across every prem-/bset- page. 24px stroke geometry,
  currentColor, aria-hidden — the adjacent text is the accessible label.

  Accepts: name (shield | droplet | diamond | ring | card | box | spark |
  lock | clock | calendar | filter | database | message | transfer |
  handoff | analytics | mic | book | check-mini)
{%- endcomment -%}

{%- case name -%}
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8.6"/>
      <path d="M12 7.4V12l3.4 2"/>
    </svg>

  {%- when 'calendar' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="3.4" y="5" width="17.2" height="15.4" rx="1.8"/>
      <path d="M3.4 9.8h17.2M8 3v4M16 3v4"/>
    </svg>

  {%- when 'filter' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3.6 4.6h16.8l-6.4 7.6v6.2l-4 2v-8.2L3.6 4.6Z"/>
    </svg>

  {%- when 'database' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <ellipse cx="12" cy="5.6" rx="7.6" ry="2.6"/>
      <path d="M4.4 5.6V18c0 1.4 3.4 2.6 7.6 2.6s7.6-1.2 7.6-2.6V5.6M4.4 11.8c0 1.4 3.4 2.6 7.6 2.6s7.6-1.2 7.6-2.6"/>
    </svg>

  {%- when 'message' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3.6 5.8h16.8v10.4H9.4L4.8 20v-3.8H3.6V5.8Z"/>
      <path d="M7.6 9.4h9.6M7.6 12.6h6"/>
    </svg>

  {%- when 'transfer' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3.4 8.4h13.4l-3-3M20.6 15.6H7.2l3 3"/>
    </svg>

  {%- when 'handoff' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="7.4" cy="7" r="3"/>
      <path d="M2.6 19c0-3.4 2.2-5.6 4.8-5.6M14 21v-1.6c0-2.6 2.1-4.7 4.7-4.7h1.5M16.8 12.1l2.6 2.6-2.6 2.6"/>
    </svg>

  {%- when 'analytics' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3.6 20.6h16.8"/>
      <path d="M6.6 20.6v-6M12 20.6V9.4M17.4 20.6v-9.8"/>
    </svg>

  {%- when 'mic' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="9" y="2.8" width="6" height="11" rx="3"/>
      <path d="M5.6 11.4a6.4 6.4 0 0 0 12.8 0M12 17.8v3.4M8.8 21.2h6.4"/>
    </svg>

  {%- when 'book' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 4.8c2.4-1 5.4-1 8 .4 2.6-1.4 5.6-1.4 8-.4v14c-2.4-1-5.4-1-8 .4-2.6-1.4-5.6-1.4-8-.4V4.8Z"/>
      <path d="M12 5.2v14"/>
    </svg>

  {%- when 'check-mini' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m4.6 12.6 5 5 9.8-11.2"/>
    </svg>

  {%- when 'droplet' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3.2c3.1 3.4 5.4 6.3 5.4 9.1A5.4 5.4 0 0 1 12 17.7a5.4 5.4 0 0 1-5.4-5.4c0-2.8 2.3-5.7 5.4-9.1Z"/>
    </svg>

  {%- when 'diamond' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M6 4h12l3.2 5.1L12 20.4 2.8 9.1 6 4Z"/>
      <path d="M2.8 9.1h18.4M9 4l-1.4 5.1L12 20.4l4.4-11.3L15 4"/>
    </svg>

  {%- when 'ring' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="14.6" r="6.2"/>
      <path d="m8.6 8.9 1.5-5.3h3.8l1.5 5.3"/>
    </svg>

  {%- when 'card' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="2.6" y="5.2" width="18.8" height="13.6" rx="1.8"/>
      <path d="M2.6 9.8h18.8M6.2 14.6h4"/>
    </svg>

  {%- when 'box' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3.2 7.6 12 3.2l8.8 4.4v8.8L12 20.8l-8.8-4.4V7.6Z"/>
      <path d="m3.2 7.6 8.8 4.4 8.8-4.4M12 12v8.8"/>
    </svg>

  {%- when 'spark' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 2.8 13.9 9l6.2 1.9-6.2 1.9L12 19l-1.9-6.2L3.9 10.9 10.1 9 12 2.8Z"/>
    </svg>

  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="4.4" y="10.2" width="15.2" height="10.4" rx="1.8"/>
      <path d="M8 10.2V7.4a4 4 0 0 1 8 0v2.8"/>
    </svg>

  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 2.9l7.6 3v5.5c0 4.3-3 8.3-7.6 9.7-4.6-1.4-7.6-5.4-7.6-9.7V5.9l7.6-3Z"/>
      <path d="m9 11.9 2.2 2.2 4-4.2"/>
    </svg>
{%- endcase -%}
