{%- comment -%}
  Line icons for the Build Your Set feature list. 24px stroke geometry,
  currentColor, aria-hidden — the adjacent text is the accessible label.

  Accepts: name (shield | droplet | diamond | ring | card | box | spark | lock)
{%- endcomment -%}

{%- case name -%}
  {%- when 'droplet' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3.2c3.1 3.4 5.4 6.3 5.4 9.1A5.4 5.4 0 0 1 12 17.7a5.4 5.4 0 0 1-5.4-5.4c0-2.8 2.3-5.7 5.4-9.1Z"/>
    </svg>

  {%- when 'diamond' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M6 4h12l3.2 5.1L12 20.4 2.8 9.1 6 4Z"/>
      <path d="M2.8 9.1h18.4M9 4l-1.4 5.1L12 20.4l4.4-11.3L15 4"/>
    </svg>

  {%- when 'ring' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="14.6" r="6.2"/>
      <path d="m8.6 8.9 1.5-5.3h3.8l1.5 5.3"/>
    </svg>

  {%- when 'card' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="2.6" y="5.2" width="18.8" height="13.6" rx="1.8"/>
      <path d="M2.6 9.8h18.8M6.2 14.6h4"/>
    </svg>

  {%- when 'box' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3.2 7.6 12 3.2l8.8 4.4v8.8L12 20.8l-8.8-4.4V7.6Z"/>
      <path d="m3.2 7.6 8.8 4.4 8.8-4.4M12 12v8.8"/>
    </svg>

  {%- when 'spark' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 2.8 13.9 9l6.2 1.9-6.2 1.9L12 19l-1.9-6.2L3.9 10.9 10.1 9 12 2.8Z"/>
    </svg>

  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="4.4" y="10.2" width="15.2" height="10.4" rx="1.8"/>
      <path d="M8 10.2V7.4a4 4 0 0 1 8 0v2.8"/>
    </svg>

  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 2.9l7.6 3v5.5c0 4.3-3 8.3-7.6 9.7-4.6-1.4-7.6-5.4-7.6-9.7V5.9l7.6-3Z"/>
      <path d="m9 11.9 2.2 2.2 4-4.2"/>
    </svg>
{%- endcase -%}
