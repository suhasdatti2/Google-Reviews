{%- comment -%}
  Shared nav for the Premium world (/pages/premium-products and
  /pages/build-your-set). Extracted from premium-hero.liquid so the two pages
  cannot drift apart — one nav, rendered twice with each section's own
  settings.

  Accepts: wordmark, wordmark_sub, ring_label, ring_url, cards_label,
  cards_url. Every one is optional; the defaults below are the real
  destinations — Ring and Metal Cards both default to Build Your Set, the
  one page that actually sells both (with its own in-page switcher), so
  there is a single purchase destination rather than two competing ones.
  About and Collections were removed: both pointed at unbuilt placeholder
  pages, which have since been deleted.

  The cart count carries data-o-cart-count so the theme's cart controller
  (assets/optiq-cart.js) repaints it after an AJAX add — a server-rendered
  number would otherwise go stale the moment something is added.
{%- endcomment -%}

<header class="prem-nav">
  <div class="prem-nav__inner">
    <nav class="prem-nav__links" aria-label="Shop">
      <a href="{{ ring_url | default: '/pages/build-your-set' }}">{{ ring_label | default: 'Ring' | escape }}</a>
      <a href="{{ cards_url | default: '/pages/build-your-set' }}">{{ cards_label | default: 'Metal Cards' | escape }}</a>
    </nav>

    <a class="prem-nav__mark" href="{{ routes.root_url }}">
      <span class="prem-nav__mark-word">{{ wordmark | default: 'Optiq' | escape }}</span>
      <span class="prem-nav__mark-sub">{{ wordmark_sub | default: 'Signature' | escape }}</span>
    </a>

    <nav class="prem-nav__links prem-nav__links--right" aria-label="Account">
      <a href="{{ routes.search_url }}">Search</a>
      <a href="{{ routes.account_url }}">Account</a>
      <a href="{{ routes.cart_url }}">
        Cart
        <span class="prem-nav__count" data-o-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </nav>
  </div>
</header>
