{%- comment -%}
  Shared nav for the Premium world (/pages/premium-products,
  /pages/build-your-set, /pages/google-review-cards). Extracted from
  premium-hero.liquid so these pages cannot drift apart - one nav, rendered
  identically everywhere.

  Same content, same Balenciaga-style type, and the same permanently fixed
  behaviour as the site's own header (sections/header.liquid) - AI
  Receptionist / Cards and Wristbands / Premium Products on the left, OPTIQ
  centred, Account and Cart on the right, no search. The two are separate
  markup because this page family hides the site's own header entirely
  (body:has(.prem-page) in this stylesheet) rather than repainting it, but
  they are meant to read as the exact same bar.

  The cart count carries data-o-cart-count so the theme's cart controller
  (assets/optiq-cart.js) repaints it after an AJAX add - a server-rendered
  number would otherwise go stale the moment something is added.
{%- endcomment -%}

<header class="prem-nav" data-prem-nav>
  <div class="prem-nav__inner">
    <nav class="prem-nav__links" aria-label="Main navigation">
      <a href="{{ routes.root_url }}pages/ai-receptionist">AI Receptionist</a>
      <a href="{{ routes.root_url }}pages/google-review-cards">Cards and Wristbands</a>
      <a href="{{ routes.root_url }}pages/premium-products">Premium Products</a>
    </nav>

    <a class="prem-nav__mark" href="{{ routes.root_url }}">
      <span class="prem-nav__mark-word">Optiq</span>
    </a>

    <nav class="prem-nav__links prem-nav__links--right" aria-label="Account">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}/pages/my-receptionist{% else %}/pages/sign-in{% endif %}">
          {%- if customer -%}Account{%- else -%}Login{%- endif -%}
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}">
        Cart
        <span class="prem-nav__count" data-o-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </nav>
  </div>
</header>

<script>
(function () {
  /* .prem-nav is `position: fixed` (optiq-premium.css), so .prem-page
     needs matching top padding to clear it - published here as
     --prem-nav-h from the nav's real rendered height, the same pattern
     assets/optiq-motion.js uses for the site's own header. */
  function initPremNavHeight() {
    var nav = document.querySelector('[data-prem-nav]');
    if (!nav) return;

    function setHeight() {
      document.documentElement.style.setProperty('--prem-nav-h', nav.offsetHeight + 'px');
    }
    setHeight();
    if ('ResizeObserver' in window) new ResizeObserver(setHeight).observe(nav);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPremNavHeight);
  } else {
    initPremNavHeight();
  }
  document.addEventListener('shopify:section:load', initPremNavHeight);
})();
</script>
