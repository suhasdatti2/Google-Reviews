{%- comment -%}
  Neutral placeholder shown until the merchant uploads a real product photo.
  Never fabricates a card design — this theme only displays real uploads.
{%- endcomment -%}
<div class="img-placeholder{% if mini %} img-placeholder--mini{% endif %}{% if square %} img-placeholder--square{% endif %}">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2"/>
    <circle cx="9" cy="10.5" r="1.6"/>
    <path d="M21 16l-5.5-5.5a1.5 1.5 0 0 0-2.1 0L5 19"/>
  </svg>
  {%- unless mini -%}<span>{{ label | default: 'Add product photo' }}</span>{%- endunless -%}
</div>
