{%- comment -%}
  Build Your Set gallery for one product slot.

  Every candidate photo is rendered up-front and stacked in one box; the
  section's script only toggles which is `.is-active`, so switching colour
  crossfades instead of fetching and reflowing.

  Photo sources, in order:
    1. `extra1`/`extra2`/`extra3` - up to three named, directly-visible
       image_picker fields in the section's own settings, each pre-wired by
       the section (not typed by the merchant) to a specific option value
       (and, for the Ring, a second Style value). This is the simplest and
       least error-prone way to add a photo per colour/finish: one clearly
       labelled field each, no free-text value to mistype or let go stale.
    2. `main_image` - a single fallback image_picker, shown only when none
       of the three specific photos above are set for the current selection.
    3. "Colour option" blocks for this slot that carry an image — still
       supported for anyone who wants more than three variations; these get
       data-shot-value so choosing that colour brings its own photo forward.
    4. The product's own Shopify images - skipped entirely when
       `include_product_images` is explicitly false. Some callers only want
       the curated swatch photos on screen (a merchant may have uploaded an
       incidental lifestyle photo to the product itself for other uses -
       e.g. a separate lifestyle section elsewhere on the page - that was
       never meant to double as a purchase-gallery shot here); omitting the
       param keeps every existing caller's behaviour exactly as it was.
  With none of the above, a single flat placeholder stands in (prem-media),
  matching the rest of the Premium pages.

  The source list is walked twice — once for the stacked shots, once for the
  thumbnail strip. Liquid cannot write to two output buffers in one pass, and
  duplicating the short loops is clearer here than building an intermediate
  array of image handles.

  The first slot renders visible rather than hidden, so with JavaScript off the
  page still shows a complete, buyable product instead of an empty frame.

  Accepts: product, slot, swatches, label, is_active, main_image,
           extra1_image, extra1_value, extra1_value2,
           extra2_image, extra2_value, extra2_value2,
           extra3_image, extra3_value, extra3_value2,
           include_product_images (default true)
{%- endcomment -%}

{%- liquid
  assign use_product_images = true
  if include_product_images == false
    assign use_product_images = false
  endif

  assign shot_n = 0
  if main_image != blank
    assign shot_n = shot_n | plus: 1
  endif
  if extra1_image != blank
    assign shot_n = shot_n | plus: 1
  endif
  if extra2_image != blank
    assign shot_n = shot_n | plus: 1
  endif
  if extra3_image != blank
    assign shot_n = shot_n | plus: 1
  endif
  for b in swatches
    if b.settings.product == slot and b.settings.image != blank
      assign shot_n = shot_n | plus: 1
    endif
  endfor
  if product != blank and use_product_images
    assign shot_n = shot_n | plus: product.images.size
  endif
-%}

<div class="bset-gallery" data-bset-gallery="{{ slot }}" data-bset-for="{{ slot }}"{% unless is_active %} hidden{% endunless %}>
  <div class="bset-media">
    {%- assign i = 0 -%}

    {%- if extra1_image != blank -%}
      <div class="bset-shot{% if i == 0 %} is-active{% endif %}" data-shot="{{ i }}"{% if extra1_value != blank %} data-shot-value="{{ extra1_value | escape }}"{% endif %}{% if extra1_value2 != blank %} data-shot-value2="{{ extra1_value2 | escape }}"{% endif %}>
        {% render 'prem-media', image: extra1_image, width: 1400, alt: label, label: label, loading: 'eager' %}
      </div>
      {%- assign i = i | plus: 1 -%}
    {%- endif -%}

    {%- if extra2_image != blank -%}
      <div class="bset-shot{% if i == 0 %} is-active{% endif %}" data-shot="{{ i }}"{% if extra2_value != blank %} data-shot-value="{{ extra2_value | escape }}"{% endif %}{% if extra2_value2 != blank %} data-shot-value2="{{ extra2_value2 | escape }}"{% endif %}>
        {% render 'prem-media', image: extra2_image, width: 1400, alt: label, label: label, loading: 'lazy' %}
      </div>
      {%- assign i = i | plus: 1 -%}
    {%- endif -%}

    {%- if extra3_image != blank -%}
      <div class="bset-shot{% if i == 0 %} is-active{% endif %}" data-shot="{{ i }}"{% if extra3_value != blank %} data-shot-value="{{ extra3_value | escape }}"{% endif %}{% if extra3_value2 != blank %} data-shot-value2="{{ extra3_value2 | escape }}"{% endif %}>
        {% render 'prem-media', image: extra3_image, width: 1400, alt: label, label: label, loading: 'lazy' %}
      </div>
      {%- assign i = i | plus: 1 -%}
    {%- endif -%}

    {%- if main_image != blank -%}
      <div class="bset-shot{% if i == 0 %} is-active{% endif %}" data-shot="{{ i }}">
        {% render 'prem-media', image: main_image, width: 1400, alt: label, label: label, loading: 'eager' %}
      </div>
      {%- assign i = i | plus: 1 -%}
    {%- endif -%}

    {%- for b in swatches -%}
      {%- if b.settings.product == slot and b.settings.image != blank -%}
        {%- if i == 0 -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
        {%- assign shot_val = b.settings.value | default: b.settings.value2 -%}
        {%- assign shot_alt = label | append: ' — ' | append: shot_val -%}
        <div class="bset-shot{% if i == 0 %} is-active{% endif %}" data-shot="{{ i }}"{% if b.settings.value != blank %} data-shot-value="{{ b.settings.value | escape }}"{% endif %}{% if b.settings.value2 != blank %} data-shot-value2="{{ b.settings.value2 | escape }}"{% endif %} {{ b.shopify_attributes }}>
          {% render 'prem-media', image: b.settings.image, width: 1400, alt: shot_alt, label: label, loading: load %}
        </div>
        {%- assign i = i | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if product != blank and use_product_images -%}
      {%- for img in product.images -%}
        {%- if i == 0 -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
        <div class="bset-shot{% if i == 0 %} is-active{% endif %}" data-shot="{{ i }}">
          {% render 'prem-media', image: img, width: 1400, alt: label, label: label, loading: load %}
        </div>
        {%- assign i = i | plus: 1 -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if shot_n == 0 -%}
      <div class="bset-shot is-active" data-shot="0">
        {% render 'prem-media', label: label %}
      </div>
    {%- endif -%}

    {%- if shot_n > 1 -%}
      <div class="bset-dots" role="group" aria-label="{{ label | escape }} images">
        {%- for n in (1..shot_n) -%}
          <button type="button"
                  class="bset-dot{% if forloop.first %} is-active{% endif %}"
                  data-shot-go="{{ forloop.index0 }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="Show image {{ forloop.index }} of {{ shot_n }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if shot_n > 1 -%}
    <div class="bset-thumbs" role="group" aria-label="{{ label | escape }} thumbnails">
      {%- assign t = 0 -%}

      {%- if extra1_image != blank -%}
        <button type="button"
                class="bset-thumb{% if t == 0 %} is-active{% endif %}"
                data-shot-go="{{ t }}"
                aria-pressed="{% if t == 0 %}true{% else %}false{% endif %}"
                aria-label="Show {{ extra1_value | default: extra1_value2 | escape }}">
          {{ extra1_image | image_url: width: 220 | image_tag: alt: '', loading: 'lazy' }}
        </button>
        {%- assign t = t | plus: 1 -%}
      {%- endif -%}

      {%- if extra2_image != blank -%}
        <button type="button"
                class="bset-thumb{% if t == 0 %} is-active{% endif %}"
                data-shot-go="{{ t }}"
                aria-pressed="{% if t == 0 %}true{% else %}false{% endif %}"
                aria-label="Show {{ extra2_value | default: extra2_value2 | escape }}">
          {{ extra2_image | image_url: width: 220 | image_tag: alt: '', loading: 'lazy' }}
        </button>
        {%- assign t = t | plus: 1 -%}
      {%- endif -%}

      {%- if extra3_image != blank -%}
        <button type="button"
                class="bset-thumb{% if t == 0 %} is-active{% endif %}"
                data-shot-go="{{ t }}"
                aria-pressed="{% if t == 0 %}true{% else %}false{% endif %}"
                aria-label="Show {{ extra3_value | default: extra3_value2 | escape }}">
          {{ extra3_image | image_url: width: 220 | image_tag: alt: '', loading: 'lazy' }}
        </button>
        {%- assign t = t | plus: 1 -%}
      {%- endif -%}

      {%- if main_image != blank -%}
        <button type="button"
                class="bset-thumb{% if t == 0 %} is-active{% endif %}"
                data-shot-go="{{ t }}"
                aria-pressed="{% if t == 0 %}true{% else %}false{% endif %}"
                aria-label="Show main photo">
          {{ main_image | image_url: width: 220 | image_tag: alt: '', loading: 'lazy' }}
        </button>
        {%- assign t = t | plus: 1 -%}
      {%- endif -%}

      {%- for b in swatches -%}
        {%- if b.settings.product == slot and b.settings.image != blank -%}
          <button type="button"
                  class="bset-thumb{% if t == 0 %} is-active{% endif %}"
                  data-shot-go="{{ t }}"
                  aria-pressed="{% if t == 0 %}true{% else %}false{% endif %}"
                  aria-label="Show {{ b.settings.value | default: b.settings.value2 | escape }}"
                  {{ b.shopify_attributes }}>
            {{ b.settings.image | image_url: width: 220 | image_tag: alt: '', loading: 'lazy' }}
          </button>
          {%- assign t = t | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if product != blank and use_product_images -%}
        {%- for img in product.images -%}
          <button type="button"
                  class="bset-thumb{% if t == 0 %} is-active{% endif %}"
                  data-shot-go="{{ t }}"
                  aria-pressed="{% if t == 0 %}true{% else %}false{% endif %}"
                  aria-label="Show image {{ forloop.index }}">
            {{ img | image_url: width: 220 | image_tag: alt: '', loading: 'lazy' }}
          </button>
          {%- assign t = t | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
