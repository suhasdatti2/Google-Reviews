<div class="card-mockup-wrap">
  <div class="card-mockup" role="img" aria-label="Black NFC card that reads Tap to Review, Leave us a Google Review">
    <span class="card-mockup__pulse" aria-hidden="true"></span>
    <svg class="card-mockup__nfc" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <path d="M8.4 5.2A8.5 8.5 0 0 1 8.4 18.8" opacity="0.35"/>
      <path d="M10.6 7.6a5.4 5.4 0 0 1 0 8.8" opacity="0.6"/>
      <path d="M12.8 10a2.4 2.4 0 0 1 0 4"/>
    </svg>
    <div class="card-mockup__title">Tap to Review</div>
    <div class="card-mockup__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2l-6.1 3.4 1.4-6.8L2.2 9.1l6.9-.8z"/></svg>
      {%- endfor -%}
    </div>
    <div class="card-mockup__sub">Leave us a Google review</div>
  </div>
</div>
