{%- comment -%}
  Flagship product - trust / justification section. Reuses the site's
  existing eyebrow/heading/body typography (.prem-config__*, already loaded
  by optiq-premium.css everywhere else in the Premium area) and the same
  small check-mark trust-point pattern used on the AI Receptionist hero
  (.prem-air-trust), renamed here to .flag-trust__list since it sits in a
  centred closing section rather than under a pair of CTAs.
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}
{{ 'prem-flagship.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign points = section.blocks | where: 'type', 'point'
-%}

<section class="flag-trust prem-section" {{ section.shopify_attributes }}>
  <div class="prem-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="prem-config__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="prem-config__heading flag-trust__title">{{ section.settings.heading | default: 'Not Just a Business Card. Your Signature.' }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="prem-config__body">{{ section.settings.body | escape }}</p>
    {%- endif -%}

    {%- if points.size > 0 -%}
      <ul class="flag-trust__list">
        {%- for block in points -%}
          <li {{ block.shopify_attributes }}>
            {% render 'bset-icon', name: 'check-mini' %}
            {{ block.settings.text | escape }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Flagship trust",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why $199.99" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not Just a Business Card. Your Signature." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The Signature Metal Card combines premium metal, precision laser engraving, a custom digital destination, and a finish built to be handled and carried, not tucked away and forgotten."
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Trust point",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Premium metal" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flagship trust",
      "blocks": [
        { "type": "point", "settings": { "text": "Premium metal" } },
        { "type": "point", "settings": { "text": "Precision laser engraving" } },
        { "type": "point", "settings": { "text": "Custom digital destination" } },
        { "type": "point", "settings": { "text": "Built to be carried and used" } }
      ]
    }
  ]
}
{% endschema %}
