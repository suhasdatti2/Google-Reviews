<section class="section">
  <div class="page-width">
    <span class="kicker">{{ section.settings.kicker }}</span>
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    <p class="section-sub">{{ section.settings.subheading }}</p>

    <div class="audience">
      {%- for block in section.blocks -%}
        <div class="audience__item" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Who it's for",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Who it's for" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for businesses that live on reviews" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "If your customers walk out happy, give them the easiest possible way to say so."
    }
  ],
  "blocks": [
    {
      "type": "audience",
      "name": "Audience",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Barbershops" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Hand it over while they check out the fresh cut in the mirror." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Who it's for" }]
}
{% endschema %}
