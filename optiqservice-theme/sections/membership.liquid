<section class="section membership-plan" id="membership">
  <div class="page-width">
    <span class="kicker">{{ section.settings.kicker }}</span>
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    <p class="section-sub">{{ section.settings.subheading }}</p>

    <div class="plan-card">
      <div class="plan-card__head">
        <div>
          <span class="plan-card__name">{{ section.settings.plan_name }}</span>
          <div class="plan-card__price">{{ section.settings.price }}<span class="plan-card__period">{{ section.settings.period }}</span></div>
        </div>
        <a class="btn btn--primary btn--lg" href="{{ section.settings.link | default: '/pages/contact' }}">{{ section.settings.button_label }}</a>
      </div>

      <div class="plan-card__benefits">
        {%- for block in section.blocks -%}
          <div class="plan-benefit" {{ block.shopify_attributes }}>
            <span class="plan-benefit__icon" aria-hidden="true"></span>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="membership-note">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Membership plan",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Optional membership" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What does membership actually get you?" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your card works forever with no monthly fee. This is a separate, optional add-on for businesses that want ongoing help."
    },
    { "type": "text", "id": "plan_name", "label": "Plan name", "default": "Review Growth Plan" },
    { "type": "text", "id": "price", "label": "Price", "default": "$14.99" },
    { "type": "text", "id": "period", "label": "Period suffix", "default": "/mo" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add Review Growth Plan" },
    { "type": "url", "id": "link", "label": "Button link" },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Small print",
      "default": "Don't need this? Every card works standalone with no monthly fee — membership just adds ongoing help on top. Cancel anytime."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Free card & link updates" },
        { "type": "textarea", "id": "text", "label": "Explanation", "default": "If your Google review link ever changes, we reprogram your card for free." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Membership plan" }]
}
{% endschema %}
