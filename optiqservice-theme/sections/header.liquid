{%- comment -%}
  Header - three-column: navigation left, wordmark centred, actions right.
  The one persistent top bar for the whole site (Balenciaga-style: uppercase
  tracked links, plain text actions, no search) - sticky at all times via
  .o-header in optiq-components.css, never transparent, never hidden or
  swapped for a page-specific bar.

  The wordmark is centred on the viewport rather than sitting beside the nav,
  which is what makes the layout read as a storefront rather than an app bar.
  That needs the two flanking columns to be equal-width (1fr auto 1fr in
  assets/optiq-studio.css), so the centre stays optically centred no matter
  how many nav links or actions are present.

  The three links are hardcoded rather than pulled from a Shopify link_list:
  this is meant to always be exactly AI Receptionist / Cards and Wristbands /
  Premium Products - the site's three real sections - not whatever a merchant
  last saved into the "main-menu" navigation in Admin.

  Cart and menu both drive the theme's existing drawer controller
  (assets/optiq-ui.js): a [data-o-drawer-open="x"] button opens the matching
  [data-o-drawer="x"] panel, with focus trapping, scroll lock and Escape
  already handled. The count badge is [data-o-cart-count], which
  assets/optiq-cart.js repaints after every add.
{%- endcomment -%}

{%- comment -%}
  Loaded here rather than from each studio section because the header is the
  first element in the body: a stylesheet link blocks rendering of everything
  that follows it, so the header itself paints already themed instead of
  flashing unstyled and correcting once a section further down the page
  pulls the sheet in. Same pattern the Signature sections already use for
  their own stylesheet.
{%- endcomment -%}
{{ 'optiq-studio.css' | asset_url | stylesheet_tag }}

<header class="o-header" data-o-header {{ section.shopify_attributes }}>
  <div class="o-wrap stu-hdr">

    {%- comment -%} Left: navigation (desktop) / menu button (mobile) {%- endcomment -%}
    <nav class="stu-nav" aria-label="Main navigation">
      <a href="{{ routes.root_url }}pages/ai-receptionist">AI Receptionist</a>
      <a href="{{ routes.root_url }}pages/google-review-cards">Cards and Wristbands</a>
      <a href="{{ routes.root_url }}pages/premium-products">Premium Products</a>
    </nav>

    <button
      type="button"
      class="stu-hdr__act stu-burger"
      data-o-drawer-open="menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18"/>
      </svg>
    </button>

    {%- comment -%} Centre: wordmark {%- endcomment -%}
    <a class="stu-logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_w = section.settings.logo_height | times: section.settings.logo.aspect_ratio | round -%}
        <img
          src="{{ section.settings.logo | image_url: height: 120 }}"
          alt="{{ shop.name | escape }}"
          width="{{ logo_w }}"
          height="{{ section.settings.logo_height }}"
          style="height:{{ section.settings.logo_height }}px"
        >
      {%- else -%}
        {{ section.settings.wordmark | default: 'OPTIQ' | escape }}
      {%- endif -%}
    </a>

    {%- comment -%}
      Right: account, cart - text links matching the nav, not icons. No
      search: this bar only ever shows these five destinations.
    {%- endcomment -%}
    <nav class="stu-nav stu-nav--right" aria-label="Account">
      {%- comment -%}
        Only rendered when customer accounts are actually switched on - the
        underlying login flow 404s otherwise, and a dead control in a
        persistent header is worse than one fewer control. Signed in goes to
        the gated dashboard, not Shopify's generic /account.
      {%- endcomment -%}
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}/pages/my-receptionist{% else %}/pages/sign-in{% endif %}">
          {%- if customer -%}Account{%- else -%}Login{%- endif -%}
        </a>
      {%- endif -%}

      <button type="button" class="stu-navcart" data-o-drawer-open="cart" aria-expanded="false">
        Cart
        <span class="stu-hdr__count" data-o-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{- cart.item_count -}}</span>
      </button>
    </nav>
  </div>
</header>

{%- comment -%}
  Mobile navigation drawer. Rendered once here rather than in the layout so
  it always carries exactly the links the header above is configured with.
{%- endcomment -%}
<div class="stu-menu" data-o-drawer="menu" aria-hidden="true" role="dialog" aria-label="Menu" tabindex="-1" data-o-drawer-focus>
  <div class="stu-menu__head">
    <span class="stu-eyebrow">Menu</span>
    <button type="button" class="stu-menu__x" data-o-drawer-close aria-label="Close menu">&times;</button>
  </div>
  <nav class="stu-menu__links">
    <a href="{{ routes.root_url }}pages/ai-receptionist" data-o-drawer-close>AI Receptionist</a>
    <a href="{{ routes.root_url }}pages/google-review-cards" data-o-drawer-close>Cards and Wristbands</a>
    <a href="{{ routes.root_url }}pages/premium-products" data-o-drawer-close>Premium Products</a>
  </nav>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "OPTIQ", "info": "Used when no logo image is set." },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the wordmark." },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 18,
      "max": 56,
      "step": 2,
      "default": 30,
      "unit": "px"
    }
  ]
}
{% endschema %}
