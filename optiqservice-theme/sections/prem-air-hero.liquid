{%- comment -%}
  AI Receptionist - premium wireframe hero + "why businesses lose customers"
  loss chain. Replaces air-hero.liquid's visual system (the site's shared
  .o-wrap/.o-btn/.air components with a purple accent) with the same prem-
  design language as Build Your Set / Premium Products / the Cards pages -
  light background, serif display type, monochrome.

  Not a full-page takeover: no .prem-page, no prem-nav. This page keeps the
  site's own header (the AI Receptionist product is a different business
  line from the Ring/Metal Card sub-brand prem-nav was built for, and reusing
  that nav here would show unrelated links). The header/footer are left in
  their normal appearance, same choice already made for the individual
  product pages (prem-product.liquid).

  Real Liquid logic carried over unchanged from air-hero.liquid: the
  "Get Started" CTA resolves the actual one-time-setup variant and links
  straight to a cart permalink for it, rather than a hardcoded URL.
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}
{{ 'optiq-buildset.css' | asset_url | stylesheet_tag }}
{{ 'prem-air.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign air_product = section.settings.product
  if air_product == blank
    assign air_product = product
  endif
  if air_product == blank
    assign air_product = all_products['ai-receptionist']
  endif

  assign setup_variant = blank
  for v in air_product.variants
    assign opt = v.title | downcase
    if opt contains 'setup'
      assign setup_variant = v
    endif
  endfor

  assign primary_href = section.settings.cta_link | default: '#prem-air-pricing'
  if setup_variant != blank and section.settings.cta_link == blank
    capture primary_href
      echo routes.cart_url
      echo '/'
      echo setup_variant.id
      echo ':1'
    endcapture
  endif

  assign proof = section.blocks | where: 'type', 'proof'
  assign losses = section.blocks | where: 'type', 'loss'
-%}

<section class="prem-section prem-air-hero" {{ section.shopify_attributes }}>
  <div class="prem-wrap prem-air-hero__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="prem-intro__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="prem-intro__heading">{{ section.settings.heading | default: 'Never Miss Another Call.' }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="prem-intro__body">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="prem-air-hero__ctas">
      {%- if section.settings.cta_label != blank -%}
        <a class="prem-link" href="{{ primary_href }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a class="prem-link" href="{{ section.settings.cta2_link | default: '#prem-air-pricing' }}">{{ section.settings.cta2_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if proof.size > 0 -%}
      <ul class="prem-air-trust">
        {%- for block in proof -%}
          <li {{ block.shopify_attributes }}>
            {% render 'bset-icon', name: 'check-mini' %}
            {{ block.settings.text | escape }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{%- if losses.size > 0 -%}
  <section class="prem-section prem-air-section" id="prem-air-cost">
    <div class="prem-wrap">
      <div class="prem-air-head">
        {%- if section.settings.loss_eyebrow != blank -%}
          <p class="prem-config__eyebrow">{{ section.settings.loss_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="prem-config__heading">{{ section.settings.loss_heading | default: 'Why businesses lose customers' }}</h2>
        {%- if section.settings.loss_sub != blank -%}
          <p class="prem-config__body">{{ section.settings.loss_sub | escape }}</p>
        {%- endif -%}
      </div>

      <div class="prem-air-loss__grid">
        {%- for block in losses -%}
          <article class="prem-air-loss__step" {{ block.shopify_attributes }}>
            <span class="prem-air-loss__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="prem-air-loss__title">{{ block.settings.title | escape }}</h3>
            <p class="prem-air-loss__text">{{ block.settings.text | escape }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "AI Receptionist hero",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "AI Receptionist product",
      "info": "Leave empty on the product template - it uses the current product automatically."
    },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Optiq AI Receptionist" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Never Miss Another Call." },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheadline",
      "default": "An AI receptionist that answers calls 24/7, books appointments, answers customer questions, qualifies leads, and represents your business like your best employee."
    },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Get Started" },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link",
      "info": "Leave empty to send straight to checkout for the one-time setup."
    },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "View Pricing" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link", "info": "Defaults to the pricing section." },
    { "type": "header", "content": "Why businesses lose customers" },
    { "type": "text", "id": "loss_eyebrow", "label": "Eyebrow", "default": "The cost of a missed call" },
    { "type": "text", "id": "loss_heading", "label": "Heading", "default": "Why businesses lose customers" },
    {
      "type": "textarea",
      "id": "loss_sub",
      "label": "Subheading",
      "default": "It rarely starts as a lost customer. It starts as a phone ringing while you are with someone else."
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Trust point",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Answers in under a second" }
      ]
    },
    {
      "type": "loss",
      "name": "Loss step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Missed Calls" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "The line rings out while you are mid-job, mid-appointment, or closed for the night."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "AI Receptionist hero",
      "blocks": [
        { "type": "proof", "settings": { "text": "Answers in under a second" } },
        { "type": "proof", "settings": { "text": "Books straight into your calendar" } },
        { "type": "proof", "settings": { "text": "Live in about a week" } },
        {
          "type": "loss",
          "settings": {
            "title": "Missed Calls",
            "text": "The line rings out while you are mid-job, mid-appointment, or closed for the night."
          }
        },
        {
          "type": "loss",
          "settings": {
            "title": "Lost Leads",
            "text": "Most callers will not leave a voicemail and will not try a second time."
          }
        },
        {
          "type": "loss",
          "settings": {
            "title": "Lost Revenue",
            "text": "Every unanswered call is a booking that was already yours to win."
          }
        },
        {
          "type": "loss",
          "settings": {
            "title": "Competitors Win",
            "text": "They call the next name on the list, and someone else picks up first."
          }
        }
      ]
    }
  ]
}
{% endschema %}
