{%- comment -%}
  Premium Products - nav + hero. First section on /pages/premium-products.
  Carries the .prem-page marker (see assets/optiq-premium.css) so the
  theme's own header/footer/dock hide themselves - this section shows its
  own nav instead, matching the reference wireframe: left utility links,
  centred OPTIQ / SIGNATURE wordmark, right utility links.

  The nav markup itself lives in snippets/prem-nav.liquid so this page and
  /pages/build-your-set share one header rather than two that drift.

  Both products are now real: "Metal Cards" is Optiq Signature and "Ring" is
  Optiq Signature Ring, so the Ring link defaults to the Build Your Set
  purchase page rather than the dead "#" it used before that product existed.
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}

<div class="prem-page">
  {% render 'prem-nav',
     wordmark: section.settings.wordmark,
     wordmark_sub: section.settings.wordmark_sub,
     ring_label: section.settings.ring_label,
     ring_url: section.settings.ring_url,
     cards_label: section.settings.cards_label,
     cards_url: section.settings.cards_url,
     about_label: section.settings.about_label,
     about_url: section.settings.about_url,
     collections_label: section.settings.collections_label,
     collections_url: section.settings.collections_url %}

  <section class="prem-section" id="prem-hero" {{ section.shopify_attributes }}>
    <div class="prem-hero__frame">
      {% render 'prem-media', image: section.settings.hero_image, label: 'Hero image / video' %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Premium hero",
  "settings": [
    { "type": "header", "content": "Wordmark" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Optiq" },
    { "type": "text", "id": "wordmark_sub", "label": "Wordmark subtitle", "default": "Signature" },

    { "type": "header", "content": "Nav links" },
    { "type": "text", "id": "ring_label", "label": "Ring label", "default": "Ring" },
    { "type": "url", "id": "ring_url", "label": "Ring link", "info": "Defaults to /pages/build-your-set, the Ring purchase page." },
    { "type": "text", "id": "cards_label", "label": "Metal Cards label", "default": "Metal Cards" },
    { "type": "url", "id": "cards_url", "label": "Metal Cards link", "info": "Defaults to /pages/signature, the existing Optiq Signature metal card page." },
    { "type": "text", "id": "about_label", "label": "About label", "default": "About" },
    { "type": "url", "id": "about_url", "label": "About link", "info": "Defaults to /pages/about-us" },
    { "type": "text", "id": "collections_label", "label": "Collections label", "default": "Collections" },
    { "type": "url", "id": "collections_url", "label": "Collections link", "info": "Defaults to /collections" },

    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo" }
  ],
  "presets": [{ "name": "Premium hero" }]
}
{% endschema %}
