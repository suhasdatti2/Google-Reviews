{%- comment -%}
  Premium Products - nav + hero. First section on /pages/premium-products.
  Carries the .prem-page marker (see assets/optiq-premium.css) so the
  theme's own header/footer/dock hide themselves - this section shows its
  own nav instead, matching the reference wireframe.

  The nav markup itself lives in snippets/prem-nav.liquid, shared with every
  other .prem-page (Build Your Set, Cards & Wristbands) so they cannot drift
  apart into different bars.

  Wordmark placement: a large decorative "Optiq / Signature" wordmark sits
  centred over the hero photo, purely static - it scrolls away with the
  photo like any other in-flow content. There used to be a second copy of
  it that crossfaded with the nav's own wordmark on scroll, reading as the
  mark "flying" up into the header; that was removed so the top bar (in
  prem-nav.liquid) simply stays exactly as it is, at all times, instead of
  reacting to scroll position.
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}

<div class="prem-page">
  {% render 'prem-nav' %}

  <section class="prem-section" id="prem-hero" {{ section.shopify_attributes }}>
    <div class="prem-hero__frame">
      {% render 'prem-media', image: section.settings.hero_image, label: 'Hero image / video' %}
      <div class="prem-hero__mark" aria-hidden="true">
        <span class="prem-hero__mark-word">{{ section.settings.wordmark | default: 'Optiq' | escape }}</span>
        <span class="prem-hero__mark-sub">{{ section.settings.wordmark_sub | default: 'Signature' | escape }}</span>
      </div>
    </div>
  </section>
</div>

<style>
  .prem-hero__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(60% 55% at 50% 50%, rgba(0, 0, 0, 0.34), rgba(0, 0, 0, 0) 72%);
    pointer-events: none;
  }
  .prem-hero__mark {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    transition: opacity 520ms var(--prem-ease), transform 620ms var(--prem-ease);
  }
  .prem-hero__mark-word {
    font-family: var(--prem-serif);
    font-weight: 500;
    font-size: clamp(2.75rem, 2vw + 2.2rem, 6rem);
    letter-spacing: 0.01em;
    line-height: 1;
    color: #fff;
    text-shadow: 0 8px 40px rgba(0, 0, 0, 0.45);
  }
  .prem-hero__mark-sub {
    margin-top: 10px;
    font-family: var(--prem-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }
</style>

{% schema %}
{
  "name": "Premium hero",
  "settings": [
    { "type": "header", "content": "Wordmark" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Optiq" },
    { "type": "text", "id": "wordmark_sub", "label": "Wordmark subtitle", "default": "Signature" },

    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo" }
  ],
  "presets": [{ "name": "Premium hero" }]
}
{% endschema %}
