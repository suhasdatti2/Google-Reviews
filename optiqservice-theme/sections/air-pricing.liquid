    { "type": "textarea", "id": "standard_features", "label": "Includes (one per line)", "default": "Full AI setup & configuration\nCustom voice & greeting\nBusiness knowledge upload\nAppointment booking integration\nUnlimited calls answered\nContinuous updates & improvements\nCall analytics dashboard" },
    { "type": "text", "id": "standard_cta", "label": "Button", "default": "Get Started" },
    { "type": "header", "content": "Premium card" },
    { "type": "text", "id": "premium_tag", "label": "Badge", "default": "Full service" },
    { "type": "text", "id": "premium_name", "label": "Name", "default": "AI Receptionist Premium" },
    { "type": "text", "id": "premium_note", "label": "Note", "default": "For businesses that want the whole front desk handled, in every language." },
    { "type": "text", "id": "premium_down_label", "label": "Label under the down-payment figure", "default": "down today" },
    { "type": "text", "id": "premium_then_prefix", "label": "Billing line prefix", "default": "then" },
    { "type": "text", "id": "premium_monthly_suffix", "label": "Billing line suffix after the monthly price", "default": "/month" },
    { "type": "text", "id": "premium_billing_note", "label": "Billing line note", "default": "billed monthly, cancel anytime" },
    { "type": "textarea", "id": "premium_features", "label": "Includes (one per line)", "default": "Everything in AI Receptionist, plus:\nMulti-language call handling\nCRM & calendar integrations\nSMS + email follow-up automation\nCustom voice cloning\nCall recording & QA review\nDedicated onboarding specialist\nSame-day priority support\nMonthly strategy review" },
