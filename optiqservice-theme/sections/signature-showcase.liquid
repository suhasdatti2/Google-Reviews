{%- comment -%}
  Optiq Signature - marble showroom. A soft, warm-marble backdrop (CSS
  gradients, not a texture photo - see .sig-section--marble) with a
  three-image detail grid for close-up showroom photography once it exists.
{%- endcomment -%}

<section class="sig-section sig-section--marble" {{ section.shopify_attributes }}>
  <div class="sig-wrap">
    <div class="sig-head sig-head--center">
      <span class="sig-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | default: 'The showroom' }}</span>
      <h2 class="sig-h2" data-o-reveal="fade">{{ section.settings.heading | default: 'Held the way it deserves to be.' }}</h2>
      <p class="sig-lede" data-o-reveal="fade">{{ section.settings.subheading | default: "Every angle, every edge - considered the way a watch is, not a card." }}</p>
    </div>

    <div class="sig-showroom" data-o-reveal-group>
      <div class="sig-showroom__item" data-o-reveal="fade">
        {% render 'sig-media', image: section.settings.image_1, label: 'Add showroom photo' %}
      </div>
      <div class="sig-showroom__item" data-o-reveal="fade">
        {% render 'sig-media', image: section.settings.image_2, label: 'Add detail photo' %}
      </div>
      <div class="sig-showroom__item" data-o-reveal="fade">
        {% render 'sig-media', image: section.settings.image_3, label: 'Add detail photo' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Signature showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The showroom" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Held the way it deserves to be." },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every angle, every edge - considered the way a watch is, not a card."
    },
    { "type": "image_picker", "id": "image_1", "label": "Tall showroom photo" },
    { "type": "image_picker", "id": "image_2", "label": "Detail photo" },
    { "type": "image_picker", "id": "image_3", "label": "Detail photo" }
  ],
  "presets": [{ "name": "Signature showcase" }]
}
{% endschema %}
