{%- comment -%}
  Optiq Signature - engineering. A minimal three-plate construction diagram
  (front metal / NFC layer / back metal) rather than a photo - the brief
  asks for this to read like an aerospace/watch spec sheet, not a lifestyle
  shot, so it is built as clean typography and hairlines.
{%- endcomment -%}

<section class="sig-section sig-section--tight sig-section--paper sig-section--ruled" {{ section.shopify_attributes }}>
  <div class="sig-wrap">
    <div class="sig-head sig-head--center">
      <span class="sig-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | default: 'Construction' }}</span>
      <h2 class="sig-h2" data-o-reveal="fade">{{ section.settings.heading | default: 'Precision in every layer.' }}</h2>
    </div>

    <div class="sig-diagram" data-o-reveal-group>
      <div class="sig-diagram__plate" data-o-reveal="fade">
        <strong>{{ section.settings.layer_1_title | default: 'Front metal plate' }}</strong>
        <span>{{ section.settings.layer_1_text | default: 'Machined and finished by hand' }}</span>
      </div>
      <div class="sig-diagram__link" aria-hidden="true"></div>
      <div class="sig-diagram__plate sig-diagram__plate--core" data-o-reveal="fade">
        <strong>{{ section.settings.layer_2_title | default: 'Tap technology layer' }}</strong>
        <span>{{ section.settings.layer_2_text | default: 'Programmed with your review link' }}</span>
      </div>
      <div class="sig-diagram__link" aria-hidden="true"></div>
      <div class="sig-diagram__plate" data-o-reveal="fade">
        <strong>{{ section.settings.layer_3_title | default: 'Back metal plate' }}</strong>
        <span>{{ section.settings.layer_3_text | default: 'Sealed for a lifetime of use' }}</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Signature engineering",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Construction" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Precision in every layer." },
    { "type": "header", "content": "Layer 1 - front" },
    { "type": "text", "id": "layer_1_title", "label": "Title", "default": "Front metal plate" },
    { "type": "text", "id": "layer_1_text", "label": "Text", "default": "Machined and finished by hand" },
    { "type": "header", "content": "Layer 2 - core" },
    { "type": "text", "id": "layer_2_title", "label": "Title", "default": "Tap technology layer" },
    { "type": "text", "id": "layer_2_text", "label": "Text", "default": "Programmed with your review link" },
    { "type": "header", "content": "Layer 3 - back" },
    { "type": "text", "id": "layer_3_title", "label": "Title", "default": "Back metal plate" },
    { "type": "text", "id": "layer_3_text", "label": "Text", "default": "Sealed for a lifetime of use" }
  ],
  "presets": [{ "name": "Signature engineering" }]
}
{% endschema %}
