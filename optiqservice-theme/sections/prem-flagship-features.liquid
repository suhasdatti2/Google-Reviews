{%- comment -%}
  Flagship product - premium feature grid. Reuses the AI Receptionist page's
  existing 3-column feature card pattern (.prem-air-feat__grid, defined in
  assets/prem-air.css) rather than building a new grid system - same markup,
  same icon snippet (snippets/bset-icon), just five blocks instead of three.
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}
{{ 'prem-air.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign features = section.blocks | where: 'type', 'feature'
-%}

{%- if features.size > 0 -%}
  <section class="prem-section prem-air-section" {{ section.shopify_attributes }}>
    <div class="prem-wrap">
      <div class="prem-air-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="prem-config__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="prem-config__heading">{{ section.settings.heading | default: 'Why this is different' }}</h2>
        {%- if section.settings.sub != blank -%}
          <p class="prem-config__body">{{ section.settings.sub | escape }}</p>
        {%- endif -%}
      </div>

      <div class="prem-air-feat__grid">
        {%- for block in features -%}
          <article class="prem-air-feat__card" {{ block.shopify_attributes }}>
            <span class="prem-air-feat__icon">{% render 'bset-icon', name: block.settings.icon %}</span>
            <h3 class="prem-air-feat__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="prem-air-feat__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Flagship features",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Precision, Not Printing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not just a business card" },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Subheading",
      "default": "Every detail is engraved, not printed - built to be handled, carried, and remembered."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "card", "label": "Card" },
            { "value": "box", "label": "Box" },
            { "value": "spark", "label": "Spark" },
            { "value": "lock", "label": "Lock" },
            { "value": "transfer", "label": "Transfer" }
          ],
          "default": "spark"
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Flagship features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "spark",
            "title": "Precision Laser Engraving",
            "text": "Your design is permanently engraved into the metal using precision laser technology, not printed on top of it."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "diamond",
            "title": "Premium Metal Construction",
            "text": "Choose from four premium metal finishes designed to look and feel substantially more luxurious than an ordinary business card."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "transfer",
            "title": "Your Digital Identity",
            "text": "Connect your card to your website, contact information, a social profile, a digital business card, your review page, or another destination of your choice."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "card",
            "title": "Built to Impress",
            "text": "A substantial, tactile metal card designed for high-value introductions, executive networking, and premium brands."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "box",
            "title": "Made for Your Brand",
            "text": "Configured to your metal finish and your digital destination - built for you, not mass-produced."
          }
        }
      ]
    }
  ]
}
{% endschema %}
