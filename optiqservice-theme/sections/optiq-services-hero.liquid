{{ 'optiq-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'optiq-hero.js' | asset_url }}" defer></script>

{%- liquid
  assign row1_url = section.settings.row1_url | default: '/pages/ai-receptionist'
  assign row2_url = section.settings.row2_url | default: '/pages/google-review-cards'
  assign row3_url = section.settings.row3_url | default: '/pages/other-services'
  assign row4_url = section.settings.row4_url | default: '/pages/premium-products'
  assign splash = ''
  if section.settings.splash
    assign splash = ' opsh--splash'
  endif
-%}

{%- if section.settings.splash -%}
  {%- comment -%}
    Splash mode owns the whole screen: no header, no announcement bar, no
    footer, no page scroll. Emitted from Liquid rather than from a
    `body:has()` rule in the stylesheet so it does not depend on :has()
    support - a browser that missed the selector would otherwise show the
    header underneath a section that is already pinned to the top.
    The bottom dock is deliberately left visible: with the header gone it is
    the only way to reach search, account and cart from this screen.
  {%- endcomment -%}
  <style>
    #shopify-section-header,
    #shopify-section-announcement-bar,
    #shopify-section-footer { display: none !important; }
    body { overflow: hidden; padding-bottom: 0 !important; }
  </style>
{%- endif -%}

{%- comment -%}
  Full-bleed photo hero: the product photography fills the entire screen and
  auto-cycles (assets/optiq-hero.js), with the row links and wordmark
  overlaid directly on top of the image instead of sitting in a separate
  white column. Every background photo is one of the theme's real product
  photos - nothing invented.

  Each row link is only rendered when its label is set, so removing a row
  (e.g. Other Services, whose page was deleted) is just clearing its label
  in the section settings - no dead link to an unused page.
{%- endcomment -%}

<section class="opsh{{ splash }}" data-optiq-services-hero aria-label="{{ section.settings.aria_label | escape }}">
  <div class="opsh__bg" data-opsh-bg aria-hidden="true">
    <div class="opsh__bg-slide is-active" style="--opsh-bg-d: url('https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260807_032922_b8902637-8c24-4a47-8c13-39b2ad594145.png?v=1786077834'); --opsh-bg-m: url('https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260811_233031_fdf9a3f9-7d1b-4ef6-9013-21acb3528fa1.png?v=1786491919');"></div>
    <div class="opsh__bg-slide" style="--opsh-bg-d: url('https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260810_051812_b4b31f05-54af-40a6-b2b9-980d76d76771.png?v=1786339506'); --opsh-bg-m: url('https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260811_233259_191f850c-fa56-4ae1-988e-3c4a9f9981bd.png?v=1786491919');"></div>
    <div class="opsh__bg-slide" style="--opsh-bg-d: url('https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260810_052110_1adb636b-a4cb-4366-a593-fa37701c602b.png?v=1786342744'); --opsh-bg-m: url('https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260811_234017_19e3dbd6-e08e-443c-a95b-d5bfac67c023.png?v=1786491919');"></div>
    <div class="opsh__bg-slide" style="--opsh-bg-d: url('https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260809_191808_d7032847-de25-498e-a132-a2ed7ceedbde.png?v=1786342744'); --opsh-bg-m: url('https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260811_234319_60fe0384-d2b8-46d0-9f13-fbd982cf4273.png?v=1786491919');"></div>
  </div>
  <div class="opsh__scrim" aria-hidden="true"></div>

  <div class="opsh__bgnav">
    <button type="button" class="opsh__bgarrow opsh__bgarrow--prev" data-opsh-bg-prev aria-label="Previous photo">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
    </button>
    <button type="button" class="opsh__bgarrow opsh__bgarrow--next" data-opsh-bg-next aria-label="Next photo">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>

  <div class="opsh__overlay">
    <nav class="opsh__list" aria-label="{{ section.settings.aria_label | escape }}">
      {%- if section.settings.row1_label != blank -%}
        <a class="opsh__row" href="{{ row1_url }}" style="--opsh-delay: 140ms;">
          <span class="opsh__row-label">{{ section.settings.row1_label | escape }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.row2_label != blank -%}
        <a class="opsh__row" href="{{ row2_url }}" style="--opsh-delay: 220ms;">
          <span class="opsh__row-label">{{ section.settings.row2_label | escape }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.row3_label != blank -%}
        <a class="opsh__row" href="{{ row3_url }}" style="--opsh-delay: 300ms;">
          <span class="opsh__row-label">{{ section.settings.row3_label | escape }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.row4_label != blank -%}
        <a class="opsh__row" href="{{ row4_url }}" style="--opsh-delay: 380ms;">
          <span class="opsh__row-label">{{ section.settings.row4_label | escape }}</span>
        </a>
      {%- endif -%}
    </nav>

    <div class="opsh__logo" aria-hidden="true" style="--opsh-delay: 420ms;">{{ section.settings.wordmark | escape }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Services splash",
  "tag": "section",
  "class": "optiq-services-hero-section",
  "settings": [
    { "type": "checkbox", "id": "splash", "label": "Fill the screen, hide header and footer", "default": true, "info": "Turn off to use this as a normal section with the header, footer and the rest of the page." },
    { "type": "text", "id": "aria_label", "label": "Section label (screen readers)", "default": "Choose a service" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Optiq" },
    { "type": "header", "content": "Row 1" },
    { "type": "text", "id": "row1_label", "label": "Label", "default": "AI Receptionist", "info": "Leave blank to hide this row entirely." },
    { "type": "url", "id": "row1_url", "label": "Link", "info": "Defaults to /pages/ai-receptionist" },
    { "type": "header", "content": "Row 2" },
    { "type": "text", "id": "row2_label", "label": "Label", "default": "Cards", "info": "Leave blank to hide this row entirely." },
    { "type": "url", "id": "row2_url", "label": "Link", "info": "Defaults to /pages/google-review-cards" },
    { "type": "header", "content": "Row 3" },
    { "type": "text", "id": "row3_label", "label": "Label", "info": "Leave blank to hide this row entirely." },
    { "type": "url", "id": "row3_url", "label": "Link", "info": "Defaults to /pages/other-services" },
    { "type": "header", "content": "Row 4" },
    { "type": "text", "id": "row4_label", "label": "Label", "default": "Premium Products", "info": "Leave blank to hide this row entirely." },
    { "type": "url", "id": "row4_url", "label": "Link", "info": "Defaults to /pages/premium-products" }
  ],
  "presets": [{ "name": "Services splash" }]
}
{% endschema %}
