{{ 'optiq-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'optiq-hero.js' | asset_url }}" defer></script>

{%- liquid
  assign row1_url = section.settings.row1_url | default: '/pages/ai-receptionist'
  assign row2_url = section.settings.row2_url | default: '/pages/google-review-cards'
  assign row3_url = section.settings.row3_url | default: '/pages/other-services'
  assign splash = ''
  if section.settings.splash
    assign splash = ' opsh--splash'
  endif
-%}

{%- if section.settings.splash -%}
  {%- comment -%}
    Splash mode owns the whole screen: no header, no announcement bar, no
    footer, no page scroll. Emitted from Liquid rather than from a
    `body:has()` rule in the stylesheet so it does not depend on :has()
    support - a browser that missed the selector would otherwise show the
    header underneath a section that is already pinned to the top.
    The bottom dock is deliberately left visible: with the header gone it is
    the only way to reach search, account and cart from this screen.
  {%- endcomment -%}
  <style>
    #shopify-section-header,
    #shopify-section-announcement-bar,
    #shopify-section-footer { display: none !important; }
    body { overflow: hidden; padding-bottom: 0 !important; }
  </style>
{%- endif -%}

{%- comment -%}
  A short, editorial directory rather than photo panels: three rows on the
  left (each a plain <a>, so the whole row is the click target and works
  without JavaScript), a large wordmark on the right. The confirmation
  overlay in optiq-hero.js is a decoration on top of links that already
  navigate correctly on their own.
{%- endcomment -%}

<section class="opsh{{ splash }}" data-optiq-services-hero aria-label="{{ section.settings.aria_label | escape }}">
  <span class="opsh__divider" aria-hidden="true"></span>

  <div class="opsh__grid">
    <nav class="opsh__list" aria-label="{{ section.settings.aria_label | escape }}">
      <a
        class="opsh__row"
        href="{{ row1_url }}"
        data-opsh-choose="row1"
        data-opsh-name="{{ section.settings.row1_label | escape }}"
        style="--opsh-delay: 140ms;"
      >
        <span class="opsh__row-label">{{ section.settings.row1_label | escape }}</span>
        <svg class="opsh__row-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a
        class="opsh__row"
        href="{{ row2_url }}"
        data-opsh-choose="row2"
        data-opsh-name="{{ section.settings.row2_label | escape }}"
        style="--opsh-delay: 260ms;"
      >
        <span class="opsh__row-label">{{ section.settings.row2_label | escape }}</span>
        <svg class="opsh__row-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a
        class="opsh__row"
        href="{{ row3_url }}"
        data-opsh-choose="row3"
        data-opsh-name="{{ section.settings.row3_label | escape }}"
        style="--opsh-delay: 380ms;"
      >
        <span class="opsh__row-label">{{ section.settings.row3_label | escape }}</span>
        <svg class="opsh__row-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </nav>

    <div class="opsh__right">
      <div class="opsh__logo" aria-hidden="true" style="--opsh-delay: 480ms;">{{ section.settings.wordmark | escape }}</div>

      {%- comment -%}
        Scroll-driven product showcase. The splash section is fixed with
        body scroll locked (see the comment above), so there is no real
        page-scroll to drive - instead assets/optiq-hero.js captures wheel/
        touch gestures scoped to this element only and turns them into an
        eased horizontal progress value, giving the same "scroll moves the
        products" feel without unlocking page scroll or touching the
        3-option chooser beside it. Every image and all copy/prices below
        are the theme's real products - nothing invented.
      {%- endcomment -%}
      <div class="opsh__showcase" data-opsh-showcase tabindex="0" role="region" aria-roledescription="carousel" aria-label="Optiq products" style="--opsh-delay: 560ms;">
        <div class="opsh__showcase-viewport">
          <div data-showcase-track>

            <a class="opsh__showcase-item" href="/products/optiq-signature" data-showcase-item>
              <span class="opsh__showcase-media">
                <img src="https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260810_054828_bb9dea7e-dc35-42d4-b52d-8dd5804a3bc7.png?v=1786341778" alt="Optiq Signature, a luxury metal NFC review card" loading="eager">
              </span>
              <span class="opsh__showcase-copy">
                <span class="opsh__showcase-eyebrow">01 &mdash; Metal Card</span>
                <span class="opsh__showcase-name">Optiq Signature</span>
                <span class="opsh__showcase-text">A luxury metal NFC card, engineered from precision metal and finished by hand.</span>
                <span class="opsh__showcase-link">
                  View Signature
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </span>
            </a>

            <a class="opsh__showcase-item" href="/products/google-review-nfc-wristband" data-showcase-item>
              <span class="opsh__showcase-media">
                <img src="https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260810_055543_cc253e52-c4c0-40d3-bc9c-e90cc64dbe0a.png?v=1786341777" alt="Google Review NFC silicone wristband" loading="lazy">
              </span>
              <span class="opsh__showcase-copy">
                <span class="opsh__showcase-eyebrow">02 &mdash; Silicone Band</span>
                <span class="opsh__showcase-name">NFC Wristband</span>
                <span class="opsh__showcase-text">The same one-tap technology as the card, worn instead of displayed &mdash; waterproof, built for all-day wear.</span>
                <span class="opsh__showcase-link">
                  Shop the wristband
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </span>
            </a>

            <a class="opsh__showcase-item" href="/pages/other-services" data-showcase-item>
              <span class="opsh__showcase-media">
                <img src="https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260810_054349_f1e4967f-0360-458d-8449-935ad8a97260.png?v=1786341777" alt="Optiq NFC ring" loading="lazy">
              </span>
              <span class="opsh__showcase-copy">
                <span class="opsh__showcase-eyebrow">03 &mdash; NFC Ring</span>
                <span class="opsh__showcase-name">Optiq Ring</span>
                <span class="opsh__showcase-text">The one-tap technology worn as a ring &mdash; always on hand, nothing to carry or display.</span>
                <span class="opsh__showcase-link">
                  Learn more
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </span>
            </a>

            <a class="opsh__showcase-item" href="/products/google-review-nfc-card" data-showcase-item>
              <span class="opsh__showcase-media">
                <img src="https://cdn.shopify.com/s/files/1/0797/5554/2760/files/hf_20260810_055321_eb9948d1-0552-47fa-981c-e942eea7a880.png?v=1786341777" alt="Main Counter Card, the plastic Google review NFC card" loading="lazy">
              </span>
              <span class="opsh__showcase-copy">
                <span class="opsh__showcase-eyebrow">04 &mdash; Counter Card</span>
                <span class="opsh__showcase-name">Main Counter Card</span>
                <span class="opsh__showcase-text">The premium, credit-card-size NFC card built to live on your counter, front desk or register.</span>
                <span class="opsh__showcase-link">
                  Shop the card
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </span>
            </a>

            <a class="opsh__showcase-item" href="/pages/ai-receptionist" data-showcase-item>
              <span class="opsh__showcase-media" aria-hidden="true">
                <span class="opsh__device">
                  <span class="opsh__device-wave">
                    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                  </span>
                  <span class="opsh__device-stat"><b>482</b> calls answered</span>
                  <span class="opsh__device-stat opsh__device-stat--muted"><b>0.6s</b> avg. response</span>
                </span>
              </span>
              <span class="opsh__showcase-copy">
                <span class="opsh__showcase-eyebrow">05 &mdash; AI Service</span>
                <span class="opsh__showcase-name">AI Receptionist</span>
                <span class="opsh__showcase-text">Answers calls 24/7, books appointments and qualifies leads &mdash; so nothing goes to voicemail.</span>
                <span class="opsh__showcase-link">
                  Meet the AI Receptionist
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </span>
            </a>

          </div>
        </div>

        <div class="opsh__showcase-controls">
          <button type="button" class="opsh__showcase-arrow" data-showcase-prev aria-label="Previous product">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </button>
          <div class="opsh__showcase-dots" data-showcase-dots>
            <button type="button" class="opsh__showcase-dot is-active" data-showcase-dot="0" aria-label="Optiq Signature"></button>
            <button type="button" class="opsh__showcase-dot" data-showcase-dot="1" aria-label="NFC Wristband"></button>
            <button type="button" class="opsh__showcase-dot" data-showcase-dot="2" aria-label="Optiq Ring"></button>
            <button type="button" class="opsh__showcase-dot" data-showcase-dot="3" aria-label="Main Counter Card"></button>
            <button type="button" class="opsh__showcase-dot" data-showcase-dot="4" aria-label="AI Receptionist"></button>
          </div>
          <button type="button" class="opsh__showcase-arrow" data-showcase-next aria-label="Next product">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Which row was chosen, held briefly before the page changes. {%- endcomment -%}
  <div class="opsh__confirm" role="status" aria-live="polite">
    <div class="opsh__confirmbox">
      <span class="opsh__confirmtick">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </span>
      <span class="opsh__confirmtext">
        <em data-opsh-confirm-title></em>
        {{ section.settings.confirm_note | escape }}
      </span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services splash",
  "tag": "section",
  "class": "optiq-services-hero-section",
  "settings": [
    { "type": "checkbox", "id": "splash", "label": "Fill the screen, hide header and footer", "default": true, "info": "Turn off to use this as a normal section with the header, footer and the rest of the page." },
    { "type": "text", "id": "aria_label", "label": "Section label (screen readers)", "default": "Choose a service" },
    { "type": "text", "id": "confirm_note", "label": "Confirmation subtext", "default": "Taking you there" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Optiq" },
    { "type": "header", "content": "Row 1" },
    { "type": "text", "id": "row1_label", "label": "Label", "default": "AI Receptionist" },
    { "type": "url", "id": "row1_url", "label": "Link", "info": "Defaults to /pages/ai-receptionist" },
    { "type": "header", "content": "Row 2" },
    { "type": "text", "id": "row2_label", "label": "Label", "default": "Cards" },
    { "type": "url", "id": "row2_url", "label": "Link", "info": "Defaults to /pages/google-review-cards" },
    { "type": "header", "content": "Row 3" },
    { "type": "text", "id": "row3_label", "label": "Label", "default": "Other Services" },
    { "type": "url", "id": "row3_url", "label": "Link", "info": "Defaults to /pages/other-services" }
  ],
  "presets": [{ "name": "Services splash" }]
}
{% endschema %}
