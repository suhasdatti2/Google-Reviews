{%- comment -%}
  Premium Products - shop grid. Balenciaga-style: one big image per card,
  name, price, and a single "Shop Now" link - no swatches or configurator
  live here, those live on the destination page (Build Your Set / the
  Optiq Signature solo page). Sits directly under the hero so shoppers can
  go straight to buying without scrolling through anything else first.

  Every card is looked up from Shopify by product handle, so title and
  price always come from the real product - never hardcoded here.
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cards = section.blocks | where: 'type', 'card'
-%}

{%- if cards.size > 0 -%}
  <section class="prem-section prem-shopgrid" {{ section.shopify_attributes }}>
    <div class="prem-wrap">
      {%- if section.settings.eyebrow != blank -%}
        <p class="prem-config__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="prem-config__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="prem-shopgrid__grid">
        {%- for block in cards -%}
          {%- liquid
            assign p = all_products[block.settings.product_handle]
            assign card_title = block.settings.title | default: p.title
            assign card_url = block.settings.cta_url | default: p.url | default: '#'
          -%}
          <a class="prem-shopgrid__card" href="{{ card_url }}" {{ block.shopify_attributes }}>
            <div class="prem-shopgrid__media">
              {% render 'prem-media', image: block.settings.image, label: card_title %}
            </div>
            <div class="prem-shopgrid__body">
              <h3 class="prem-shopgrid__name">{{ card_title | escape }}</h3>
              {%- if p != blank -%}
                <p class="prem-shopgrid__price">
                  {%- if p.price_varies -%}From {{ p.price_min | money }}{%- else -%}{{ p.price_min | money }}{%- endif -%}
                </p>
              {%- endif -%}
              <span class="prem-link">{{ block.settings.cta_label | default: 'Shop Now' | escape }}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if section.settings.bundle_label != blank -%}
        <p class="prem-shopgrid__bundle">
          <a class="prem-link" href="{{ section.settings.bundle_url | default: '/pages/build-your-set' }}">{{ section.settings.bundle_label | escape }}</a>
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Shop grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank to hide." },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to hide." },
    { "type": "text", "id": "bundle_label", "label": "Bundle link text", "default": "Buy as a Bundle & Save", "info": "Leave blank to hide. A secondary link below the grid to the 3-way Build Your Set / Bundle page." },
    { "type": "url", "id": "bundle_url", "label": "Bundle link URL", "info": "Defaults to /pages/build-your-set." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        { "type": "text", "id": "product_handle", "label": "Product handle", "info": "Looked up from Shopify by handle - title and price come from the real product." },
        { "type": "text", "id": "title", "label": "Title override", "info": "Leave blank to use the product's own title." },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Now" },
        { "type": "url", "id": "cta_url", "label": "Button link", "info": "Leave blank to use the product's own page." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop grid",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
