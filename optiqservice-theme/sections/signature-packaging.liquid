{%- comment -%}
  Optiq Signature - packaging. The one deliberate dark beat in an otherwise
  white page, for contrast and pacing (Apple's own product pages do the
  same for their "in the box" moment). .sig-section--black already carries
  the light-on-dark variants for every type and rule token, defined once in
  optiq-signature.css.

  Uses the reversed split rather than the centred eyebrow/heading/lede/
  image stack it had before: the section above it is a left-image split, so
  mirroring the axis here keeps consecutive sections from reading as the
  same slide twice. Centred stacks are reserved for nothing on this page -
  every section now has a real composition.
{%- endcomment -%}

<section class="sig-section sig-section--black" id="sig-packaging" {{ section.shopify_attributes }}>
  <div class="sig-wrap sig-wrap--wide">
    <div class="sig-split sig-split--reverse" data-o-reveal-group>
      <div class="sig-split__media sig-mask" data-o-reveal>
        {% render 'sig-media', image: section.settings.image, label: 'Add packaging photograph' %}
      </div>

      <div class="sig-split__text">
        <p class="sig-meta" data-o-reveal="rise">
          <span class="sig-meta__num">{{ section.settings.index | default: '04' }}</span>
          <span>{{ section.settings.eyebrow | default: 'The presentation' | escape }}</span>
        </p>

        <h2 class="sig-h2" data-o-reveal="rise">{{ section.settings.heading | default: 'Arrives the way it should.' }}</h2>

        <p class="sig-body" data-o-reveal="rise">{{ section.settings.subheading | default: 'A solid black box, opened once and kept. The card sits inside exactly as it left our hands.' }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Signature packaging",
  "settings": [
    { "type": "text", "id": "index", "label": "Section number", "default": "04" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The presentation" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Arrives the way it should." },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Body copy",
      "default": "A solid black box, opened once and kept. The card sits inside exactly as it left our hands."
    },
    { "type": "image_picker", "id": "image", "label": "Packaging photograph" }
  ],
  "presets": [{ "name": "Signature packaging" }]
}
{% endschema %}
