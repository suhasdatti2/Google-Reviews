{%- comment -%}
  AI Receptionist - FAQ + final CTA. Replaces air-faq.liquid's visual
  system. The accordion reuses the same classes/controller as
  prem-product.liquid and prem-cards-faq.liquid (.prem-pdp__acc*,
  data-o-acc / data-o-acc-trigger - the theme-wide controller in
  assets/optiq-ui.js is class-agnostic).

  FAQPage structured data generated from the same blocks that render the
  visible list, so markup and schema can never drift apart - carried over
  unchanged from air-faq.liquid.
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}
{{ 'prem-product.css' | asset_url | stylesheet_tag }}
{{ 'prem-air.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign air_product = section.settings.product
  if air_product == blank
    assign air_product = product
  endif
  if air_product == blank
    assign air_product = all_products['ai-receptionist']
  endif

  assign setup_variant = blank
  for v in air_product.variants
    assign opt = v.title | downcase
    if opt contains 'setup'
      assign setup_variant = v
    endif
  endfor

  assign final_href = section.settings.cta_link | default: '#prem-air-pricing'
  if setup_variant != blank and section.settings.cta_link == blank
    capture final_href
      echo routes.cart_url | append: '/' | append: setup_variant.id | append: ':1'
    endcapture
  endif

  assign faqs = section.blocks | where: 'type', 'faq'
-%}

{%- if faqs.size > 0 -%}
  <section class="prem-section prem-air-section" id="prem-air-faq" {{ section.shopify_attributes }}>
    <div class="prem-wrap">
      <div class="prem-air-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="prem-config__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="prem-config__heading">{{ section.settings.heading | default: 'Frequently asked questions' }}</h2>
        {%- if section.settings.sub != blank -%}
          <p class="prem-config__body">{{ section.settings.sub | escape }}</p>
        {%- endif -%}
      </div>

      <div class="prem-pdp__acc" data-o-acc data-o-acc-single="true" style="max-width:760px;margin-inline:auto;">
        {%- for block in faqs -%}
          <div class="prem-pdp__acc-item" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="prem-pdp__acc-trigger"
              data-o-acc-trigger
              aria-expanded="false"
              aria-controls="prem-air-faq-{{ block.id }}"
            >
              {{ block.settings.question | escape }}
              <span class="prem-pdp__acc-sign" aria-hidden="true"></span>
            </button>
            <div class="prem-pdp__acc-panel" id="prem-air-faq-{{ block.id }}">
              <div class="o-rte">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} ---------------- Final CTA ---------------- {%- endcomment -%}
<section class="prem-section prem-air-final">
  <div class="prem-wrap">
    {%- if section.settings.final_eyebrow != blank -%}
      <p class="prem-config__eyebrow">{{ section.settings.final_eyebrow | escape }}</p>
    {%- endif -%}

    <h2 class="prem-intro__heading prem-air-final__title">{{ section.settings.final_heading | default: 'Ready to Stop Missing Customers?' }}</h2>

    {%- if section.settings.final_sub != blank -%}
      <p class="prem-config__body">{{ section.settings.final_sub | escape }}</p>
    {%- endif -%}

    <div class="prem-air-final__cta">
      <a class="prem-link" href="{{ final_href }}">{{ section.settings.cta_label | escape }}</a>
    </div>

    {%- if section.settings.final_note != blank -%}
      <p class="prem-air-final__note">{{ section.settings.final_note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{%- if faqs.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in faqs -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | strip | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "AI Receptionist FAQ + CTA",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "AI Receptionist product", "info": "Leave empty on the product template." },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Anything else, email sales@optiqservice.com and a real person will reply." },
    { "type": "header", "content": "Final CTA" },
    { "type": "text", "id": "final_eyebrow", "label": "Eyebrow", "default": "Get started" },
    { "type": "text", "id": "final_heading", "label": "Heading", "default": "Ready to Stop Missing Customers?" },
    { "type": "textarea", "id": "final_sub", "label": "Subheading", "default": "Set it up once. It answers every call after that." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Start Your AI Receptionist" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave empty to send straight to checkout for the one-time setup." },
    { "type": "text", "id": "final_note", "label": "Small note", "default": "Secure Shopify checkout. Shop Pay, Apple Pay and Google Pay accepted." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Can it book appointments?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. It reads your real availability and writes the booking straight into your calendar, then sends a confirmation.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "AI Receptionist FAQ + CTA",
      "blocks": [
        { "type": "faq", "settings": { "question": "Can it book appointments?", "answer": "<p>Yes. It reads your real availability, offers the slots that are actually free, writes the booking into your calendar and sends a confirmation before the caller hangs up.</p>" } },
        { "type": "faq", "settings": { "question": "Can it transfer calls?", "answer": "<p>Yes. You decide which situations warrant a transfer and where they go. Anything urgent or outside its remit gets routed to a person, with the context already gathered.</p>" } },
        { "type": "faq", "settings": { "question": "Can I customize the voice?", "answer": "<p>Yes. Voice, tone, pace and phrasing are all tuned during setup, and we keep adjusting until it sounds like your business rather than a robot.</p>" } },
        { "type": "faq", "settings": { "question": "Can it answer after hours?", "answer": "<p>That is most of the value. Nights, weekends and holidays are when the majority of missed calls happen, and it answers all of them the same way.</p>" } },
        { "type": "faq", "settings": { "question": "Does it work with my phone number?", "answer": "<p>Yes. You keep your existing number. We forward it, so nothing on your printed material, listings or business profile has to change.</p>" } },
        { "type": "faq", "settings": { "question": "How long does setup take?", "answer": "<p>Usually about a week from the moment we have your hours, services and calendar access. We tap-test the whole flow before switching it live.</p>" } }
      ]
    }
  ]
}
{% endschema %}
