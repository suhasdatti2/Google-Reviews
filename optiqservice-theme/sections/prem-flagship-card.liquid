{%- comment -%}
  Flagship product card - Premium Products page. Sits below the existing
  Ring / Metal Card showcase (sections/premium-showcase.liquid) as a
  deliberately separate section, so that section's fixed two-card grid is
  never touched. This card is the top of the hierarchy: Premium -> the
  existing premium metal cards -> the Signature Collection.

  Price and availability are read from the real Shopify product, exactly
  like every other price shown across this theme - never hardcoded here.

  The CTA does NOT link straight to the flagship product's own page: that
  page only renders correctly once templateSuffix is set on the product,
  which can't happen until the draft holding product.signature-collection.json
  is published (see the note on that assignment). Until then, and by
  explicit choice even after, it points at /pages/signature - the classic
  Optiq Signature card's own single-product page (premium-buildset in
  "card only" mode, no ring, no bundle).
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}
{{ 'prem-flagship.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign flag_product = section.settings.product
  if flag_product == blank
    assign flag_product = all_products['laser-engraved-signature-card']
  endif
  assign card_url = section.settings.cta_url | default: '/pages/signature'
-%}

{%- if flag_product != blank -%}
  <section class="prem-section" {{ section.shopify_attributes }}>
    <div class="prem-wrap">
      <div class="flag-card">
        <div>
          {%- if section.settings.badge != blank -%}
            <span class="flag-badge">{{ section.settings.badge | escape }}</span>
          {%- endif -%}
          <p class="flag-card__tag">{{ section.settings.tag | default: 'The Signature Collection' | escape }}</p>
          <h2 class="prem-config__heading" style="margin-bottom: 4px;">{{ section.settings.heading | default: flag_product.title | escape }}</h2>
          <p class="flag-card__price">{{ flag_product.price | money }}</p>
          <p class="flag-card__desc">{{ section.settings.description | default: 'Our most premium metal card. Real laser engraving, permanently engraved into premium metal, and customized to your digital identity.' | escape }}</p>
          <a class="prem-link" href="{{ card_url }}">{{ section.settings.cta_label | default: 'Explore Signature' | escape }}</a>
        </div>
        <div class="flag-card__media">
          {% render 'prem-media', image: section.settings.image, label: flag_product.title %}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Flagship card",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the Laser Engraved Signature Metal Card." },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Flagship" },
    { "type": "text", "id": "tag", "label": "Overline", "default": "The Signature Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the product's own title." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Our most premium metal card. Real laser engraving, permanently engraved into premium metal, and customized to your digital identity." },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Explore Signature" },
    { "type": "url", "id": "cta_url", "label": "Link URL", "info": "Defaults to /pages/signature, the classic Optiq Signature card page." },
    { "type": "image_picker", "id": "image", "label": "Card image" }
  ],
  "presets": [{ "name": "Flagship card" }]
}
{% endschema %}
