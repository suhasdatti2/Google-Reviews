{%- comment -%}
  Signature gallery - a pick-a-design grid matching LandoNorris.com's
  helmet gallery exactly: a 4-column staggered grid of square photo cards
  (columns 2 and 4 dropped ~190px), each with a bottom-right angled
  metadata panel, that crossfades to a second photo on hover to preview
  the design from another angle.

  Every photo is a real merchant upload via the block's image pickers -
  same honesty rule as sig-media (rendered through it for both slots), so a
  design with no photo yet shows the labelled placeholder rather than
  invented artwork. The hover-angle photo is optional per design; without
  one, a tile just shows its single photo with no crossfade, and the base
  image never dims on hover (nothing would be revealed underneath it).

  Hover photo source: a linked product's own "Hover Image (Image V2)"
  metafield (custom.hover_image, a store-wide definition every product
  has) takes priority when a product is linked, since that lets a design
  tied to a real product be managed straight from that product's own
  Shopify admin page. The block's own "Hover photo" upload is the
  fallback - for designs not tied to a specific product yet, or to
  override the product's metafield for this tile only.

  Cards without a link render as a plain, non-interactive tile (no href to
  fabricate) rather than a link to nowhere - same pattern as
  studio-collection's "coming soon" cards. A linked product's own URL is
  used when no explicit Link is set.
{%- endcomment -%}

<section class="sig-section sig-section--black sig-section--ruled" id="sig-gallery" data-sig-gallery {{ section.shopify_attributes }}>
  <div class="sig-wrap">
    <div class="sig-ghead" data-o-reveal-group>
      <p class="sig-meta" data-o-reveal="rise">
        <span class="sig-meta__num">{{ section.settings.index | default: '03' }}</span>
        <span>{{ section.settings.eyebrow | default: 'Choose your finish' | escape }}</span>
      </p>
      <div class="sig-ghead__row">
        <h2 class="sig-h2" data-o-reveal="rise">{{ section.settings.heading | default: 'Every card, made to order.' }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="sig-body" data-o-reveal="rise">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- assign designs = section.blocks | where: 'type', 'design' -%}
    {%- if designs.size > 0 -%}
      <div class="sig-gallery" data-o-reveal-group>
        {%- for block in designs -%}
          {%- assign design_name = block.settings.name | default: 'Design' -%}
          {%- assign linked_product = block.settings.product -%}

          {%- assign hover_image = block.settings.image_alt -%}
          {%- if hover_image == blank and linked_product != blank -%}
            {%- assign hover_image = linked_product.metafields.custom.hover_image -%}
          {%- endif -%}
          {%- assign has_alt = false -%}
          {%- if hover_image != blank -%}{%- assign has_alt = true -%}{%- endif -%}

          {%- assign card_link = block.settings.link -%}
          {%- if card_link == blank and linked_product != blank -%}{%- assign card_link = linked_product.url -%}{%- endif -%}

          {%- assign card_class = 'sig-gallery__card' -%}
          {%- if has_alt -%}{%- assign card_class = card_class | append: ' sig-gallery__card--has-alt' -%}{%- endif -%}

          {%- if card_link != blank -%}
          <a class="{{ card_class }}" href="{{ card_link }}" data-o-reveal="fade" {{ block.shopify_attributes }}>
          {%- else -%}
          <div class="{{ card_class }} sig-gallery__card--static" data-o-reveal="fade" {{ block.shopify_attributes }}>
          {%- endif -%}
            <div class="sig-gallery__media">
              <div class="sig-gallery__img sig-gallery__img--base">
                {% render 'sig-media', image: block.settings.image, label: design_name | append: ' photo goes here', alt: design_name %}
              </div>
              {%- if has_alt -%}
                <div class="sig-gallery__img sig-gallery__img--alt">
                  {% render 'sig-media', image: hover_image, alt: design_name | append: ' - alternate angle', loading: 'eager' %}
                </div>
              {%- endif -%}
            </div>
            <div class="sig-gallery__foot">
              <span class="sig-gallery__name">{{ design_name | escape }}</span>
              {%- if block.settings.tag != blank -%}
                <span class="sig-gallery__tag">{{ block.settings.tag | escape }}</span>
              {%- endif -%}
            </div>
          {%- if card_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="sig-body" style="max-width: none; text-align: center; margin-top: 40px;">Add design blocks to build this gallery.</p>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  // Touch devices have no hover, so the second photo would never be
  // reachable at all without this: first tap reveals it (and holds the
  // link), a second tap on the same card follows the link through as
  // normal. Desktop/mouse never runs this - :hover already does the job.
  var isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
  if (!isTouch) { return; }

  var root = document.querySelector('[data-sig-gallery]');
  if (!root) { return; }

  var cards = [].slice.call(root.querySelectorAll('.sig-gallery__card--has-alt'));
  cards.forEach(function (card) {
    card.addEventListener('click', function (e) {
      if (card.classList.contains('is-touched')) { return; }
      e.preventDefault();
      cards.forEach(function (c) { c.classList.remove('is-touched'); });
      card.classList.add('is-touched');
    });
  });

  document.addEventListener('click', function (e) {
    if (root.contains(e.target)) { return; }
    cards.forEach(function (c) { c.classList.remove('is-touched'); });
  });
})();
</script>

{% schema %}
{
  "name": "Signature gallery",
  "settings": [
    { "type": "text", "id": "index", "label": "Section number", "default": "03" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Choose your finish" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every card, made to order." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "design",
      "name": "Design",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "product",
          "id": "product",
          "label": "Linked product (optional)",
          "info": "Optional. When set, this tile's hover photo can come straight from that product's own \"Hover Image (Image V2)\" field in Shopify admin, and the card links to its product page unless a Link is set below."
        },
        {
          "type": "image_picker",
          "id": "image_alt",
          "label": "Hover photo (different angle)",
          "info": "Optional. Crossfades in over the main photo on hover (or on tap, on touch devices). Used when no product is linked above, or as an override for one tile even if the linked product has its own Hover Image set."
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Titanium Gray" },
        { "type": "text", "id": "tag", "label": "Tag", "info": "Optional short accent label, e.g. a year, New, or Limited." },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional. Where this design should take shoppers. Falls back to the linked product's own page if left blank." }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Signature gallery",
      "blocks": [
        { "type": "design", "settings": { "name": "Titanium Gray" } },
        { "type": "design", "settings": { "name": "Matte Black" } },
        { "type": "design", "settings": { "name": "Brushed Silver" } },
        { "type": "design", "settings": { "name": "Custom Engraved" } },
        { "type": "design", "settings": { "name": "Rose Gold" } },
        { "type": "design", "settings": { "name": "Matte White" } },
        { "type": "design", "settings": { "name": "Gunmetal" } },
        { "type": "design", "settings": { "name": "Champagne Gold" } },
        { "type": "design", "settings": { "name": "Carbon Fiber" } },
        { "type": "design", "settings": { "name": "Slate Blue" } },
        { "type": "design", "settings": { "name": "Copper" } },
        { "type": "design", "settings": { "name": "Onyx Black" } }
      ]
    }
  ]
}
{% endschema %}
