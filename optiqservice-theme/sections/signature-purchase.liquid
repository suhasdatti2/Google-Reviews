{%- comment -%}
  Optiq Signature - final purchase. Deliberately does NOT run its own
  add-to-cart: the configurator section above is the one real purchase
  flow on this page (state, variant resolution, the actual /cart/add.js
  call), so this section's CTA scrolls back up to it rather than
  duplicating that logic here. Two independent "buy" paths that could
  disagree is exactly the bug already found and removed once from
  snippets/card-configurator.liquid - not repeating it on this page.
{%- endcomment -%}

<section class="sig-section sig-section--marble sig-purchase" {{ section.shopify_attributes }}>
  <div class="sig-wrap">
    <span class="sig-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | default: 'Optiq Signature' }}</span>
    <h2 class="sig-h2" data-o-reveal="fade">{{ section.settings.heading | default: 'Own the Signature experience.' }}</h2>
    <p class="sig-lede" data-o-reveal="fade" style="margin-inline: auto;">{{ section.settings.subheading | default: 'Finished in your choice of metal, programmed with your review link, engraved if you like. One card, built to last.' }}</p>

    <div class="sig-purchase__media" data-o-reveal="fade">
      {% render 'sig-media', image: section.settings.image, label: 'Add closing product photo' %}
    </div>

    <p class="sig-purchase__price" data-o-reveal="fade"><small>From</small> <b>$99.99</b></p>

    <div class="sig-hero__actions" data-o-reveal="fade">
      <a class="sig-cta sig-cta--solid" href="#sig-configurator">{{ section.settings.cta_label | default: 'Configure Yours' }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Signature purchase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Optiq Signature" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Own the Signature experience." },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Finished in your choice of metal, programmed with your review link, engraved if you like. One card, built to last."
    },
    { "type": "image_picker", "id": "image", "label": "Closing product photo" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Configure Yours" }
  ],
  "presets": [{ "name": "Signature purchase" }]
}
{% endschema %}
