<section class="page-hero">
  <div class="page-width"><h1>{{ blog.title }}</h1></div>
</section>
<section class="section--tight">
  <div class="page-width">
    {%- paginate blog.articles by 12 -%}
      <div class="product-card-grid">
        {%- for article in blog.articles -%}
          <a class="product-card" href="{{ article.url }}">
            {%- if article.image != blank -%}
              <div class="product-card__media">{{ article.image | image_url: width: 600 | image_tag: alt: article.title }}</div>
            {%- endif -%}
            <div class="product-card__body">
              <h3>{{ article.title }}</h3>
              <p>{{ article.published_at | date: '%B %d, %Y' }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="pagination">{{ paginate | default_pagination }}</div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
