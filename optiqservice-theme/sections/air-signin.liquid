{{ 'optiq-app.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  ==========================================================================
  OPTIQ - Sign in  (inline, no hosted white page)
  --------------------------------------------------------------------------
  Authentication is Shopify's, and this store is on the latest customer
  accounts (passwordless: email -> emailed code). Password sign-in no longer
  exists on this store - it lived in classic/legacy accounts, which Shopify
  retired for stores not already using them (deprecation, Feb 2026). So the
  choice here is NOT "password vs code", it is "inline vs a hosted white
  page". This section takes the inline path.

  HOW THE WHITE PAGE IS AVOIDED:
  Shopify's <shopify-account> web component opens the whole sign-in / create-
  account flow in a sheet ON THIS PAGE - the customer never leaves the
  storefront and never sees the unstyled hosted screen. We drop a styled
  "Sign in" and "Create account" button into the component's signed-out slot,
  so clicking either one opens that inline sheet, and we colour the sheet with
  the component's CSS variables to match the site.

  NO DEAD END:
  If the component runtime has not upgraded the element yet (or at all),
  `shopify-account:not(:defined)` hides it and reveals the fallback below,
  which is the previous hosted-login link. So the button always does
  something: inline when the component is live, hosted link if it is not.

  Shopify owns the component's internals; we can colour it but not redraw it,
  and the sign-in methods it offers (email code, and Shop / Google if enabled
  in admin) are controlled in Settings -> Customer accounts, not here.
  ==========================================================================
{%- endcomment -%}

{%- assign target_url = section.settings.redirect_url | default: '/pages/ai-receptionist' -%}
{%- assign target_absolute = shop.url | append: target_url -%}

{%- if customer -%}
  {%- comment -%} Already authenticated - go straight to the receptionist page. {%- endcomment -%}
  <meta http-equiv="refresh" content="0; url={{ target_url }}">
  <script>window.location.replace({{ target_url | json }});</script>
{%- endif -%}

{%- assign ret = target_absolute | url_encode -%}
{%- assign login_url = routes.account_login_url | append: '?return_url=' | append: ret -%}

<div class="oqauth" {{ section.shopify_attributes }}>
  <div class="oqauth-card">

    <a class="oqauth-mark" href="{{ routes.root_url }}">
      <span class="oqauth-mark__dot">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 7v5l3 2"/></svg>
      </span>
      Optiq
    </a>

    <div class="oqauth-head">
      <h1>{{ section.settings.heading | escape }}</h1>
      <p>{{ section.settings.sub | escape }}</p>
    </div>

    {%- if shop.customer_accounts_enabled -%}
      {%- comment -%}
        The buttons live inside the component's signed-out-avatar slot, so a
        click on either opens the inline account sheet. The sheet is one flow:
        a returning email signs in, a new email creates the account - which is
        why "Create account" points at the same sheet.
      {%- endcomment -%}
      <shopify-account class="oqauth-account" menu="customer-account-main-menu">
        <div slot="signed-out-avatar" class="oqauth-actions">
          <button type="button" class="oqauth-cta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            {{ section.settings.email_cta | escape }}
          </button>
          <button type="button" class="oqauth-cta oqauth-cta--ghost">
            {{ section.settings.create_label | escape }}
          </button>
        </div>
      </shopify-account>

      {%- comment -%} Shown only if the component never upgrades - see header. {%- endcomment -%}
      <div class="oqauth-fallback">
        <a class="oqauth-cta" href="{{ login_url }}" data-oq-handoff>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          {{ section.settings.email_cta | escape }}
        </a>
        <a class="oqauth-cta oqauth-cta--ghost" href="{{ routes.account_register_url }}">
          {{ section.settings.create_label | escape }}
        </a>
      </div>
    {%- else -%}
      {%- comment -%} Accounts disabled in admin - only the hosted link is possible. {%- endcomment -%}
      <a class="oqauth-cta" href="{{ login_url }}" data-oq-handoff>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        {{ section.settings.email_cta | escape }}
      </a>
    {%- endif -%}

    <p class="oqauth-secure">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      {{ section.settings.secure_note | escape }}
    </p>

    <div class="oqauth-links">
      <a href="{{ section.settings.support_url | default: '/pages/contact' }}">{{ section.settings.support_label | escape }}</a>
    </div>

    <p class="oqauth-legal">
      {{ section.settings.legal_prefix | escape }}
      <a href="{{ section.settings.privacy_url | default: '/policies/privacy-policy' }}">{{ section.settings.privacy_label | escape }}</a>
      {{ section.settings.legal_join | escape }}
      <a href="{{ section.settings.terms_url | default: '/policies/terms-of-service' }}">{{ section.settings.terms_label | escape }}</a>.
    </p>

  </div>
</div>

<script>
  // Cosmetic only: label the fallback link while the browser navigates, so a
  // slow hop does not look like a dead click. Runs only for the fallback -
  // the component path opens inline and never navigates. Nothing here touches
  // authentication.
  (function () {
    var cta = document.querySelector('[data-oq-handoff]');
    if (!cta) return;
    cta.addEventListener('click', function () {
      cta.classList.add('is-handing-off');
      cta.setAttribute('aria-busy', 'true');
    });
  })();
</script>

{% schema %}
{
  "name": "Sign in",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sign in to Optiq" },
    { "type": "textarea", "id": "sub", "label": "Supporting text", "default": "Sign in or create your account right here - no password to remember. We'll email you a secure code." },
    { "type": "text", "id": "email_cta", "label": "Primary button", "default": "Sign in" },
    { "type": "text", "id": "secure_note", "label": "Reassurance line", "default": "Secure, passwordless sign-in by Shopify" },
    { "type": "text", "id": "create_label", "label": "Create-account button", "default": "Create account" },
    { "type": "text", "id": "support_label", "label": "Support link", "default": "Contact support" },
    { "type": "url", "id": "support_url", "label": "Support link URL", "info": "Defaults to /pages/contact" },
    { "type": "header", "content": "Legal" },
    { "type": "text", "id": "legal_prefix", "label": "Legal prefix", "default": "By continuing you agree to our" },
    { "type": "text", "id": "privacy_label", "label": "Privacy link text", "default": "Privacy Policy" },
    { "type": "url", "id": "privacy_url", "label": "Privacy link URL", "info": "Defaults to /policies/privacy-policy" },
    { "type": "text", "id": "legal_join", "label": "Joining word", "default": "and" },
    { "type": "text", "id": "terms_label", "label": "Terms link text", "default": "Terms" },
    { "type": "url", "id": "terms_url", "label": "Terms link URL", "info": "Defaults to /policies/terms-of-service" },
    { "type": "header", "content": "Routing" },
    { "type": "url", "id": "redirect_url", "label": "Where to send a signed-in visitor", "info": "Defaults to /pages/ai-receptionist - the visitor lands there logged in, then clicks \"View Dashboard\" in the header to reach /pages/my-receptionist." }
  ],
  "presets": [{ "name": "Sign in" }]
}
{% endschema %}
