{{ 'optiq-app.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  ==========================================================================
  OPTIQ - Sign in
  --------------------------------------------------------------------------
  Authentication is owned entirely by Shopify's modern Customer Accounts
  (passwordless: email -> emailed verification code). This store is already
  on NEW_CUSTOMER_ACCOUNTS, so `routes.account_login_url` IS that email-code
  flow - there is nothing to build, fake, or verify in the theme, and doing
  so would be a security problem (a theme has no backend to check a code
  against). This section is presentation only; the single button hands off
  to Shopify's hosted, secure sign-in. No "Sign in with Shop" / Shop App
  button exists anywhere in this flow - "Continue with Email" is the only
  entry point, and it goes straight to Shopify's own email-code login.

  POST-LOGIN DESTINATION: after completing the emailed code, a signed-in
  visitor should land on /pages/ai-receptionist (fully refreshed, logged
  in) - NOT straight into the dashboard, and NOT on Shopify's default
  hosted account/orders page. From there the header's "View Dashboard"
  button is the explicit, visible next step into /pages/my-receptionist.

  Why the fix below matters: Shopify's NEW customer accounts run on a
  separate hosted domain (account.<shop>.com), not the storefront domain,
  so a plain relative return_url (e.g. "/pages/ai-receptionist") has no
  origin for that hosted domain to resolve against and gets silently
  dropped, landing the customer on its own default orders screen instead.
  Passing a full, absolute URL (https://<shop-domain>/pages/ai-receptionist)
  gives it something it can actually redirect to. This is the one lever a
  theme has over that hosted page; if a future Shopify account-flow version
  still ignores it, the customer still lands authenticated, and this page
  itself carries the same redirect for anyone who returns here already
  signed in.
  ==========================================================================
{%- endcomment -%}

{%- assign target_url = section.settings.redirect_url | default: '/pages/ai-receptionist' -%}
{%- assign target_absolute = shop.url | append: target_url -%}

{%- if customer -%}
  {%- comment -%} Already authenticated - go straight to the receptionist page. {%- endcomment -%}
  <meta http-equiv="refresh" content="0; url={{ target_url }}">
  <script>window.location.replace({{ target_url | json }});</script>
{%- endif -%}

{%- assign ret = target_absolute | url_encode -%}
{%- assign login_url = routes.account_login_url | append: '?return_url=' | append: ret -%}

<div class="oqauth" {{ section.shopify_attributes }}>
  <div class="oqauth-card">

    <a class="oqauth-mark" href="{{ routes.root_url }}">
      <span class="oqauth-mark__dot">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 7v5l3 2"/></svg>
      </span>
      Optiq
    </a>

    <div class="oqauth-head">
      <h1>{{ section.settings.heading | escape }}</h1>
      <p>{{ section.settings.sub | escape }}</p>
    </div>

    <a class="oqauth-cta" href="{{ login_url }}" data-oq-handoff>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      {{ section.settings.email_cta | escape }}
    </a>

    <p class="oqauth-secure">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      {{ section.settings.secure_note | escape }}
    </p>

    {%- comment -%}
      The next two screens (enter email, enter code) are hosted by Shopify on
      its own domain, so no theme CSS reaches them - see the header comment.
      Naming the step up front is the one thing the theme CAN do about it: an
      unexplained jump to a plain page reads as broken, an expected one reads
      as a security step.
    {%- endcomment -%}
    {%- if section.settings.steps_note != blank -%}
      <p class="oqauth-steps">{{ section.settings.steps_note | escape }}</p>
    {%- endif -%}

    <div class="oqauth-links">
      <a href="{{ routes.account_register_url }}">{{ section.settings.create_label | escape }}</a>
      <span>&middot;</span>
      <a href="{{ section.settings.support_url | default: '/pages/contact' }}">{{ section.settings.support_label | escape }}</a>
    </div>

    <p class="oqauth-legal">
      {{ section.settings.legal_prefix | escape }}
      <a href="{{ section.settings.privacy_url | default: '/policies/privacy-policy' }}">{{ section.settings.privacy_label | escape }}</a>
      {{ section.settings.legal_join | escape }}
      <a href="{{ section.settings.terms_url | default: '/policies/terms-of-service' }}">{{ section.settings.terms_label | escape }}</a>.
    </p>

  </div>
</div>

<script>
  // Purely cosmetic: label the button while the browser navigates to
  // Shopify's hosted sign-in, so a slow hop doesn't look like a dead click.
  // Navigation is the anchor's own default - nothing here is required for
  // sign-in to work, and nothing here touches authentication.
  (function () {
    var cta = document.querySelector('[data-oq-handoff]');
    if (!cta) return;
    cta.addEventListener('click', function () {
      cta.classList.add('is-handing-off');
      cta.setAttribute('aria-busy', 'true');
    });
  })();
</script>

{% schema %}
{
  "name": "Sign in",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sign in to Optiq" },
    { "type": "text", "id": "steps_note", "label": "Hand-off note",
      "default": "Next: enter your email, then the 6-digit code we send you. Two quick steps on Shopify's secure page, then you're back here.",
      "info": "Sets expectations for Shopify's hosted sign-in screens, which the theme cannot style." },
    { "type": "textarea", "id": "sub", "label": "Supporting text", "default": "We'll send you a secure verification code to sign in. No password to remember." },
    { "type": "text", "id": "email_cta", "label": "Primary button", "default": "Continue with Email" },
    { "type": "text", "id": "secure_note", "label": "Reassurance line", "default": "Secure, passwordless sign-in by Shopify" },
    { "type": "text", "id": "create_label", "label": "Create-account link", "default": "Create account" },
    { "type": "text", "id": "support_label", "label": "Support link", "default": "Contact support" },
    { "type": "url", "id": "support_url", "label": "Support link URL", "info": "Defaults to /pages/contact" },
    { "type": "header", "content": "Legal" },
    { "type": "text", "id": "legal_prefix", "label": "Legal prefix", "default": "By continuing you agree to our" },
    { "type": "text", "id": "privacy_label", "label": "Privacy link text", "default": "Privacy Policy" },
    { "type": "url", "id": "privacy_url", "label": "Privacy link URL", "info": "Defaults to /policies/privacy-policy" },
    { "type": "text", "id": "legal_join", "label": "Joining word", "default": "and" },
    { "type": "text", "id": "terms_label", "label": "Terms link text", "default": "Terms" },
    { "type": "url", "id": "terms_url", "label": "Terms link URL", "info": "Defaults to /policies/terms-of-service" },
    { "type": "header", "content": "Routing" },
    { "type": "url", "id": "redirect_url", "label": "Where to send a signed-in visitor", "info": "Defaults to /pages/ai-receptionist - the visitor lands there logged in, then clicks \"View Dashboard\" in the header to reach /pages/my-receptionist." }
  ],
  "presets": [{ "name": "Sign in" }]
}
{% endschema %}
