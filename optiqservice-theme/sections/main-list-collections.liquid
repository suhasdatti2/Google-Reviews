<section class="page-hero">
  <div class="page-width"><h1>Collections</h1></div>
</section>
<section class="section--tight">
  <div class="page-width">
    <div class="product-card-grid">
      {%- for collection in collections -%}
        <a class="product-card" href="{{ collection.url }}">
          {%- if collection.featured_image != blank -%}
            <div class="product-card__media">{{ collection.featured_image | image_url: width: 600 | image_tag: alt: collection.title }}</div>
          {%- endif -%}
          <div class="product-card__body"><h3>{{ collection.title }}</h3></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
