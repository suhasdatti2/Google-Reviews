<section class="hero">
  <div class="page-width hero__grid">
    <div>
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p class="hero__sub">{{ section.settings.subheading }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="{{ section.settings.button_link | default: '/products/google-review-nfc-card' }}">{{ section.settings.button_label }}</a>
        <a class="btn btn--ghost btn--lg" href="#how-it-works">{{ section.settings.secondary_label }}</a>
      </div>
      <p class="hero__trust">{{ section.settings.trust_line }}</p>
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', alt: section.settings.image.alt }}
      {%- else -%}
        {% render 'image-placeholder', label: 'Add your hero photo in theme settings' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Tap-to-review cards for local businesses" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get More Google Reviews With One Tap" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A premium card programmed with your Google review link. Happy customers tap it with their phone and your review page opens instantly — no app, no monthly fee."
    },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Get My Review Card" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "See How It Works" },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line",
      "default": "Works with iPhone & Android · No app needed · One-time purchase"
    },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
