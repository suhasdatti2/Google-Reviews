<section class="product-page">
  <div class="page-width product-grid">

    <div class="product-media">
      {% render 'product-gallery', product: product %}
    </div>

    <div class="product-info">
      <h1>{{ product.title }}</h1>
      <p class="product-info__price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</p>
      <p class="product-info__tagline">{{ section.settings.tagline }}</p>

      {%- comment -%} Real product data for the variant picker in product-form.js {%- endcomment -%}
      <script type="application/json" data-product-json>{{ product | json }}</script>

      <form data-product-form class="product-form">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product-option" data-option-index="{{ forloop.index0 }}">
              <span class="product-option__label">{{ option.name }}</span>
              <div class="product-option__values">
                {%- for value in option.values -%}
                  {%- assign is_selected = false -%}
                  {%- if product.selected_or_first_available_variant.options[forloop.parentloop.index0] == value -%}{%- assign is_selected = true -%}{%- endif -%}
                  <label class="product-option__value{% if is_selected %} is-selected{% endif %}">
                    <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if is_selected %}checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        {# Selected variant id — kept in sync by product-form.js #}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="product-qty">
          <label for="prod-qty">Quantity</label>
          <div class="qty-stepper">
            <button type="button" data-qty-dec aria-label="Decrease quantity">&minus;</button>
            <input id="prod-qty" name="quantity" type="number" value="1" min="1" inputmode="numeric">
            <button type="button" data-qty-inc aria-label="Increase quantity">&plus;</button>
          </div>
        </div>

        <div class="personalize">
          <h3>Personalize your card</h3>

          <div class="form-field">
            <label for="prop-business">Business name *</label>
            <input id="prop-business" type="text" name="properties[Business name]" required placeholder="e.g. Fresh Fades Barbershop">
          </div>

          <div class="form-field">
            <label for="prop-link">Google review link *</label>
            <input id="prop-link" type="url" name="properties[Google review link]" required placeholder="https://g.page/r/...">
            <p class="hint">Not sure where to find it? Paste your Google Business Profile link — we'll sort out the rest.</p>
          </div>

          <div class="form-field">
            <label for="prop-contact">Best email or phone *</label>
            <input id="prop-contact" type="text" name="properties[Contact email or phone]" required placeholder="you@business.com">
            <p class="hint">We'll only use this if we have a question about your link.</p>
          </div>

          <p class="personalize__note">Prefer to send it later? Order now and email your review link to {{ settings.contact_email }} — just include your order number.</p>
        </div>

        <div class="product-actions">
          <button type="submit" class="btn btn--primary btn--lg btn--full" data-add-to-cart data-label="{{ section.settings.buy_label }}">{{ section.settings.buy_label }}</button>
          <button type="button" class="btn btn--ghost btn--lg btn--full" data-buy-now>Buy Now</button>
        </div>
      </form>

      {%- if section.settings.show_membership_upsell -%}
        <div class="membership-upsell">
          <h3>{{ section.settings.membership_title }} — {{ section.settings.membership_price }}{{ section.settings.membership_period }}</h3>
          <p>{{ section.settings.membership_description }}</p>
          {%- if settings.membership_variant_id != blank -%}
            <button type="button" class="btn btn--ghost"
              data-add-variant="{{ settings.membership_variant_id }}"
              {% if settings.membership_selling_plan_id != blank %}data-selling-plan="{{ settings.membership_selling_plan_id }}"{% endif %}
              data-fallback="{{ section.settings.membership_link | default: '/pages/membership' }}">
              {{ section.settings.membership_button_label }}
            </button>
          {%- else -%}
            <a class="btn btn--ghost" href="{{ section.settings.membership_link | default: '/pages/membership' }}">{{ section.settings.membership_button_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="product-benefits">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong> — {{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="product-description rte">{{ product.description }}</div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline under price",
      "default": "Programmed with your Google review link. No app. No monthly fee."
    },
    { "type": "text", "id": "buy_label", "label": "Add to cart button label", "default": "Add to Cart — Get More Reviews" },
    { "type": "header", "content": "Membership upsell" },
    { "type": "checkbox", "id": "show_membership_upsell", "label": "Show membership upsell box", "default": true },
    { "type": "text", "id": "membership_title", "label": "Title", "default": "Add Review Growth Plan" },
    { "type": "text", "id": "membership_price", "label": "Price", "default": "$14.99" },
    { "type": "text", "id": "membership_period", "label": "Period suffix", "default": "/mo" },
    {
      "type": "textarea",
      "id": "membership_description",
      "label": "Description",
      "default": "Keep your review card updated and get monthly tools to help your business collect more honest Google reviews. Includes free link updates, monthly review check-ins, customer message templates, priority support, and discounts on future cards."
    },
    { "type": "text", "id": "membership_button_label", "label": "Button label", "default": "Add Review Growth Plan" },
    { "type": "url", "id": "membership_link", "label": "Fallback link (used if no membership variant ID is set)" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "One tap, no typing" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Customers tap the card and your Google review page opens instantly." }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
