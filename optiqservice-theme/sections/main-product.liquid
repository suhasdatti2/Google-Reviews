{%- assign product_gallery_image = blank -%}
{%- case product.handle -%}
  {%- when 'bulk-restaurant-pack' -%}
    {%- assign product_gallery_image = section.settings.bulk_restaurant_pack_product_image -%}
  {%- when 'bulk-review-cards' -%}
    {%- assign product_gallery_image = section.settings.bulk_square_handout_cards_product_image -%}
  {%- when 'google-review-nfc-card' -%}
    {%- assign product_gallery_image = section.settings.main_counter_card_product_image -%}
  {%- when 'review-growth-plan' -%}
    {%- assign product_gallery_image = section.settings.review_growth_plan_product_image -%}
  {%- when 'google-review-nfc-wristband' -%}
    {%- assign product_gallery_image = section.settings.wristband_product_image -%}
{%- endcase -%}

{%- comment -%}
  What the "Personalize your ___" heading and its review-link field call the
  item, so a wristband buyer is not asked to personalize a "card". Extend
  this list rather than hardcoding a single swap, so the next non-card
  product (a keychain, a stand, whatever) is a one-line addition here, not a
  parallel set of hardcoded strings this section forgets to update.
{%- endcomment -%}
{%- assign personalize_noun = 'card' -%}
{%- if product.handle == 'google-review-nfc-wristband' -%}
  {%- assign personalize_noun = 'wristband' -%}
{%- endif -%}

<section class="product-page">
  <div class="page-width product-grid">

    <div class="product-media">
      {% render 'product-gallery', product: product, override_image: product_gallery_image %}
    </div>

    <div class="product-info">
      <h1>{{ product.title }}</h1>
      <p class="product-info__price" data-vpick-price>{{ product.selected_or_first_available_variant.price | money }}</p>
      <p class="product-info__tagline">{{ section.settings.tagline }}</p>

      {%- form 'product', product, class: 'product-form' -%}
        {%- comment -%}
          Button-based variant picker instead of a <select>. The old dropdown
          listed all 12 combinations as one flat list ("Black / 2 Cards / With
          QR - $59.99"), forcing the shopper to parse three decisions at once.

          Everything below is generated from the product's real options, so it
          works unchanged for Main Counter Card (Colour / Pack / QR code) and
          Bulk Square Handout Cards (Colour / Size / QR code) even though their
          middle option is named differently, and it renders nothing at all for
          single-variant products like the Review Growth Plan.
        {%- endcomment -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-vpick-id>

        {%- unless product.has_only_default_variant -%}
          <div class="vpick" data-vpick>
            {%- for option in product.options_with_values -%}
              {%- assign lowered_name = option.name | downcase -%}
              <div class="vpick__group">
                <span class="vpick__label" id="vpick-label-{{ forloop.index0 }}">{{ option.name }}</span>
                <div class="vpick__opts" role="group" aria-labelledby="vpick-label-{{ forloop.index0 }}">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="vpick__btn{% if option.selected_value == value %} is-active{% endif %}"
                      data-vpick-btn
                      data-index="{{ forloop.parentloop.index0 }}"
                      data-value="{{ value | escape }}"
                      aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">
                      <span class="vpick__btn-name">{{ value }}</span>
                      <span class="vpick__btn-sub" data-vpick-sub></span>
                    </button>
                  {%- endfor -%}
                </div>
                {%- if lowered_name contains 'qr' and section.settings.show_qr_addon and section.settings.qr_pricing_note != blank -%}
                  <p class="vpick__note">{{ section.settings.qr_pricing_note }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <div class="personalize">
          <h3>Personalize your {{ personalize_noun }}</h3>

          <div class="form-field">
            <label for="prop-business">Business name *</label>
            <input id="prop-business" type="text" name="properties[Business name]" required placeholder="e.g. Fresh Fades Barbershop">
          </div>

          {%- comment -%}
            Deliberately type="text", not type="url". Most customers do not know
            their raw Google review link and will type their website, their Maps
            listing, or just their business name - all of which we can work from.
            URL validation rejects every one of those and blocks checkout on a
            field we are happy to sort out after the order is placed.
          {%- endcomment -%}
          <div class="form-field">
            <label for="prop-link">Google review link *</label>
            <input id="prop-link" type="text" name="properties[Google review link]" required placeholder="Review link, website, or business name" autocomplete="off" spellcheck="false">
            <p class="hint">Anything works here - your review link, your website, your Google Maps listing, or just your business name and city. If it is not the exact review link, we will track it down for you before we program your {{ personalize_noun }}.</p>
          </div>

          <div class="form-field">
            <label for="prop-contact">Best email or phone *</label>
            <input id="prop-contact" type="text" name="properties[Contact email or phone]" required placeholder="you@business.com">
            <p class="hint">We'll only reach out if we have a question about your link.</p>
          </div>

          <p class="personalize__note">Prefer to send it later? Place your order now and email your review link to {{ settings.contact_email }} with your order number.</p>
        </div>

        <button type="submit" class="btn btn--primary btn--lg btn--full" data-vpick-submit {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          {%- if product.selected_or_first_available_variant.available -%}
            {{ section.settings.buy_label }}
          {%- else -%}
            Sold out
          {%- endif -%}
        </button>
      {%- endform -%}

      {%- comment -%}
        The membership upsell box, the benefit checklist, and the long product
        description used to render here. Removed deliberately: this is a buying
        page, and three screens of prose under the button gave the shopper more
        to read rather than more reason to buy. None of that copy is lost - the
        description still lives on the product in Shopify admin, and the benefit
        and membership content still runs on the homepage.
      {%- endcomment -%}
    </div>

  </div>
</section>

<script>
(function () {
  var root = document.querySelector('[data-vpick]');
  var idInput = document.querySelector('[data-vpick-id]');
  var priceEl = document.querySelector('[data-vpick-price]');
  var submitBtn = document.querySelector('[data-vpick-submit]');
  if (!root || !idInput) { return; }

  var VARIANTS = [
    {%- for v in product.variants -%}
      { id: {{ v.id | json }}, price: {{ v.price | json }}, available: {{ v.available | json }}, options: {{ v.options | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
  var OPTION_NAMES = {{ product.options | json }};
  var BUY_LABEL = {{ section.settings.buy_label | default: 'Add to Cart' | json }};

  var buttons = [].slice.call(root.querySelectorAll('[data-vpick-btn]'));
  var selected = OPTION_NAMES.map(function (_, i) {
    var active = root.querySelector('[data-vpick-btn][data-index="' + i + '"].is-active');
    return active ? active.getAttribute('data-value') : null;
  });

  function money(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function matches(variant, choice) {
    for (var i = 0; i < choice.length; i++) {
      if (choice[i] !== null && variant.options[i] !== choice[i]) { return false; }
    }
    return true;
  }

  function findVariant(choice) {
    for (var i = 0; i < VARIANTS.length; i++) {
      if (matches(VARIANTS[i], choice)) { return VARIANTS[i]; }
    }
    return null;
  }

  // The variant you would land on if you flipped one option and kept the rest.
  function variantIfSwapped(index, value) {
    var probe = selected.slice();
    probe[index] = value;
    return findVariant(probe);
  }

  function render() {
    var current = findVariant(selected);

    buttons.forEach(function (btn) {
      var index = parseInt(btn.getAttribute('data-index'), 10);
      var value = btn.getAttribute('data-value');
      var isActive = selected[index] === value;
      var candidate = variantIfSwapped(index, value);
      var sub = btn.querySelector('[data-vpick-sub]');
      var name = String(OPTION_NAMES[index] || '');

      btn.classList.toggle('is-active', isActive);
      btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      btn.disabled = !(candidate && candidate.available);

      if (!sub) { return; }

      if (!candidate) {
        sub.textContent = 'Unavailable';
      } else if (/colou?r/i.test(name)) {
        // Colour never changes the price, so a number here is just noise.
        sub.textContent = '';
      } else if (/qr/i.test(name)) {
        // Show what this choice ADDS relative to what is selected right now.
        // The upcharge is not a flat $5 - on bulk packs it scales with pack
        // size - so it is always read off the real variant prices.
        var base = current ? parseInt(current.price, 10) : null;
        var delta = base === null ? null : parseInt(candidate.price, 10) - base;
        if (delta === null || delta === 0) {
          sub.textContent = isActive ? 'Included' : '';
        } else if (delta > 0) {
          sub.textContent = '+' + money(delta);
        } else {
          sub.textContent = '-' + money(Math.abs(delta));
        }
      } else {
        sub.textContent = money(parseInt(candidate.price, 10));
      }
    });

    if (current) {
      idInput.value = current.id;
      if (priceEl) { priceEl.textContent = money(parseInt(current.price, 10)); }
      if (submitBtn) {
        submitBtn.disabled = !current.available;
        submitBtn.textContent = current.available ? BUY_LABEL : 'Sold out';
      }
    } else if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Unavailable';
    }
  }

  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (btn.disabled) { return; }
      selected[parseInt(btn.getAttribute('data-index'), 10)] = btn.getAttribute('data-value');
      render();
    });
  });

  // ?qr=1 arrives from the homepage configurator - preselect the QR option
  // rather than ticking a checkbox that no longer exists.
  if (new URLSearchParams(window.location.search).get('qr') === '1') {
    for (var i = 0; i < OPTION_NAMES.length; i++) {
      if (!/qr/i.test(String(OPTION_NAMES[i]))) { continue; }
      for (var j = 0; j < buttons.length; j++) {
        var b = buttons[j];
        if (parseInt(b.getAttribute('data-index'), 10) !== i) { continue; }
        if (/with|yes/i.test(b.getAttribute('data-value'))) { selected[i] = b.getAttribute('data-value'); }
      }
    }
  }

  render();
})();
</script>

{% stylesheet %}
.vpick {
  display: grid;
  gap: 20px;
  margin: 0 0 24px;
}
.vpick__group { display: grid; gap: 10px; }
.vpick__label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-muted, #a1a1aa);
}
.vpick__opts { display: flex; flex-wrap: wrap; gap: 10px; }
.vpick__btn {
  appearance: none;
  cursor: pointer;
  display: grid;
  gap: 3px;
  justify-items: start;
  min-width: 108px;
  padding: 12px 16px;
  border: 1px solid var(--border, #2a2a30);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.02);
  color: inherit;
  font: inherit;
  text-align: left;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}
.vpick__btn:hover:not(:disabled) { border-color: rgba(255, 255, 255, 0.3); }
.vpick__btn:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
.vpick__btn.is-active {
  border-color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.07);
}
.vpick__btn:disabled { opacity: 0.35; cursor: not-allowed; }
.vpick__btn-name { font-size: 15px; font-weight: 600; line-height: 1.2; }
.vpick__btn-sub {
  font-size: 13px;
  line-height: 1.2;
  color: var(--ink-muted, #a1a1aa);
}
.vpick__btn-sub:empty { display: none; }
.vpick__btn.is-active .vpick__btn-sub { color: inherit; }
.vpick__note {
  margin: 2px 0 0;
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--ink-muted, #a1a1aa);
}
@media (max-width: 540px) {
  .vpick__btn { min-width: 0; flex: 1 1 calc(50% - 5px); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "header",
      "content": "Product page photos"
    },
    {
      "type": "paragraph",
      "content": "These control the large image shown on each product buying page. They override product media for this theme."
    },
    {
      "type": "image_picker",
      "id": "bulk_restaurant_pack_product_image",
      "label": "Bulk Restaurant Pack product page image"
    },
    {
      "type": "image_picker",
      "id": "bulk_square_handout_cards_product_image",
      "label": "Bulk Square Handout Cards product page image"
    },
    {
      "type": "image_picker",
      "id": "main_counter_card_product_image",
      "label": "Main Counter Card product page image"
    },
    {
      "type": "image_picker",
      "id": "review_growth_plan_product_image",
      "label": "Review Growth Plan product page image"
    },
    {
      "type": "image_picker",
      "id": "wristband_product_image",
      "label": "Google Review Wristband product page image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline under price",
      "default": "Programmed with your Google review link. One tap, no app, no QR code needed."
    },
    { "type": "text", "id": "buy_label", "label": "Buy button label", "default": "Add to Cart" },
    { "type": "header", "content": "QR code option" },
    {
      "type": "paragraph",
      "content": "QR is a real product option, so its price comes straight from the variants and updates itself. The note below shows under the QR buttons."
    },
    { "type": "checkbox", "id": "show_qr_addon", "label": "Show the QR helper note", "default": true },
    {
      "type": "text",
      "id": "qr_pricing_note",
      "label": "QR helper note",
      "default": "Not required - just an optional backup for phones that can't tap."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit (unused)",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
