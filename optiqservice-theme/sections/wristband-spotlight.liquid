{%- comment -%}
  Wristband spotlight - introduces the new Google Review NFC Wristband right
  next to the existing Google Review NFC Card, so a visitor sees both options
  immediately. Built entirely from this page's own design tokens (base.css:
  --bg-raised, --border, --radius, --ink-muted, --white, --black) and the same
  .section / .page-width / .kicker / .btn / .spec component patterns already
  used by the sections around it (hero, card-showcase, product-highlight) -
  no new visual language, just new layout scaffolding.
{%- endcomment -%}

{%- liquid
  assign card = all_products[section.settings.card_handle]
  assign wristband = all_products[section.settings.wristband_handle]
-%}

{%- if wristband -%}
<section class="section section--tight wristband-spotlight">
  <div class="page-width">
    <span class="kicker">{{ section.settings.kicker }}</span>
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    <p class="section-sub">{{ section.settings.subheading }}</p>

    <div class="wristband-compare">

      {%- if card -%}
      <a class="wristband-compare__item" href="{{ card.url }}">
        <div class="wristband-compare__media">
          {%- if card.featured_image != blank -%}
            {{ card.featured_image | image_url: width: 700 | image_tag: alt: card.featured_image.alt }}
          {%- else -%}
            {% render 'image-placeholder', square: true %}
          {%- endif -%}
        </div>
        <div class="wristband-compare__body">
          <span class="wristband-compare__eyebrow">{{ section.settings.card_label }}</span>
          <h3>{{ card.title }}</h3>
          <p class="wristband-compare__price">From {{ card.price_min | money }}</p>
          <span class="wristband-compare__link">View the card &rarr;</span>
        </div>
      </a>
      {%- endif -%}

      <a class="wristband-compare__item wristband-compare__item--featured" href="{{ wristband.url }}">
        <div class="wristband-compare__media">
          {%- if wristband.featured_image != blank -%}
            {{ wristband.featured_image | image_url: width: 700 | image_tag: alt: wristband.featured_image.alt }}
          {%- else -%}
            {% render 'image-placeholder', square: true %}
          {%- endif -%}
        </div>
        <div class="wristband-compare__body">
          <span class="wristband-compare__eyebrow wristband-compare__eyebrow--new">{{ section.settings.wristband_label }}</span>
          <h3>{{ wristband.title }}</h3>
          <p class="wristband-compare__price">From {{ wristband.price_min | money }}</p>
          <span class="wristband-compare__link">Shop the wristband &rarr;</span>
        </div>
      </a>

    </div>

    <div class="spec-row wristband-spotlight__badges">
      {%- assign badges = section.settings.badges | split: ',' -%}
      {%- for badge in badges -%}
        <div class="spec wristband-spotlight__badge">
          <span class="wristband-spotlight__check" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none"><path d="M3.5 8.3 6.4 11l6.1-6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h4>{{ badge | strip }}</h4>
        </div>
      {%- endfor -%}
    </div>

    <div class="wristband-spotlight__cta">
      <a class="btn btn--primary btn--lg" href="{{ wristband.url }}">{{ section.settings.button_label }}</a>
    </div>

  </div>
</section>
{%- endif -%}

{% stylesheet %}
.wristband-spotlight { border-top: 1px solid var(--border); }

.wristband-compare {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-top: 40px;
}
@media (max-width: 640px) { .wristband-compare { grid-template-columns: 1fr; } }

.wristband-compare__item {
  display: block;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--bg-raised);
  overflow: hidden;
  transition: border-color 0.15s ease, transform 0.15s ease;
}
.wristband-compare__item:hover { border-color: var(--border-strong); transform: translateY(-2px); opacity: 1; }
.wristband-compare__item--featured { border-color: var(--white); }

.wristband-compare__media {
  aspect-ratio: 1;
  background: var(--bg-raised-2);
  display: flex; align-items: center; justify-content: center;
}
.wristband-compare__media img { width: 100%; height: 100%; object-fit: cover; }

.wristband-compare__body { padding: 22px 24px 26px; }

.wristband-compare__eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: 10px;
}
.wristband-compare__eyebrow--new {
  color: var(--black);
  background: var(--white);
  padding: 4px 10px;
  border-radius: 999px;
}

.wristband-compare__item h3 { font-size: 19px; margin-bottom: 4px; }
.wristband-compare__price { color: var(--ink-muted); font-size: 15px; margin-bottom: 12px; }
.wristband-compare__link { font-size: 13.5px; font-weight: 600; color: var(--ink); }

.wristband-spotlight__badges { grid-template-columns: repeat(4, 1fr); margin-top: 24px; }
@media (max-width: 980px) { .wristband-spotlight__badges { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .wristband-spotlight__badges { grid-template-columns: 1fr; } }

.wristband-spotlight__badge { display: flex; align-items: center; gap: 12px; }
.wristband-spotlight__badge h4 { font-size: 14.5px; margin: 0; }
.wristband-spotlight__check {
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  width: 26px; height: 26px;
  border-radius: 50%;
  background: var(--white);
  color: var(--black);
}
.wristband-spotlight__check svg { width: 14px; height: 14px; }

.wristband-spotlight__cta { margin-top: 32px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Wristband spotlight",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Now Available: The Google Review Wristband" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Same one-tap technology as the card, worn instead of displayed - built for anyone on their feet interacting with customers all day."
    },
    { "type": "text", "id": "card_handle", "label": "Card product handle", "default": "google-review-nfc-card" },
    { "type": "text", "id": "card_label", "label": "Card eyebrow label", "default": "Also available" },
    { "type": "text", "id": "wristband_handle", "label": "Wristband product handle", "default": "google-review-nfc-wristband" },
    { "type": "text", "id": "wristband_label", "label": "Wristband eyebrow label", "default": "New" },
    {
      "type": "text",
      "id": "badges",
      "label": "Badges (comma-separated)",
      "default": "NFC Enabled, Waterproof, Works with iPhone & Android, No App Required"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Wristband" }
  ],
  "presets": [{ "name": "Wristband spotlight" }]
}
{% endschema %}
