{%- comment -%}
  Optiq Signature - material / craftsmanship. Large photo + short, confident
  copy, watch-advertisement pacing rather than a feature list. Reveal
  animation via the theme's existing data-o-reveal engine, no new JS.
{%- endcomment -%}

<section class="sig-section" id="sig-material" {{ section.shopify_attributes }}>
  <div class="sig-wrap">
    <div class="sig-split">
      <div class="sig-split__media" data-o-reveal>
        {% render 'sig-media', image: section.settings.image, label: 'Add material close-up photo' %}
      </div>
      <div class="sig-split__text">
        <span class="sig-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | default: 'Material' }}</span>
        <h2 class="sig-h2" data-o-reveal="fade">{{ section.settings.heading | default: 'Engineered from precision metal.' }}</h2>
        <p class="sig-body" data-o-reveal="fade">{{ section.settings.body | default: "A solid metal body, finished by hand and machined to a tolerance most cards never see. The NFC layer sits invisibly inside - nothing about the surface hints at the technology underneath until the moment it's tapped." }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Signature material",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Material" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Engineered from precision metal." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body copy",
      "default": "A solid metal body, finished by hand and machined to a tolerance most cards never see. The NFC layer sits invisibly inside - nothing about the surface hints at the technology underneath until the moment it's tapped."
    },
    { "type": "image_picker", "id": "image", "label": "Material close-up photo" }
  ],
  "presets": [{ "name": "Signature material" }]
}
{% endschema %}
