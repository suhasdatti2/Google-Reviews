{%- comment -%}
  Flagship product detail - Laser Engraved Signature Metal Card. The most
  premium item in the catalog, positioned a tier above the existing Optiq
  Signature metal card.

  Deliberately built on the SAME proven scaffold as sections/prem-product.liquid
  rather than a new one: the same .bset-layout / .bset-info / .bset-stage /
  .bset-panel 3-column grid (assets/optiq-buildset.css), the same .prem-pdp
  header/footer repaint (assets/prem-product.css), and the exact same
  data-prem-* attribute contract that assets/prem-product.js already knows
  how to drive - variant matching, the gallery, the quantity stepper, and
  keeping the hidden variant id correct. None of that JS is touched here;
  only the visual layer (assets/prem-flagship.css) and this markup are new.
  The purchase form itself is a standard {% form 'product' %}, so
  assets/optiq-cart.js already handles Add to Cart the same way it does on
  every other product page.

  Images: the main gallery uses the product's own Shopify media exactly like
  every other prem- product page, so uploading photos in Shopify admin (and
  assigning specific photos to specific Metal Finish variants there) is all
  that's needed to bring the gallery to life - no separate image system.
  The swatch thumbnails and the three supporting shots below the gallery are
  theme-setting image pickers, blank by default, so they're easy to find and
  fill in from the section's settings panel without touching any code.

  Digital destination: a type select paired with one value field, both real
  form fields carrying name="properties[...]" - the same line-item-property
  mechanism every personalisation field on the site already uses, so the
  customer's choice reaches the cart and the order with no new plumbing.
  This is a separate feature from the metal finish and the engraving itself:
  choosing a destination does not change what is physically engraved on the
  card, it only sets what the card's NFC tap opens.
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}
{{ 'optiq-buildset.css' | asset_url | stylesheet_tag }}
{{ 'prem-product.css' | asset_url | stylesheet_tag }}
{{ 'prem-flagship.css' | asset_url | stylesheet_tag }}
<script src="{{ 'prem-product.js' | asset_url }}" defer></script>

{%- liquid
  assign flag_product = section.settings.product
  if flag_product == blank
    assign flag_product = product
  endif
  if flag_product == blank
    assign flag_product = all_products['laser-engraved-signature-card']
  endif

  assign v = flag_product.selected_or_first_available_variant
  assign finish_option = flag_product.options_with_values.first

  assign use_product_media = false
  if flag_product.media.size > 0
    assign use_product_media = true
  endif

  assign back_url = section.settings.back_url | default: '/pages/premium-products'
  assign back_label = section.settings.back_label | default: 'Premium'
  if collection != blank
    assign back_url = collection.url
    assign back_label = collection.title
  endif
-%}

<section class="prem-pdp flag-hero" id="flag-hero-{{ section.id }}" data-prem-pdp {{ section.shopify_attributes }}>
  <div class="bset-layout">

    {%- comment -%} ---------- LEFT: what this is ---------- {%- endcomment -%}
    <div class="bset-info">
      <a class="bset-crumbs prem-pdp__back" href="{{ back_url }}">
        <span aria-hidden="true">&larr;</span> {{ back_label | escape }}
      </a>

      <div class="bset-head">
        {%- if section.settings.badge != blank -%}
          <span class="flag-badge">{{ section.settings.badge | escape }}</span>
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}
          <p class="flag-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="flag-title">{{ section.settings.heading | default: flag_product.title | escape }}</h1>
        {%- if section.settings.subheading != blank -%}
          <p class="flag-sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- CENTRE: the product ---------- {%- endcomment -%}
    <div class="bset-stage">
      <div class="bset-media prem-pdp__media" data-prem-gallery>
        {%- if use_product_media -%}
          {%- for media in flag_product.media -%}
            {%- if forloop.first -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
            {%- assign media_alt = media.alt | default: flag_product.title -%}
            <div class="bset-shot{% if forloop.first %} is-active{% endif %}" data-shot="{{ forloop.index0 }}" data-media-id="{{ media.id }}">
              {{ media.preview_image | image_url: width: 1600 | image_tag: loading: load, alt: media_alt }}
            </div>
          {%- endfor -%}
        {%- elsif section.settings.hero_image != blank -%}
          <div class="bset-shot is-active" data-shot="0">
            {{ section.settings.hero_image | image_url: width: 1600 | image_tag: loading: 'eager', alt: flag_product.title }}
          </div>
        {%- else -%}
          <div class="bset-shot is-active" data-shot="0">
            {% render 'prem-media', label: 'Hero product image' %}
          </div>
        {%- endif -%}

        {%- if flag_product.media.size > 1 -%}
          <button type="button" class="prem-pdp__arrow prem-pdp__arrow--prev" data-prem-prev aria-label="Previous image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="prem-pdp__arrow prem-pdp__arrow--next" data-prem-next aria-label="Next image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        {%- endif -%}
      </div>

      {%- if flag_product.media.size > 1 -%}
        <div class="bset-thumbs">
          {%- for media in flag_product.media -%}
            <button
              type="button"
              class="bset-thumb{% if forloop.first %} is-active{% endif %}"
              data-shot-go="{{ forloop.index0 }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Show image {{ forloop.index }}"
            >
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        Supporting shots - purely presentational, not part of the
        interactive slideshow above, so the gallery JS stays untouched.
        Each is its own blank-by-default image picker.
      {%- endcomment -%}
      <div class="flag-support">
        <div class="flag-support__shot">
          {% render 'prem-media', image: section.settings.engraving_image, label: 'Engraving close-up' %}
        </div>
        <div class="flag-support__shot">
          {% render 'prem-media', image: section.settings.tap_image, label: 'Card being tapped' %}
        </div>
        <div class="flag-support__shot">
          {% render 'prem-media', image: section.settings.lifestyle_image, label: 'Lifestyle shot' %}
        </div>
      </div>
    </div>

    {%- comment -%} ---------- RIGHT: the purchase ---------- {%- endcomment -%}
    <div class="bset-panel">

      <div class="bset-field">
        <span class="bset-total__value prem-pdp__price" data-prem-price>{{ v.price | money }}</span>
      </div>

      {%- form 'product', flag_product, class: 'bset-buy', id: 'flag-pdp-form' -%}
        <input type="hidden" name="id" value="{{ v.id }}" data-prem-variant-id>

        {%- if finish_option != blank -%}
          <div class="bset-field" data-prem-options>
            <span class="bset-label">{{ finish_option.name | escape }}</span>
            <div class="flag-swatches">
              {%- for value in finish_option.values -%}
                {%- liquid
                  assign finish_image = blank
                  case value
                    when 'Black Anodized Stainless Steel'
                      assign finish_image = section.settings.finish_black_image
                    when 'White Anodized Steel'
                      assign finish_image = section.settings.finish_white_image
                    when 'Anodized Premium Brass'
                      assign finish_image = section.settings.finish_brass_image
                    when 'Gold-Plated Stainless Steel'
                      assign finish_image = section.settings.finish_gold_image
                  endcase
                -%}
                <button
                  type="button"
                  class="flag-swatch"
                  data-prem-value="{{ value | escape }}"
                  data-prem-option-index="0"
                  aria-pressed="{% if finish_option.selected_value == value %}true{% else %}false{% endif %}"
                >
                  <span class="flag-swatch__media">{% render 'prem-media', image: finish_image, label: value %}</span>
                  <span class="flag-swatch__name">{{ value | escape }}</span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="bset-field flag-dest">
          <span class="bset-label">{{ section.settings.dest_label | default: 'What should your card connect to?' | escape }}</span>
          <select name="properties[Digital Destination]" data-flag-dest-type>
            <option value="Website">Website</option>
            <option value="Contact Information">Contact Information</option>
            <option value="Digital Business Card">Digital Business Card</option>
            <option value="LinkedIn">LinkedIn</option>
            <option value="Instagram">Instagram</option>
            <option value="Portfolio">Portfolio</option>
            <option value="Google Reviews">Google Reviews</option>
            <option value="Custom URL">Custom URL</option>
          </select>
          <input type="text" name="properties[Destination Details]" data-flag-dest-value placeholder="yourwebsite.com" autocomplete="off">
          <p class="flag-dest__hint">Tap the card with a compatible phone to open this destination instantly. We'll program it after you order.</p>
        </div>

        <div class="bset-field prem-pdp__buyrow">
          <div class="bset-qty" data-prem-qty>
            <button type="button" class="bset-qty__btn" data-prem-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
            <input class="bset-qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity" data-prem-qty-input>
            <button type="button" class="bset-qty__btn" data-prem-qty-step="1" aria-label="Increase quantity">&plus;</button>
          </div>

          <button type="submit" class="bset-add" data-prem-submit {% unless v.available %}disabled{% endunless %}>
            {%- if v.available -%}{{ section.settings.cta_label | default: 'Customize Your Card' | escape }}{%- else -%}Sold out{%- endif -%}
          </button>
        </div>

        {%- if section.settings.show_payment_button -%}
          <div class="prem-pdp__paybtn">{{ form | payment_button }}</div>
        {%- endif -%}
      {%- endform -%}

      <p class="bset-secure">
        {% render 'bset-icon', name: 'lock' %}
        <span>{{ section.settings.secure_note | default: 'Secure Checkout' | escape }}</span>
      </p>

      {%- if flag_product.description != blank -%}
        <div class="prem-pdp__acc" data-o-acc data-o-acc-single="true">
          <div class="prem-pdp__acc-item">
            <button
              type="button"
              class="prem-pdp__acc-trigger"
              data-o-acc-trigger
              aria-expanded="false"
              aria-controls="flag-acc-desc-{{ section.id }}"
            >
              Description
              <span class="prem-pdp__acc-sign" aria-hidden="true"></span>
            </button>
            <div class="prem-pdp__acc-panel" id="flag-acc-desc-{{ section.id }}">
              <div>{{ flag_product.description }}</div>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script type="application/json" data-prem-pdp-data>
  {
    "moneyFormat": {{ shop.money_format | json }},
    "buyLabel": {{ section.settings.cta_label | default: 'Customize Your Card' | json }},
    "optionNames": {{ flag_product.options | json }},
    "variants": [
      {%- for variant in flag_product.variants -%}
        {
          "id": {{ variant.id | json }},
          "price": {{ variant.price }},
          "compareAtPrice": {{ variant.compare_at_price | default: 0 }},
          "available": {{ variant.available | json }},
          "opts": {{ variant.options | json }},
          "mediaId": {{ variant.featured_media.id | default: 0 | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{%- comment -%}
  Digital destination field labelling. This is the only genuinely new
  interaction on this page - everything else above (variants, gallery,
  quantity, cart submit) is driven by the unmodified assets/prem-product.js.
  Relabels the single value field to match the chosen destination type so
  the placeholder always makes sense, and keeps the type itself in its own
  line item property (set via the select's own name attribute - no JS
  needed for that part, only for the label/placeholder swap).
{%- endcomment -%}
<script>
(function () {
  var root = document.getElementById('flag-hero-{{ section.id }}');
  if (!root) { return; }

  var type = root.querySelector('[data-flag-dest-type]');
  var value = root.querySelector('[data-flag-dest-value]');
  if (!type || !value) { return; }

  var COPY = {
    'Website': { placeholder: 'yourwebsite.com', label: 'Website URL' },
    'Contact Information': { placeholder: 'Best email or phone', label: 'Contact information' },
    'Digital Business Card': { placeholder: 'Link to your digital business card', label: 'Digital business card link' },
    'LinkedIn': { placeholder: 'linkedin.com/in/yourname', label: 'LinkedIn profile' },
    'Instagram': { placeholder: 'instagram.com/yourhandle', label: 'Instagram profile' },
    'Portfolio': { placeholder: 'Link to your portfolio', label: 'Portfolio link' },
    'Google Reviews': { placeholder: 'Your Google review link, or just your business name', label: 'Google review link' },
    'Custom URL': { placeholder: 'Paste any link', label: 'Custom URL' }
  };

  function sync() {
    var copy = COPY[type.value] || COPY['Website'];
    value.placeholder = copy.placeholder;
    value.setAttribute('aria-label', copy.label);
  }

  type.addEventListener('change', sync);
  sync();
})();
</script>

{%- comment -%}
  Product structured data, built entirely from the real Shopify product and
  variant objects - same pattern as every other product page in this theme.
  Nothing hardcoded: price comes from each variant's own `price` (raw
  cents, divided by 100 to match schema.org's plain decimal), and the image
  array is only emitted once real media exists on the product.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ flag_product.title | json }},
  "description": {{ flag_product.description | strip_html | truncate: 300 | json }},
  {%- if flag_product.images.size > 0 -%}
  "image": [
    {%- for img in flag_product.images -%}
      {{ img | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- endif -%}
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "url": {{ flag_product.url | prepend: shop.url | json }},
  "offers": [
    {%- for pv in flag_product.variants -%}
    {
      "@type": "Offer",
      "name": {{ pv.title | json }},
      {%- if pv.sku != blank -%}
      "sku": {{ pv.sku | json }},
      {%- endif -%}
      "price": {{ pv.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ shop.currency | json }},
      "availability": {% if pv.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
      "url": {{ pv.url | prepend: shop.url | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

{%- comment -%}
  BreadcrumbList - Home > Collection > Product when reached through a real
  collection, or Home > Premium > Product otherwise, matching how this page
  is actually reached (the Premium Products page, not a Shopify collection).
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    }{%- if collection != blank -%},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ collection.url | prepend: shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ flag_product.title | json }},
      "item": {{ flag_product.url | prepend: shop.url | json }}
    }
    {%- else -%},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Premium",
      "item": {{ "/pages/premium-products" | prepend: shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ flag_product.title | json }},
      "item": {{ flag_product.url | prepend: shop.url | json }}
    }
    {%- endif -%}
  ]
}
</script>

{% schema %}
{
  "name": "Flagship product hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty on the product template - it uses the current product automatically." },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Flagship" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Signature Collection" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "The Signature Metal Card" },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Real laser engraving. Premium metal. Your digital identity." },
    { "type": "text", "id": "cta_label", "label": "Buy button label", "default": "Customize Your Card" },
    { "type": "checkbox", "id": "show_payment_button", "label": "Show Shop Pay / express checkout", "default": true },
    { "type": "text", "id": "secure_note", "label": "Checkout note", "default": "Secure Checkout" },
    { "type": "text", "id": "dest_label", "label": "Digital destination question", "default": "What should your card connect to?" },

    { "type": "header", "content": "Back link" },
    { "type": "text", "id": "back_label", "label": "Label", "default": "Premium" },
    { "type": "url", "id": "back_url", "label": "Link", "info": "Defaults to the collection this product was reached from, or /pages/premium-products." },

    { "type": "header", "content": "Hero image" },
    { "type": "paragraph", "content": "Only used if the product has no photos uploaded in Shopify yet. Upload images to the product itself for a real gallery." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero product image" },

    { "type": "header", "content": "Finish swatch photos" },
    { "type": "paragraph", "content": "Small thumbnails shown inside each finish's swatch card. Optional - a plain placeholder shows until each is set." },
    { "type": "image_picker", "id": "finish_black_image", "label": "Black Anodized Stainless Steel" },
    { "type": "image_picker", "id": "finish_white_image", "label": "White Anodized Steel" },
    { "type": "image_picker", "id": "finish_brass_image", "label": "Anodized Premium Brass" },
    { "type": "image_picker", "id": "finish_gold_image", "label": "Gold-Plated Stainless Steel" },

    { "type": "header", "content": "Supporting photography" },
    { "type": "image_picker", "id": "engraving_image", "label": "Close-up laser engraving" },
    { "type": "image_picker", "id": "tap_image", "label": "Card being tapped / used" },
    { "type": "image_picker", "id": "lifestyle_image", "label": "Lifestyle / executive shot" }
  ]
}
{% endschema %}
