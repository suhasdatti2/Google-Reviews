<footer class="o-footer" {{ section.shopify_attributes }}>
  <div class="o-wrap">
    <div class="o-footer__grid">

      <div class="o-footer__brand">
        <a class="o-logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: height: 100 }}"
                 alt="{{ shop.name | escape }}" width="120" height="30"
                 style="max-height:30px" loading="lazy">
          {%- else -%}
            Opt<span class="o-logo__mark">i</span>q
          {%- endif -%}
        </a>
        {%- if section.settings.blurb != blank -%}
          <p class="o-body o-sm">{{ section.settings.blurb | escape }}</p>
        {%- endif -%}

        {%- assign has_social = false -%}
        {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_facebook != blank -%}
          {%- assign has_social = true -%}
        {%- endif -%}
        {%- if section.settings.show_social and has_social -%}
          <div class="o-social">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3.8" stroke="currentColor" stroke-width="1.5"/><circle cx="17" cy="7" r="1.1" fill="currentColor"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="noopener" target="_blank">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13.5 3v11.4a3.1 3.1 0 1 1-2.6-3.05" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M13.5 3.2c.5 2.2 2.2 3.7 4.4 3.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="noopener" target="_blank">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 8.5h2.2V5.6h-2.4c-2.2 0-3.6 1.4-3.6 3.6v1.7H8.4v2.9h2.3V21h3v-7.2h2.3l.4-2.9h-2.7V9.6c0-.7.3-1.1.8-1.1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' and block.settings.menu != blank -%}
            <div class="o-footer__col" {{ block.shopify_attributes }}>
              <h2>{{ block.settings.title | escape }}</h2>
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- elsif block.type == 'contact' -%}
            <div class="o-footer__col" {{ block.shopify_attributes }}>
              <h2>{{ block.settings.title | escape }}</h2>
              <ul>
                {%- if block.settings.email != blank -%}
                  <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                {%- endif -%}
                {%- if block.settings.note != blank -%}
                  <li><span class="o-muted o-sm">{{ block.settings.note | escape }}</span></li>
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}
          Default columns for when no blocks have been added in the theme
          editor yet, so the footer never renders as a single lonely brand
          column with empty space beside it. Real, existing pages and the
          shop's own contact email - nothing invented. Add "Menu column" /
          "Contact column" blocks in the editor to override this.
        {%- endcomment -%}
        <div class="o-footer__col">
          <h2>Explore</h2>
          <ul>
            <li><a href="/pages/google-review-cards">Google Review Cards</a></li>
            <li><a href="/pages/ai-receptionist">AI Receptionist</a></li>
            <li><a href="/pages/other-services">Other Services</a></li>
          </ul>
        </div>
        <div class="o-footer__col">
          <h2>Support</h2>
          <ul>
            {%- if settings.contact_email != blank -%}
              <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
            {%- endif -%}
            <li><span class="o-muted o-sm">We reply within one business day.</span></li>
          </ul>
        </div>
      {%- endif -%}

    </div>

    <div class="o-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</span>
      <div class="o-footer__legal">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.disclaimer != blank -%}
        <span>{{ section.settings.disclaimer | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Short description",
      "default": "Cards that connect your customers to your business with a single tap."
    },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true, "info": "Links are set in Theme settings." },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Google is a trademark of Google LLC. Optiq is not affiliated with Google."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Support" },
        { "type": "text", "id": "email", "label": "Email", "default": "sales@optiqservice.com" },
        { "type": "text", "id": "note", "label": "Note", "default": "We reply within one business day." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu" },
        { "type": "contact" }
      ]
    }
  ]
}
{% endschema %}
