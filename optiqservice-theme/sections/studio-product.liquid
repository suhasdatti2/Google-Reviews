{%- comment -%}
  Studio product detail.

  Three columns: what it is (left), the product itself (centre), and the
  purchase (right). On narrow screens the title lifts out of the left column
  to the top of the page and the explanatory copy drops below the fold, so
  the buying path stays first without the page losing its opening statement.

  Commerce is real Shopify throughout. The purchase surface is a standard
  {% form 'product' %}, which means:
    - assets/optiq-cart.js already intercepts the submit, adds via
      /cart/add.js, repaints the drawer through the Section Rendering API and
      updates the header count. No cart code is added here.
    - line item properties (business name / review link / contact) are carried
      through by that same handler, so personalisation survives to the order.
    - {{ form | payment_button }} is Shopify's own accelerated checkout, not a
      styled link, so Shop Pay and wallets work.
  Prices, availability and compare-at all come from the variant objects. None
  of it is retyped into theme settings where it could drift from Shopify.

  Gallery source, in order: the product's own media (all of it, so a merchant
  simply uploading more images to the product gets a real gallery), then the
  per-handle theme image below as a fallback for products that have no media
  attached yet, then a labelled empty slot.
{%- endcomment -%}

{%- liquid
  assign v = product.selected_or_first_available_variant

  comment
    Fallback art for products that carry no media in Shopify yet - the
    wristband and Signature are currently in that state, so without this
    their pages would render an empty frame.
  endcomment
  assign fallback_image = blank
  case product.handle
    when 'bulk-restaurant-pack'
      assign fallback_image = section.settings.bulk_restaurant_pack_product_image
    when 'bulk-review-cards'
      assign fallback_image = section.settings.bulk_square_handout_cards_product_image
    when 'google-review-nfc-card'
      assign fallback_image = section.settings.main_counter_card_product_image
    when 'review-growth-plan'
      assign fallback_image = section.settings.review_growth_plan_product_image
    when 'google-review-nfc-wristband'
      assign fallback_image = section.settings.wristband_product_image
  endcase

  assign use_product_media = false
  if product.media.size > 0
    assign use_product_media = true
  endif

  comment
    What the personalisation heading calls the item, so a wristband buyer is
    not asked to personalise a "card". One line per new product shape.
  endcomment
  assign noun = 'card'
  if product.handle contains 'wristband'
    assign noun = 'wristband'
  endif

  assign back_url = '/#collection'
  assign back_label = 'Back'
  if collection != blank
    assign back_url = collection.url
    assign back_label = collection.title
  endif

  assign benefits = section.blocks | where: 'type', 'benefit'
  assign panels = section.blocks | where: 'type', 'accordion'

-%}

<section class="stu-page stu-pdp" {{ section.shopify_attributes }}>
  <div class="stu-wrap">

    <a class="stu-back" href="{{ back_url }}">
      <span aria-hidden="true">&#8592;</span> {{ back_label | escape }}
    </a>

    <div class="stu-pdp__grid">

      {%- comment -%}
        The title is a grid child in its own right rather than living inside
        the left column, so the layout can move it to the top of the page on
        narrow screens (where the left column drops below the fold) using
        grid-template-areas alone - one <h1> in the document, placed three
        different ways, instead of a second copy hidden per breakpoint.
      {%- endcomment -%}
      <h1 class="stu-h1 stu-pdp__title">{{ product.title | escape }}</h1>

      {%- comment -%} ---------- LEFT: what this is ---------- {%- endcomment -%}
      <div class="stu-pdp__intro">
        {%- if section.settings.tagline != blank -%}
          <p class="stu-body">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}

        {%- if benefits.size > 0 -%}
          <ul class="stu-features">
            {%- for block in benefits -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <strong>{{ block.settings.title | escape }}</strong>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span>{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- CENTRE: the product ---------- {%- endcomment -%}
      <div class="stu-gallery" data-stu-gallery>
        <div class="stu-gallery__stage">
          <div class="stu-gallery__viewport" data-stu-viewport>
            {%- if use_product_media -%}
              {%- for media in product.media -%}
                {%- comment -%}
                  Both precomputed: a `| default:` chained inside an image_tag
                  argument list would apply to image_tag's own output, not to
                  the argument, and silently leave the alt empty.
                {%- endcomment -%}
                {%- if forloop.first -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
                {%- assign media_alt = media.alt | default: product.title -%}
                <div class="stu-gallery__slide{% if forloop.first %} is-active{% endif %}" data-stu-slide data-media-id="{{ media.id }}">
                  {{ media.preview_image
                     | image_url: width: 1600
                     | image_tag:
                         loading: load,
                         sizes: '(max-width: 820px) 92vw, 46vw',
                         widths: '500, 800, 1100, 1400, 1600',
                         alt: media_alt }}
                </div>
              {%- endfor -%}
            {%- elsif fallback_image != blank -%}
              <div class="stu-gallery__slide is-active" data-stu-slide>
                {{ fallback_image
                   | image_url: width: 1600
                   | image_tag:
                       loading: 'eager',
                       sizes: '(max-width: 820px) 92vw, 46vw',
                       widths: '500, 800, 1100, 1400, 1600',
                       alt: product.title }}
              </div>
            {%- else -%}
              <div class="stu-gallery__slide is-active" data-stu-slide>
                {% render 'stu-slot', label: 'Add product images in Shopify to build the gallery' %}
              </div>
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
            <button type="button" class="stu-gallery__arrow stu-gallery__arrow--prev" data-stu-prev aria-label="Previous image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="stu-gallery__arrow stu-gallery__arrow--next" data-stu-next aria-label="Next image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </button>
            <span class="stu-gallery__count" data-stu-count>1 / {{ product.media.size }}</span>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="stu-gallery__thumbs">
            {%- for media in product.media -%}
              <button
                type="button"
                class="stu-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-stu-thumb
                data-index="{{ forloop.index0 }}"
                aria-label="Show image {{ forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- RIGHT: the purchase ---------- {%- endcomment -%}
      <div class="stu-buy">

        <div class="stu-price">
          <span data-stu-price>{{ v.price | money }}</span>
          {%- if v.compare_at_price > v.price -%}
            <span class="stu-price__was" data-stu-compare>{{ v.compare_at_price | money }}</span>
          {%- else -%}
            <span class="stu-price__was" data-stu-compare hidden></span>
          {%- endif -%}
        </div>

        {%- comment -%}
          No novalidate: the browser's own required-field check has to run
          before submit, otherwise an order arrives with no review link and
          there is nothing to programme the chip with.
        {%- endcomment -%}
        {%- form 'product', product, class: 'stu-form' -%}
          <input type="hidden" name="id" value="{{ v.id }}" data-stu-id>

          {%- unless product.has_only_default_variant -%}
            <div class="stu-opts" data-stu-options>
              {%- for option in product.options_with_values -%}
                {%- assign lowered = option.name | downcase -%}
                {%- assign is_colour = false -%}
                {%- if lowered contains 'colour' or lowered contains 'color' or lowered contains 'finish' -%}
                  {%- assign is_colour = true -%}
                {%- endif -%}

                <div class="stu-opt">
                  <div class="stu-opt__label">
                    <span id="stu-opt-{{ forloop.index0 }}">{{ option.name | escape }}</span>
                    <span class="stu-opt__value" data-stu-chosen="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span>
                  </div>

                  <div class="stu-opt__row" role="group" aria-labelledby="stu-opt-{{ forloop.index0 }}">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign val_key = value | downcase
                        assign dot = ''
                        if is_colour
                          case val_key
                            when 'black'
                              assign dot = 'linear-gradient(135deg,#3a3a38,#111110)'
                            when 'white'
                              assign dot = 'linear-gradient(135deg,#fbfaf8,#e7e5df)'
                            when 'titanium gray'
                              assign dot = 'linear-gradient(135deg,#a6a6a0,#77766e)'
                            when 'matte black metal'
                              assign dot = 'linear-gradient(135deg,#2c2c2a,#121211)'
                            when 'brushed silver'
                              assign dot = 'linear-gradient(135deg,#ececea,#c9c8c2)'
                          endcase
                        endif
                      -%}
                      <button
                        type="button"
                        class="stu-chip{% if option.selected_value == value %} is-active{% endif %}"
                        data-stu-chip
                        data-index="{{ forloop.parentloop.index0 }}"
                        data-value="{{ value | escape }}"
                        aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                      >
                        {%- if dot != '' -%}<i style="background:{{ dot }}" aria-hidden="true"></i>{%- endif -%}
                        {{ value | escape }}
                      </button>
                    {%- endfor -%}
                  </div>

                  {%- if lowered contains 'qr' and section.settings.qr_note != blank -%}
                    <p class="stu-note">{{ section.settings.qr_note | escape }}</p>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- if section.settings.show_personalise -%}
            <div class="stu-personalise">
              <span class="stu-personalise__head">Personalise your {{ noun }}</span>

              <div class="stu-field">
                <label for="stu-business">Business name</label>
                <input id="stu-business" type="text" name="properties[Business name]" required placeholder="e.g. Fresh Fades Barbershop">
              </div>

              {%- comment -%}
                Deliberately type="text", not type="url": most customers do not
                know their raw Google review link and will paste their website,
                their Maps listing, or just their business name - all of which
                we can work from. URL validation rejects every one of those and
                would block checkout on a field we are happy to resolve after
                the order is placed.
              {%- endcomment -%}
              <div class="stu-field">
                <label for="stu-link">Google review link</label>
                <input id="stu-link" type="text" name="properties[Google review link]" required placeholder="Review link, website, or business name" autocomplete="off" spellcheck="false">
                <p class="stu-hint">Anything works - your review link, your website, or just your business name and city. We will track down the exact link before we programme your {{ noun }}.</p>
              </div>

              <div class="stu-field">
                <label for="stu-contact">Best email or phone</label>
                <input id="stu-contact" type="text" name="properties[Contact email or phone]" required placeholder="you@business.com">
              </div>
            </div>
          {%- endif -%}

          <div class="stu-buyrow">
            <div class="stu-qty">
              <button type="button" data-stu-qty="-1" aria-label="Decrease quantity">&minus;</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
              <button type="button" data-stu-qty="1" aria-label="Increase quantity">&plus;</button>
            </div>

            <button type="submit" class="stu-btn stu-btn--solid" data-stu-submit {% unless v.available %}disabled{% endunless %}>
              {%- if v.available -%}{{ section.settings.buy_label | default: 'Add to Cart' | escape }}{%- else -%}Sold out{%- endif -%}
            </button>
          </div>

          {%- if section.settings.show_payment_button -%}
            {{ form | payment_button }}
          {%- endif -%}
        {%- endform -%}

        {%- if panels.size > 0 or section.settings.show_description -%}
          <div class="stu-acc" data-o-acc data-o-acc-single="true">
            {%- if section.settings.show_description and product.description != blank -%}
              <div class="stu-acc__item">
                <button
                  type="button"
                  class="stu-acc__trigger"
                  data-o-acc-trigger
                  aria-expanded="false"
                  aria-controls="stu-acc-desc"
                >
                  Description
                  <span class="stu-acc__sign" aria-hidden="true"></span>
                </button>
                <div class="stu-acc__panel" id="stu-acc-desc">
                  <div>{{ product.description }}</div>
                </div>
              </div>
            {%- endif -%}

            {%- for block in panels -%}
              <div class="stu-acc__item" {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="stu-acc__trigger"
                  data-o-acc-trigger
                  aria-expanded="false"
                  aria-controls="stu-acc-{{ block.id }}"
                >
                  {{ block.settings.heading | default: 'Details' | escape }}
                  <span class="stu-acc__sign" aria-hidden="true"></span>
                </button>
                <div class="stu-acc__panel" id="stu-acc-{{ block.id }}">
                  <div>{{ block.settings.content }}</div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

<script>
(function () {
  /* The script tag is a sibling of the section, not a descendant, so it
     scopes by query rather than by walking up from itself. */
  var root = document.querySelector('.stu-pdp');
  if (!root) { return; }

  /* ---------- Gallery ---------- */
  (function () {
    var gallery = root.querySelector('[data-stu-gallery]');
    if (!gallery) { return; }

    var slides = [].slice.call(gallery.querySelectorAll('[data-stu-slide]'));
    var thumbs = [].slice.call(gallery.querySelectorAll('[data-stu-thumb]'));
    var counter = gallery.querySelector('[data-stu-count]');
    var index = 0;

    function show(i) {
      if (!slides.length) { return; }
      if (i < 0) { i = slides.length - 1; }
      if (i >= slides.length) { i = 0; }
      slides.forEach(function (s, n) { s.classList.toggle('is-active', n === i); });
      thumbs.forEach(function (t, n) { t.classList.toggle('is-active', n === i); });
      if (counter) { counter.textContent = (i + 1) + ' / ' + slides.length; }
      index = i;
    }

    var prev = gallery.querySelector('[data-stu-prev]');
    var next = gallery.querySelector('[data-stu-next]');
    if (prev) { prev.addEventListener('click', function () { show(index - 1); }); }
    if (next) { next.addEventListener('click', function () { show(index + 1); }); }

    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { show(parseInt(t.getAttribute('data-index'), 10) || 0); });
    });

    /* Horizontal swipe. Compares against vertical travel so a normal
       page scroll started on the image is never stolen as a swipe. */
    var startX = null, startY = null;
    var viewport = gallery.querySelector('[data-stu-viewport]');
    if (viewport) {
      viewport.addEventListener('touchstart', function (e) {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
      }, { passive: true });
      viewport.addEventListener('touchend', function (e) {
        if (startX === null) { return; }
        var dx = e.changedTouches[0].clientX - startX;
        var dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(dy)) { show(dx < 0 ? index + 1 : index - 1); }
        startX = null;
      }, { passive: true });
    }

    /* Exposed so the variant picker below can pull the gallery to the
       image attached to the newly selected variant. */
    gallery.__showMedia = function (id) {
      for (var i = 0; i < slides.length; i++) {
        if (slides[i].getAttribute('data-media-id') === String(id)) { show(i); return; }
      }
    };
  })();

  /* ---------- Quantity ---------- */
  (function () {
    var input = root.querySelector('[name="quantity"]');
    if (!input) { return; }
    root.querySelectorAll('[data-stu-qty]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var next = (parseInt(input.value, 10) || 1) + parseInt(btn.getAttribute('data-stu-qty'), 10);
        input.value = next < 1 ? 1 : next;
      });
    });
  })();

  /* ---------- Variants ----------
     Option-array matching rather than a flat variant list, so the picker
     works unchanged for Colour/Pack/QR, Colour/Size/QR, Bundle, and
     Finish/Quantity without knowing any of those names in advance. */
  (function () {
    var wrap = root.querySelector('[data-stu-options]');
    var idField = root.querySelector('[data-stu-id]');
    if (!idField) { return; }

    /* Prices are pre-formatted by Liquid's money filter rather than
       reassembled in JS. Shopify already knows the shop's currency format,
       and formatting it a second time in the browser is how the price here
       ends up disagreeing with the price in the server-rendered cart. */
    var VARIANTS = [
      {%- for variant in product.variants -%}
        {
          id: {{ variant.id | json }},
          priceText: {{ variant.price | money | json }},
          compareText: {{ variant.compare_at_price | money | json }},
          onSale: {{ variant.compare_at_price | default: 0 | minus: variant.price | at_least: 0 | json }},
          available: {{ variant.available | json }},
          options: {{ variant.options | json }},
          media: {{ variant.featured_media.id | default: 0 | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ];
    var NAMES = {{ product.options | json }};
    var BUY = {{ section.settings.buy_label | default: 'Add to Cart' | json }};

    var priceEl = root.querySelector('[data-stu-price]');
    var compareEl = root.querySelector('[data-stu-compare]');
    var submit = root.querySelector('[data-stu-submit]');
    var gallery = root.querySelector('[data-stu-gallery]');
    var chips = wrap ? [].slice.call(wrap.querySelectorAll('[data-stu-chip]')) : [];

    var chosen = NAMES.map(function (_, i) {
      var active = wrap && wrap.querySelector('[data-stu-chip][data-index="' + i + '"].is-active');
      return active ? active.getAttribute('data-value') : (VARIANTS[0] ? VARIANTS[0].options[i] : null);
    });

    function matches(variant, choice) {
      for (var i = 0; i < choice.length; i++) {
        if (choice[i] !== null && variant.options[i] !== choice[i]) { return false; }
      }
      return true;
    }

    function find(choice) {
      for (var i = 0; i < VARIANTS.length; i++) {
        if (matches(VARIANTS[i], choice)) { return VARIANTS[i]; }
      }
      return null;
    }

    /* The variant you would land on by flipping one option and keeping the
       rest - used to grey out combinations that do not exist. */
    function ifSwapped(index, value) {
      var probe = chosen.slice();
      probe[index] = value;
      return find(probe);
    }

    function render(changedIndex) {
      var current = find(chosen);

      chips.forEach(function (chip) {
        var i = parseInt(chip.getAttribute('data-index'), 10);
        var value = chip.getAttribute('data-value');
        var active = chosen[i] === value;
        var candidate = ifSwapped(i, value);

        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', active ? 'true' : 'false');
        chip.disabled = !(candidate && candidate.available);
      });

      NAMES.forEach(function (_, i) {
        var label = root.querySelector('[data-stu-chosen="' + i + '"]');
        if (label) { label.textContent = chosen[i] || ''; }
      });

      if (!current) {
        if (submit) { submit.disabled = true; submit.textContent = 'Unavailable'; }
        return;
      }

      idField.value = current.id;
      if (priceEl) { priceEl.textContent = current.priceText; }

      if (compareEl) {
        var hasCompare = current.onSale > 0;
        compareEl.textContent = hasCompare ? current.compareText : '';
        compareEl.hidden = !hasCompare;
      }

      if (submit) {
        submit.disabled = !current.available;
        submit.textContent = current.available ? BUY : 'Sold out';
      }

      if (gallery && gallery.__showMedia && current.media) { gallery.__showMedia(current.media); }

      /* Keeps the address bar shareable and the back button meaningful
         without reloading the page. */
      if (changedIndex !== undefined && window.history && window.history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', current.id);
        window.history.replaceState({}, '', url);
      }
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        if (chip.disabled) { return; }
        var i = parseInt(chip.getAttribute('data-index'), 10);
        chosen[i] = chip.getAttribute('data-value');
        render(i);
      });
    });

    /* ?qr=1 arrives from the older homepage configurator links - preselect
       the QR option rather than silently ignoring the intent. */
    if (new URLSearchParams(window.location.search).get('qr') === '1') {
      NAMES.forEach(function (name, i) {
        if (!/qr/i.test(String(name))) { return; }
        chips.forEach(function (chip) {
          if (parseInt(chip.getAttribute('data-index'), 10) !== i) { return; }
          if (/with|yes/i.test(chip.getAttribute('data-value'))) { chosen[i] = chip.getAttribute('data-value'); }
        });
      });
    }

    render();
  })();
})();
</script>

{% schema %}
{
  "name": "Studio product",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Short line under the title" },
    { "type": "text", "id": "buy_label", "label": "Buy button label", "default": "Add to Cart" },
    { "type": "checkbox", "id": "show_payment_button", "label": "Show Shop Pay / express checkout", "default": true },

    { "type": "header", "content": "Personalisation" },
    {
      "type": "checkbox",
      "id": "show_personalise",
      "label": "Ask for business name and review link",
      "default": true,
      "info": "Turn off for products that are not programmed, such as a membership."
    },
    { "type": "text", "id": "qr_note", "label": "QR helper note", "default": "Optional backup for phones that cannot tap." },

    { "type": "header", "content": "Accordions" },
    { "type": "checkbox", "id": "show_description", "label": "Show the Shopify product description", "default": true },

    { "type": "header", "content": "Fallback images" },
    {
      "type": "paragraph",
      "content": "Only used for products that have no media attached in Shopify. Upload images to the product itself to get a multi-image gallery."
    },
    { "type": "image_picker", "id": "main_counter_card_product_image", "label": "Main Counter Card" },
    { "type": "image_picker", "id": "bulk_square_handout_cards_product_image", "label": "Bulk Square Handout Cards" },
    { "type": "image_picker", "id": "bulk_restaurant_pack_product_image", "label": "Bulk Restaurant Pack" },
    { "type": "image_picker", "id": "wristband_product_image", "label": "Wristband" },
    { "type": "image_picker", "id": "review_growth_plan_product_image", "label": "Review Growth Plan" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Bullet",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ]
}
