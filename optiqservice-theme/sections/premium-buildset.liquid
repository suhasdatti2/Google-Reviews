{%- comment -%}
  BUILD YOUR SET — the purchase experience behind the CTA of the same name.

  Three columns, matching the supplied wireframe: identity left, photography
  centre, purchase panel right. One panel serves any number of products (see
  the "mode" setting); switching between them swaps the identity, the
  gallery and the option set, so one product's controls never appear under
  another. Three concrete products are supported - Ring, Metal Card (the
  laser-engraved flagship) and PVC Card (the classic Optiq Signature) -
  shown solo, as the original Ring+Card pair ("both"), or all three at once
  ("bundle") for a shopper who wants to switch between and add any
  combination to cart.

  Everything on this page is driven by REAL product data. Every product is
  looked up by handle through all_products, so its options, option values,
  variants, prices and availability all come from Shopify — nothing about the
  catalogue is hard-coded here. Add a size in the admin and it appears; sell
  out of one and its chip strikes through.

  Purchasing reuses the theme's existing cart rather than introducing a second
  one: this is a genuine <form action="/cart/add"> whose submit is picked up by
  assets/optiq-cart.js (AJAX add, drawer repaint via the Section Rendering API,
  optiq:cart:updated event). assets/optiq-buildset.js only validates the
  selection first. With JS off the form still posts and Shopify still adds the
  pre-selected variant.

  The bundle saving is a real Shopify automatic discount (Buy Ring → Metal Card
  discounted) covering exactly those two products, so it lands in the cart and
  at checkout on its own. The setting below is the DISPLAY figure only; it is
  stated as such in the schema so the two cannot silently disagree. It only
  ever shows in two-product modes - a three-way "bundle" has no matching real
  discount to quote, so that box stays off and the switcher does the work.
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}
{{ 'optiq-buildset.css' | asset_url | stylesheet_tag }}
<script src="{{ 'optiq-buildset.js' | asset_url }}" defer></script>

{%- liquid
  assign ring = all_products[section.settings.ring_handle]
  assign card = all_products[section.settings.card_handle]
  assign pvc = all_products[section.settings.pvc_handle]

  assign features = section.blocks | where: 'type', 'feature'
  assign swatches = section.blocks | where: 'type', 'swatch'

  assign mode = section.settings.mode | default: 'both'
  case mode
    when 'card'
      assign slots = 'card' | split: ','
    when 'ring'
      assign slots = 'ring' | split: ','
    when 'pvc'
      assign slots = 'pvc' | split: ','
    when 'bundle'
      assign slots = 'ring,card,pvc' | split: ','
    else
      assign slots = 'ring,card' | split: ','
  endcase

  assign bundle_cents = section.settings.bundle_discount | times: 100 | round

  case slots.first
    when 'ring'
      assign first_product = ring
    when 'pvc'
      assign first_product = pvc
    else
      assign first_product = card
  endcase
-%}

<div class="prem-page" data-bset-root>
  {% render 'prem-nav',
     wordmark: section.settings.wordmark,
     wordmark_sub: section.settings.wordmark_sub,
     ring_url: section.settings.nav_ring_url,
     cards_url: section.settings.nav_cards_url %}

  <section class="bset" {{ section.shopify_attributes }}>
    <div class="bset-layout">

      {%- comment -%} ---------- LEFT: identity ---------- {%- endcomment -%}
      <div class="bset-info" id="bset-info-{{ section.id }}">
        <nav class="bset-crumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">/</span>
          <a href="{{ section.settings.parent_url | default: '/pages/premium-products' }}">{{ section.settings.parent_label | default: 'Build Your Set' | escape }}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page" data-bset-crumb>Product</span>
        </nav>

        {%- for slot in slots -%}
          {%- liquid
            case slot
              when 'ring'
                assign p = ring
                assign slot_desc = section.settings.ring_desc
                assign slot_name = section.settings.ring_label | default: 'Ring'
              when 'pvc'
                assign p = pvc
                assign slot_desc = section.settings.pvc_desc
                assign slot_name = section.settings.pvc_label | default: 'PVC Card'
              else
                assign p = card
                assign slot_desc = section.settings.card_desc
                assign slot_name = section.settings.card_label | default: 'Metal Card'
            endcase
          -%}

          <div class="bset-head" data-bset-for="{{ slot }}"{% unless forloop.first %} hidden{% endunless %}>
            <h1 class="bset-title">
              {%- if p != blank -%}{{ p.title }}{%- else -%}{{ slot_name | escape }}{%- endif -%}
            </h1>
            <div class="bset-desc" data-bset-desc="{{ slot }}">
              {%- if slot == 'card' -%}
                {%- comment -%}
                  The Metal Card's Chip Size changes what the back of the
                  card can carry (a small 1/3-size chip leaves room to
                  engrave the back too; a full-size chip covers it), so the
                  two sizes get their own short bullet copy instead of one
                  essay-style description. assets/optiq-buildset.js swaps
                  which list is visible from the same Chip Size selection
                  that already drives the photo swap.
                {%- endcomment -%}
                <ul class="bset-desc-list" data-desc-variant data-desc-value2="1/3 Size">
                  <li><strong>Real Anodized Stainless Steel</strong> — premium metal construction with a durable engraved finish</li>
                  <li><strong>Premium Anodized Stainless Steel</strong> — premium metal construction with a durable engraved finish</li>
                  <li><strong>Unlimited Taps</strong> — tap your card as many times as you want, with no ongoing fees</li>
                  <li><strong>One-Time Fee</strong> — pay once, use it indefinitely</li>
                  <li><strong>Fully Custom Design</strong> — customize the front &amp; back with your own branding, name, contact info, and layout</li>
                  <li><strong>QR Code Included</strong> — every card comes with a scannable QR code as a backup to NFC</li>
                  <li><strong>Digital Destination</strong> — send contacts to your website, digital business card, socials, contact info, reviews, or any link you choose</li>
                  <li><strong>Laser Engraved</strong> — precision engraving directly into the metal for a premium finish</li>
                  <li><strong>Built for Your Brand</strong> — no generic templates; your card is designed around your business</li>
                </ul>
                <ul class="bset-desc-list" data-desc-variant data-desc-value2="Full Size" hidden>
                  <li><strong>Premium Anodized Stainless Steel</strong> — premium metal construction with a durable engraved finish</li>
                  <li><strong>Unlimited Taps</strong> — tap your card as many times as you want, with no ongoing fees</li>
                  <li><strong>One-Time Fee</strong> — pay once, use it indefinitely</li>
                  <li><strong>Front Custom Design</strong> — customize the front with your own branding, name, contact info, and layout</li>
                  <li><strong>QR Code Included</strong> — every card comes with a scannable QR code as a backup to NFC</li>
                  <li><strong>Digital Destination</strong> — send contacts to your website, digital business card, socials, contact info, reviews, or any link you choose</li>
                  <li><strong>Laser Engraved</strong> — precision engraving directly into the metal for a premium finish</li>
                  <li><strong>Built for Your Brand</strong> — no generic templates; your card is designed around your business</li>
                  <li><strong>4 Different Steel Options</strong></li>
                </ul>
              {%- elsif slot_desc != blank -%}
                {{ slot_desc }}
              {%- elsif p != blank -%}
                {{ p.description }}
              {%- endif -%}
            </div>
          </div>

          <p class="bset-price-lead" data-bset-for="{{ slot }}"{% unless forloop.first %} hidden{% endunless %}>
            {%- if p != blank -%}
              {%- if p.price_min != p.price_max -%}<small>From</small>{%- endif -%}
              {{ p.price_min | money }}
            {%- else -%}
              <small>Coming soon</small>&mdash;
            {%- endif -%}
          </p>

          {%- comment -%}
            `where` filters block properties, not block settings, so the
            product a feature belongs to has to be matched by hand.
          {%- endcomment -%}
          {%- assign has_feature = false -%}
          {%- for b in features -%}
            {%- if b.settings.product == slot -%}{%- assign has_feature = true -%}{%- endif -%}
          {%- endfor -%}

          {%- if has_feature -%}
            <ul class="bset-features" data-bset-for="{{ slot }}"{% unless forloop.first %} hidden{% endunless %}>
              {%- for b in features -%}
                {%- if b.settings.product == slot -%}
                  <li class="bset-feature" {{ b.shopify_attributes }}>
                    <span class="bset-feature__icon">{% render 'bset-icon', name: b.settings.icon %}</span>
                    <span>
                      <span class="bset-feature__title">{{ b.settings.title | escape }}</span>
                      <span class="bset-feature__body">{{ b.settings.body | escape }}</span>
                    </span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} ---------- CENTRE: photography ---------- {%- endcomment -%}
      <div class="bset-stage">
        {%- for slot in slots -%}
          {%- liquid
            case slot
              when 'ring'
                assign p = ring
                assign slot_name = section.settings.ring_label | default: 'Ring'
                assign slot_image = section.settings.ring_image
                assign extra1_image = section.settings.ring_image_bp_black
                assign extra1_value = 'Black'
                assign extra1_value2 = 'Business Professional'
                assign extra2_image = section.settings.ring_image_classic_black
                assign extra2_value = 'Black'
                assign extra2_value2 = 'Classic'
                assign extra3_image = section.settings.ring_image_classic_white
                assign extra3_value = 'White'
                assign extra3_value2 = 'Classic'
              when 'pvc'
                assign p = pvc
                assign slot_name = section.settings.pvc_label | default: 'PVC Card'
                assign slot_image = section.settings.pvc_image
                assign extra1_image = section.settings.pvc_image_gold
                assign extra1_value = 'Gold'
                assign extra1_value2 = blank
                assign extra2_image = section.settings.pvc_image_matte_black
                assign extra2_value = 'Matte Black'
                assign extra2_value2 = blank
                assign extra3_image = section.settings.pvc_image_brushed_silver
                assign extra3_value = 'Brushed Silver'
                assign extra3_value2 = blank
              else
                assign p = card
                assign slot_name = section.settings.card_label | default: 'Metal Card'
                assign slot_image = section.settings.card_image
                comment
                  The Metal Card's per-value photos (both Finish and Chip
                  Size) come from "Colour option" blocks below instead of
                  named fields here, since there are up to six of them (4
                  finishes + 2 chip sizes) - one clearly labelled block each,
                  editable straight from the block list in the sidebar.
                endcomment
                assign extra1_image = blank
                assign extra1_value = blank
                assign extra1_value2 = blank
                assign extra2_image = blank
                assign extra2_value = blank
                assign extra2_value2 = blank
                assign extra3_image = blank
                assign extra3_value = blank
                assign extra3_value2 = blank
            endcase
          -%}
          {% render 'bset-gallery',
             product: p,
             slot: slot,
             swatches: swatches,
             label: slot_name,
             is_active: forloop.first,
             main_image: slot_image,
             extra1_image: extra1_image, extra1_value: extra1_value, extra1_value2: extra1_value2,
             extra2_image: extra2_image, extra2_value: extra2_value, extra2_value2: extra2_value2,
             extra3_image: extra3_image, extra3_value: extra3_value, extra3_value2: extra3_value2 %}
        {%- endfor -%}
      </div>

      {%- comment -%} ---------- RIGHT: purchase panel ---------- {%- endcomment -%}
      <div class="bset-panel">

        {%- if slots.size > 1 -%}
          <div class="bset-field bset-switchwrap">
            <span class="bset-label" id="bset-switch-{{ section.id }}">Product</span>
            <div class="bset-switch" role="group" aria-labelledby="bset-switch-{{ section.id }}">
              {%- for slot in slots -%}
                {%- liquid
                  case slot
                    when 'ring'
                      assign slot_name = section.settings.ring_label | default: 'Ring'
                    when 'pvc'
                      assign slot_name = section.settings.pvc_label | default: 'PVC Card'
                    else
                      assign slot_name = section.settings.card_label | default: 'Metal Card'
                  endcase
                -%}
                <button type="button"
                        class="bset-switch__btn"
                        data-bset-switch="{{ slot }}"
                        aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ slot_name | escape }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="bset-field bset-qtywrap">
          <label class="bset-label" for="bset-qty-{{ section.id }}">Quantity</label>
          <div class="bset-qty" data-bset-qty>
            <button type="button" class="bset-qty__btn" data-bset-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
            <input class="bset-qty__input"
                   id="bset-qty-{{ section.id }}"
                   type="number"
                   name="quantity"
                   form="bset-form-{{ section.id }}"
                   value="1"
                   min="1"
                   max="99"
                   step="1"
                   inputmode="numeric"
                   data-bset-qty-input>
            <button type="button" class="bset-qty__btn" data-bset-qty-step="1" aria-label="Increase quantity">&plus;</button>
          </div>
        </div>

        {%- for slot in slots -%}
          {%- liquid
            case slot
              when 'ring'
                assign p = ring
              when 'pvc'
                assign p = pvc
              else
                assign p = card
            endcase
          -%}

          <div class="bset-field bset-options" data-bset-for="{{ slot }}"{% unless forloop.first %} hidden{% endunless %}>
            {%- if p != blank -%}
              {%- for option in p.options_with_values -%}
                {%- assign oi = forloop.index0 -%}
                {%- comment -%}
                  The Metal Card's second option is named "Card Chip/NFC" in
                  Shopify - no " / " (Shopify rejects that sequence in an
                  option name) and no "Size" (assets/optiq-buildset.js treats
                  any option whose NAME matches /size/i as a real size the
                  shopper must pick with no default, same as the Ring's Size
                  option - this one should default-select and behave like
                  Metal Finish instead). This restores the intended display
                  label without touching the real option name variants are
                  keyed on.
                {%- endcomment -%}
                {%- assign option_label = option.name -%}
                {%- if option_label == 'Card Chip/NFC' -%}
                  {%- assign option_label = 'Card Chip / NFC Size' -%}
                {%- endif -%}
                <div class="bset-optgroup{% unless forloop.first %} bset-optgroup--spaced{% endunless %}" role="group" aria-label="{{ option_label | escape }}">
                  <span class="bset-label">{{ option_label | escape }}</span>

                  {%- if oi == 0 -%}
                    {%- comment -%} First option is the finish — real swatches. {%- endcomment -%}
                    <div class="bset-swatches">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign val_key = value | downcase | strip
                          assign dot_color = ''
                          for sb in swatches
                            assign sb_val = sb.settings.value | downcase | strip
                            if sb.settings.product == slot and sb_val == val_key and sb.settings.color != blank
                              assign dot_color = sb.settings.color
                            endif
                          endfor
                        -%}
                        {%- if dot_color != blank -%}
                          {%- capture dot_style -%}background: {{ dot_color }};{%- endcapture -%}
                        {%- else -%}
                          {%- case val_key -%}
                            {%- when 'gold' -%}
                              {%- assign dot_style = 'background-image: linear-gradient(145deg,#E9CE86,#C9A227 52%,#9C7A1E);' -%}
                            {%- when 'rose gold' -%}
                              {%- assign dot_style = 'background-image: linear-gradient(145deg,#F0C4B4,#D08E76 52%,#A96A54);' -%}
                            {%- when 'silver' -%}
                              {%- assign dot_style = 'background-image: linear-gradient(145deg,#F2F2F2,#C4C4C4 52%,#9A9A9A);' -%}
                            {%- when 'brushed silver' -%}
                              {%- assign dot_style = 'background-image: linear-gradient(145deg,#F0F0F0,#C8C8C8 52%,#A2A2A2);' -%}
                            {%- when 'black' -%}
                              {%- assign dot_style = 'background-image: linear-gradient(145deg,#4A4A4A,#1C1C1C 52%,#0A0A0A);' -%}
                            {%- when 'white' -%}
                              {%- assign dot_style = 'background-image: linear-gradient(145deg,#FBFAF8,#E7E5DF 52%,#C9C8C2);' -%}
                            {%- when 'matte black metal' -%}
                              {%- assign dot_style = 'background-image: linear-gradient(145deg,#3C3C3C,#1A1A1A 52%,#0D0D0D);' -%}
                            {%- when 'matte black' -%}
                              {%- assign dot_style = 'background-image: linear-gradient(145deg,#3C3C3C,#1A1A1A 52%,#0D0D0D);' -%}
                            {%- when 'titanium gray' -%}
                              {%- assign dot_style = 'background-image: linear-gradient(145deg,#C6C9CD,#8E9297 52%,#6B6F74);' -%}
                            {%- else -%}
                              {%- assign dot_style = '' -%}
                          {%- endcase -%}
                        {%- endif -%}

                        <button type="button"
                                class="bset-swatch"
                                data-bset-value="{{ value | escape }}"
                                data-bset-option-index="{{ oi }}"
                                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                          <span class="bset-swatch__dot" style="{{ dot_style }}"></span>
                          <span class="bset-swatch__name">{{ value | escape }}</span>
                        </button>
                      {%- endfor -%}
                    </div>

                  {%- else -%}
                    <div class="bset-chips">
                      {%- for value in option.values -%}
                        <button type="button"
                                class="bset-chip"
                                data-bset-value="{{ value | escape }}"
                                data-bset-option-index="{{ oi }}"
                                aria-pressed="false">{{ value | escape }}</button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <p class="bset-help">
                This product is not available yet. Set its handle in the theme editor once it exists.
              </p>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- comment -%}
          The savings box only ever describes a real Shopify automatic
          discount (Ring + Metal Card), which is two products. In "bundle"
          mode (all three) that math has no single real discount to quote,
          so the box stays off and the switcher alone lets shoppers add
          any combination to cart.
        {%- endcomment -%}
        {%- if section.settings.bundle_enabled and slots.size == 2 -%}
          <div class="bset-field bset-bundlewrap">
            <div class="bset-bundle" data-bset-bundle>
              <p class="bset-bundle__eyebrow" data-bset-bundle-eyebrow>{{ section.settings.bundle_title | escape }}</p>
              <p class="bset-bundle__body" data-bset-bundle-body></p>
              <div class="bset-bundle__math" data-bset-bundle-math></div>
              <button type="button" class="bset-bundle__cta" data-bset-bundle-cta hidden></button>
            </div>
          </div>
        {%- endif -%}

        <form class="bset-buy"
              id="bset-form-{{ section.id }}"
              action="{{ routes.cart_add_url }}"
              method="post"
              enctype="multipart/form-data"
              data-bset-form>
          <input type="hidden" name="id" data-bset-variant-id
                 value="{% if first_product != blank %}{{ first_product.selected_or_first_available_variant.id }}{% endif %}">

          <div class="bset-total">
            <span class="bset-total__label">Total</span>
            <span class="bset-total__value" data-bset-total aria-live="polite">
              {%- if first_product != blank -%}{{ first_product.price_min | money }}{%- endif -%}
            </span>
          </div>
          <p class="bset-total__note" data-bset-total-note hidden></p>

          <p class="bset-alert" data-bset-alert role="alert" hidden></p>

          <button type="submit" class="bset-add" data-bset-add>Add to Cart</button>

          <p class="bset-secure">
            {% render 'bset-icon', name: 'lock' %}
            <span>{{ section.settings.secure_note | default: 'Secure Checkout' | escape }}</span>
          </p>
        </form>
      </div>

      {%- comment -%}
        Mobile-only trigger for the collapsed identity column (name,
        description, features) - see assets/optiq-buildset.css for why it
        exists and assets/optiq-buildset.js for the click handler. Placed
        after .bset-panel in the markup so it never disturbs the desktop
        grid's column auto-placement (info/stage/panel, in that DOM order);
        `order` alone repositions it on narrow screens, and it stays
        display: none above that breakpoint regardless of where it sits in
        the DOM.
      {%- endcomment -%}
      <button type="button"
              class="bset-info-toggle"
              data-bset-info-toggle
              aria-expanded="false"
              aria-controls="bset-info-{{ section.id }}">
        <span data-bset-info-toggle-label>View Product Details</span>
        <svg class="bset-info-toggle__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </div>

    {%- comment -%}
      Real catalogue data for the script. Options, values, variants, prices and
      availability all come straight from Shopify.
    {%- endcomment -%}
    <script type="application/json" data-bset-data>
      {
        "moneyFormat": {{ shop.money_format | json }},
        "bundle": {
          "enabled": {% if section.settings.bundle_enabled and slots.size == 2 %}true{% else %}false{% endif %},
          "discountCents": {{ bundle_cents | default: 0 }},
          "title": {{ section.settings.bundle_title | json }},
          "keys": [{%- for slot in slots -%}{{ slot | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
        },
        "products": {
          {%- for slot in slots -%}
            {%- liquid
              case slot
                when 'ring'
                  assign p = ring
                  assign slot_name = section.settings.ring_label | default: 'Ring'
                when 'pvc'
                  assign p = pvc
                  assign slot_name = section.settings.pvc_label | default: 'PVC Card'
                else
                  assign p = card
                  assign slot_name = section.settings.card_label | default: 'Metal Card'
              endcase
            -%}
            {{ slot | json }}: {
              "key": {{ slot | json }},
              "switchLabel": {{ slot_name | json }},
              {%- if p != blank -%}
                "id": {{ p.id }},
                "handle": {{ p.handle | json }},
                "title": {{ p.title | json }},
                "available": {{ p.available }},
                "priceFrom": {{ p.price_min }},
                "options": [
                  {%- for option in p.options_with_values -%}
                    {
                      "name": {{ option.name | json }},
                      "values": [{% for v in option.values %}{{ v | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ],
                "variants": [
                  {%- for v in p.variants -%}
                    {
                      "id": {{ v.id }},
                      "price": {{ v.price }},
                      "available": {{ v.available }},
                      "opts": [{% for o in v.options %}{{ o | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              {%- else -%}
                "id": 0,
                "handle": "",
                "title": {{ slot_name | json }},
                "available": false,
                "priceFrom": 0,
                "options": [],
                "variants": []
              {%- endif -%}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      }
    </script>
  </section>
</div>

{% schema %}
{
  "name": "Build Your Set",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "mode",
      "label": "Products shown",
      "options": [
        { "value": "both", "label": "Ring + Metal Card (switcher + bundle)" },
        { "value": "bundle", "label": "All 3 (switcher, no bundle offer)" },
        { "value": "card", "label": "Metal Card only" },
        { "value": "ring", "label": "Ring only" },
        { "value": "pvc", "label": "PVC Card only" }
      ],
      "default": "both",
      "info": "Single-product modes hide the switcher and the bundle offer automatically. The bundle offer only ever shows for exactly two products, since that's what the real Shopify discount covers."
    },
