<section class="page-hero">
  <div class="page-width">
    <h1>{{ section.settings.heading }}</h1>
  </div>
</section>

<section class="section--tight">
  <div class="page-width contact-grid">
    <div class="rte">
      {{ section.settings.intro }}
      <p><strong>Email:</strong> <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p>
      {%- if page.content != blank -%}{{ page.content }}{%- endif -%}
    </div>

    <div>
      {%- form 'contact', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-status">Thanks — your message is in. We'll get back to you within one business day.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="form-status">Something didn't go through — please check your email address and try again.</p>
        {%- endif -%}

        <div class="form-field">
          <label for="contact-name">Name</label>
          <input id="contact-name" type="text" name="contact[name]" required>
        </div>
        <div class="form-field">
          <label for="contact-email">Email</label>
          <input id="contact-email" type="email" name="contact[email]" required>
        </div>
        <div class="form-field">
          <label for="contact-business">Business name (optional)</label>
          <input id="contact-business" type="text" name="contact[business]">
        </div>
        <div class="form-field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="contact[body]" rows="6" required></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Send Message</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's get you more reviews" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Questions about your order, your review link, or bulk pricing for multiple locations? Send us a message — a real person reads every one, and we reply within one business day.</p><p>Already ordered and need to send your Google review link? Email it to us with your order number and we'll take care of the rest.</p>"
    }
  ]
}
{% endschema %}
