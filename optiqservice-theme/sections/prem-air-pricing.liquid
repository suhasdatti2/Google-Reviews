{%- comment -%}
  AI Receptionist - pricing. Two plain plan cards (Standard / Premium), each
  a single combined purchase - deliberately NOT a Build Your Set-style
  configurator. This is a service with two fixed plans, not a physical
  product with colours/sizes to choose, so there is nothing to configure.

  All real logic carried over unchanged from air-pricing.liquid:
    - the one-time setup fee and the first month are added to the cart
      TOGETHER via a Shopify cart permalink (/cart/{setup}:1,{monthly}:1),
      landing the buyer straight in Checkout with both line items, same
      mechanism as before.
    - variants are matched by option1/option2 at render time, never
      hardcoded, so recreating a variant cannot leave a card pointing at a
      dead ID.
    - the secondary "Add to Cart" button uses the theme's existing AJAX cart
      (window.optiqAddToCart) and opens the drawer, where both lines can be
      adjusted before Checkout.

  Billing toggle (Monthly / Yearly), added alongside the above: a single
  toggle above both cards switches which recurring variant (Monthly or
  Yearly) is used for BOTH the direct-checkout link and the Add to Cart
  button, on both cards at once - a shopper picks a plan (Standard/Premium)
  and a billing frequency (Monthly/Yearly) independently, same as any
  standard SaaS pricing table. The one-time setup fee is unaffected by the
  toggle since it is not a recurring charge either way.

  Both the Monthly and Yearly billing lines are rendered up front (one
  hidden via the `hidden` attribute) rather than built in JS, so the actual
  prices always come from Shopify's own variant data through Liquid's
  `money` filter - the toggle only ever flips visibility and swaps which
  precomputed href/variant id is active, never recomputes a price itself.
  The yearly "Save $X" figure is likewise computed from the variant's own
  compare_at_price, exactly like the discount badge elsewhere in this
  theme (see bset-price-tag in prem-cards-buildset.liquid) - if a yearly
  variant has no compare-at price set, no savings line renders at all.
{%- endcomment -%}

{{ 'optiq-premium.css' | asset_url | stylesheet_tag }}
{{ 'prem-air.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign air_product = section.settings.product
  if air_product == blank
    assign air_product = product
  endif
  if air_product == blank
    assign air_product = all_products['ai-receptionist']
  endif

  assign standard_setup = blank
  assign standard_monthly = blank
  assign standard_yearly = blank
  assign premium_setup = blank
  assign premium_monthly = blank
  assign premium_yearly = blank
  for v in air_product.variants
    if v.option1 == 'One-Time Setup' and v.option2 == 'Standard'
      assign standard_setup = v
    elsif v.option1 == 'Monthly' and v.option2 == 'Standard'
      assign standard_monthly = v
    elsif v.option1 == 'Yearly' and v.option2 == 'Standard'
      assign standard_yearly = v
    elsif v.option1 == 'One-Time Setup' and v.option2 == 'Premium'
      assign premium_setup = v
    elsif v.option1 == 'Monthly' and v.option2 == 'Premium'
      assign premium_monthly = v
    elsif v.option1 == 'Yearly' and v.option2 == 'Premium'
      assign premium_yearly = v
    endif
  endfor

  assign standard_plan_id = blank
  for alloc in standard_monthly.selling_plan_allocations
    if standard_plan_id == blank
      assign standard_plan_id = alloc.selling_plan.id
    endif
  endfor
  assign premium_plan_id = blank
  for alloc in premium_monthly.selling_plan_allocations
    if premium_plan_id == blank
      assign premium_plan_id = alloc.selling_plan.id
    endif
  endfor
  assign standard_yearly_plan_id = blank
  for alloc in standard_yearly.selling_plan_allocations
    if standard_yearly_plan_id == blank
      assign standard_yearly_plan_id = alloc.selling_plan.id
    endif
  endfor
  assign premium_yearly_plan_id = blank
  for alloc in premium_yearly.selling_plan_allocations
    if premium_yearly_plan_id == blank
      assign premium_yearly_plan_id = alloc.selling_plan.id
    endif
  endfor

  assign standard_ready = false
  if standard_setup != blank and standard_monthly != blank and standard_setup.available and standard_monthly.available
    assign standard_ready = true
  endif
  assign premium_ready = false
  if premium_setup != blank and premium_monthly != blank and premium_setup.available and premium_monthly.available
    assign premium_ready = true
  endif

  assign standard_yearly_ready = false
  if standard_setup != blank and standard_yearly != blank and standard_setup.available and standard_yearly.available
    assign standard_yearly_ready = true
  endif
  assign premium_yearly_ready = false
  if premium_setup != blank and premium_yearly != blank and premium_setup.available and premium_yearly.available
    assign premium_yearly_ready = true
  endif
  assign show_yearly_toggle = false
  if standard_yearly_ready or premium_yearly_ready
    assign show_yearly_toggle = true
  endif

  assign standard_yearly_save = 0
  if standard_yearly != blank and standard_yearly.compare_at_price > standard_yearly.price
    assign standard_yearly_save = standard_yearly.compare_at_price | minus: standard_yearly.price
  endif
  assign premium_yearly_save = 0
  if premium_yearly != blank and premium_yearly.compare_at_price > premium_yearly.price
    assign premium_yearly_save = premium_yearly.compare_at_price | minus: premium_yearly.price
  endif

  capture standard_href
    echo routes.cart_url | append: '/' | append: standard_setup.id | append: ':1,' | append: standard_monthly.id | append: ':1'
    if standard_plan_id != blank
      echo '?selling_plan=' | append: standard_plan_id
    endif
  endcapture
  capture premium_href
    echo routes.cart_url | append: '/' | append: premium_setup.id | append: ':1,' | append: premium_monthly.id | append: ':1'
    if premium_plan_id != blank
      echo '?selling_plan=' | append: premium_plan_id
    endif
  endcapture
  capture standard_href_yearly
    echo routes.cart_url | append: '/' | append: standard_setup.id | append: ':1,' | append: standard_yearly.id | append: ':1'
    if standard_yearly_plan_id != blank
      echo '?selling_plan=' | append: standard_yearly_plan_id
    endif
  endcapture
  capture premium_href_yearly
    echo routes.cart_url | append: '/' | append: premium_setup.id | append: ':1,' | append: premium_yearly.id | append: ':1'
    if premium_yearly_plan_id != blank
      echo '?selling_plan=' | append: premium_yearly_plan_id
    endif
  endcapture
-%}

<section class="prem-section prem-air-section" id="prem-air-pricing" {{ section.shopify_attributes }}>
  <div class="prem-wrap">
    <div class="prem-air-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="prem-config__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="prem-config__heading">{{ section.settings.heading | default: 'One plan. One checkout. Always answering.' }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="prem-config__body">{{ section.settings.sub | escape }}</p>
      {%- endif -%}

      {%- if show_yearly_toggle -%}
        <div class="prem-air-billing-toggle" role="group" aria-label="Billing frequency" data-air-billing-toggle-group>
          <button type="button" class="prem-air-billing-toggle__btn is-active" data-air-billing-toggle="monthly" aria-pressed="true">
            {{ section.settings.monthly_toggle_label | default: 'Monthly' | escape }}
          </button>
          <button type="button" class="prem-air-billing-toggle__btn" data-air-billing-toggle="yearly" aria-pressed="false">
            {{ section.settings.yearly_toggle_label | default: 'Yearly' | escape }}
            <span class="prem-air-billing-toggle__badge">{{ section.settings.yearly_toggle_badge | default: 'Pay yearly & save' | escape }}</span>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="prem-air-price__grid">

      {%- comment -%} ---- Standard ---- {%- endcomment -%}
      <article class="prem-air-price__card">
        {%- if section.settings.standard_tag != blank -%}
          <span class="prem-air-price__tag">{{ section.settings.standard_tag | escape }}</span>
        {%- endif -%}

        <h3 class="prem-air-price__name">{{ section.settings.standard_name | escape }}</h3>
        <p class="prem-air-price__note">{{ section.settings.standard_note | escape }}</p>

        <div class="prem-air-price__amount">
          <span class="prem-air-price__figure">
            {%- if standard_setup != blank -%}{{ standard_setup.price | money_without_trailing_zeros }}{%- else -%}$699{%- endif -%}
          </span>
          <span class="prem-air-price__per">{{ section.settings.standard_down_label | escape }}</span>
        </div>
        <span class="prem-air-price__billing" data-air-billing-line="monthly">
          {{ section.settings.standard_then_prefix | escape }}
          {%- if standard_monthly != blank -%}{{ standard_monthly.price | money_without_trailing_zeros }}{%- else -%}$299{%- endif -%}{{ section.settings.standard_monthly_suffix | escape }}
          &middot; {{ section.settings.standard_billing_note | escape }}
        </span>
        {%- if standard_yearly != blank -%}
          <span class="prem-air-price__billing" data-air-billing-line="yearly" hidden>
            {{ section.settings.standard_then_prefix | escape }}
            {{ standard_yearly.price | money_without_trailing_zeros }}{{ section.settings.standard_yearly_suffix | default: '/year' | escape }}
            &middot; {{ section.settings.standard_yearly_billing_note | default: 'billed annually' | escape }}
            {%- if standard_yearly_save > 0 -%}
              <span class="prem-air-price__save">{{ section.settings.yearly_save_prefix | default: 'Save' | escape }} {{ standard_yearly_save | money_without_trailing_zeros }}</span>
            {%- endif -%}
          </span>
        {%- endif -%}

        <ul class="prem-air-price__list">
          {%- assign standard_items = section.settings.standard_features | newline_to_br | split: '<br />' -%}
          {%- for item in standard_items -%}
            {%- assign line = item | strip -%}
            {%- if line != blank -%}
              <li><span class="prem-air-price__tick">{% render 'bset-icon', name: 'check-mini' %}</span>{{ line }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if standard_ready -%}
          <div class="prem-air-price__form">
            <a class="prem-air-price__btn"
               href="{{ standard_href }}"
               data-air-price-cta
               data-href-monthly="{{ standard_href }}"
               data-href-yearly="{{ standard_href_yearly }}">
              {{ section.settings.standard_cta | escape }}
            </a>
            <div class="prem-air-price__or">{{ section.settings.or_label | default: 'or' }}</div>
            <button
              type="button"
              class="prem-air-price__btn prem-air-price__btn--ghost"
              data-air-add-cart
              data-setup-id="{{ standard_setup.id }}"
              data-recurring-id-monthly="{{ standard_monthly.id }}"
              data-recurring-id-yearly="{{ standard_yearly.id }}"
              data-selling-plan-monthly="{{ standard_plan_id }}"
              data-selling-plan-yearly="{{ standard_yearly_plan_id }}"
            >
              {{ section.settings.add_to_cart_label | default: 'Add to Cart' }}
            </button>
          </div>
        {%- else -%}
          <p class="prem-air-price__safe">Currently unavailable.</p>
        {%- endif -%}

        <p class="prem-air-price__safe">{{ section.settings.trust_note | escape }}</p>
      </article>

      {%- comment -%} ---- Premium ---- {%- endcomment -%}
      <article class="prem-air-price__card prem-air-price__card--featured">
        {%- if section.settings.premium_tag != blank -%}
          <span class="prem-air-price__tag">{{ section.settings.premium_tag | escape }}</span>
        {%- endif -%}

        <h3 class="prem-air-price__name">{{ section.settings.premium_name | escape }}</h3>
        <p class="prem-air-price__note">{{ section.settings.premium_note | escape }}</p>

        <div class="prem-air-price__amount">
          <span class="prem-air-price__figure">
            {%- if premium_setup != blank -%}{{ premium_setup.price | money_without_trailing_zeros }}{%- else -%}$1,499{%- endif -%}
          </span>
          <span class="prem-air-price__per">{{ section.settings.premium_down_label | escape }}</span>
        </div>
        <span class="prem-air-price__billing" data-air-billing-line="monthly">
          {{ section.settings.premium_then_prefix | escape }}
          {%- if premium_monthly != blank -%}{{ premium_monthly.price | money_without_trailing_zeros }}{%- else -%}$599{%- endif -%}{{ section.settings.premium_monthly_suffix | escape }}
          &middot; {{ section.settings.premium_billing_note | escape }}
        </span>
        {%- if premium_yearly != blank -%}
          <span class="prem-air-price__billing" data-air-billing-line="yearly" hidden>
            {{ section.settings.premium_then_prefix | escape }}
            {{ premium_yearly.price | money_without_trailing_zeros }}{{ section.settings.premium_yearly_suffix | default: '/year' | escape }}
            &middot; {{ section.settings.premium_yearly_billing_note | default: 'billed annually' | escape }}
            {%- if premium_yearly_save > 0 -%}
              <span class="prem-air-price__save">{{ section.settings.yearly_save_prefix | default: 'Save' | escape }} {{ premium_yearly_save | money_without_trailing_zeros }}</span>
            {%- endif -%}
          </span>
        {%- endif -%}

        <ul class="prem-air-price__list">
          {%- assign premium_items = section.settings.premium_features | newline_to_br | split: '<br />' -%}
          {%- for item in premium_items -%}
            {%- assign line = item | strip -%}
            {%- if line != blank -%}
              <li><span class="prem-air-price__tick">{% render 'bset-icon', name: 'check-mini' %}</span>{{ line }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if premium_ready -%}
          <div class="prem-air-price__form">
            <a class="prem-air-price__btn"
               href="{{ premium_href }}"
               data-air-price-cta
               data-href-monthly="{{ premium_href }}"
               data-href-yearly="{{ premium_href_yearly }}">
              {{ section.settings.premium_cta | escape }}
            </a>
            <div class="prem-air-price__or">{{ section.settings.or_label | default: 'or' }}</div>
            <button
              type="button"
              class="prem-air-price__btn prem-air-price__btn--ghost"
              data-air-add-cart
              data-setup-id="{{ premium_setup.id }}"
              data-recurring-id-monthly="{{ premium_monthly.id }}"
              data-recurring-id-yearly="{{ premium_yearly.id }}"
              data-selling-plan-monthly="{{ premium_plan_id }}"
              data-selling-plan-yearly="{{ premium_yearly_plan_id }}"
            >
              {{ section.settings.add_to_cart_label | default: 'Add to Cart' }}
            </button>
          </div>
        {%- else -%}
          <p class="prem-air-price__safe">Currently unavailable.</p>
        {%- endif -%}

        <p class="prem-air-price__safe">{{ section.settings.trust_note | escape }}</p>
      </article>

    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('prem-air-pricing');
  if (!root) { return; }

  /* Shared between the billing toggle and the Add to Cart handler below -
     one switch controls which recurring variant/href both cards use. */
  var billing = 'monthly';

  var toggleBtns = [].slice.call(root.querySelectorAll('[data-air-billing-toggle]'));
  function setBilling(freq) {
    if (freq !== 'monthly' && freq !== 'yearly') { return; }
    billing = freq;

    toggleBtns.forEach(function (btn) {
      var on = btn.getAttribute('data-air-billing-toggle') === freq;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });

    [].slice.call(root.querySelectorAll('[data-air-billing-line]')).forEach(function (el) {
      el.hidden = el.getAttribute('data-air-billing-line') !== freq;
    });

    [].slice.call(root.querySelectorAll('[data-air-price-cta]')).forEach(function (a) {
      var href = a.getAttribute('data-href-' + freq);
      if (href) { a.setAttribute('href', href); }
    });
  }
  toggleBtns.forEach(function (btn) {
    btn.addEventListener('click', function () { setBilling(btn.getAttribute('data-air-billing-toggle')); });
  });

  var buttons = [].slice.call(root.querySelectorAll('[data-air-add-cart]'));
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!window.optiqAddToCart || btn.getAttribute('data-loading') === 'true') { return; }

      var setupId = btn.getAttribute('data-setup-id');
      var recurringId = btn.getAttribute('data-recurring-id-' + billing);
      if (!setupId || !recurringId) { return; }

      var items = [
        { id: setupId, quantity: 1 },
        { id: recurringId, quantity: 1 }
      ];
      var sellingPlan = btn.getAttribute('data-selling-plan-' + billing);
      if (sellingPlan) { items[1].selling_plan = sellingPlan; }

      btn.setAttribute('data-loading', 'true');
      window.optiqAddToCart(items, { trigger: btn })
        .catch(function () {})
        .then(function () { btn.removeAttribute('data-loading'); });
    });
  });
})();
</script>

{% stylesheet %}
.prem-air-billing-toggle {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  margin-top: 22px;
  padding: 4px;
  border: 1px solid var(--border, #e3e1da);
  border-radius: 999px;
  background: var(--bg-raised, #f6f5f1);
}
.prem-air-billing-toggle__btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 18px;
  border-radius: 999px;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ink-muted, #6b6a63);
  background: transparent;
  transition: background 0.15s ease, color 0.15s ease;
}
.prem-air-billing-toggle__btn.is-active {
  background: var(--ink, #1a1a1a);
  color: var(--white, #fff);
}
.prem-air-billing-toggle__badge {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.02em;
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.16);
  color: inherit;
}
.prem-air-billing-toggle__btn:not(.is-active) .prem-air-billing-toggle__badge {
  background: var(--ink, #1a1a1a);
  color: var(--white, #fff);
}
.prem-air-price__save {
  display: inline-block;
  margin-left: 8px;
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--ink, #1a1a1a);
  border: 1px solid var(--border, #e3e1da);
}

/* assets/prem-air.css sets `.prem-air-price__billing { display: block; }`,
   which is an author rule and so overrides the browser's own default
   `[hidden] { display: none }` for that element - the "hidden" attribute
   the JS toggle sets was doing nothing, and both the monthly and yearly
   lines stayed visible at once. !important guarantees this wins regardless
   of which stylesheet loads last. Also sizing the line up from the base
   12px, which read as an afterthought next to the large price figure
   above it - this is the actual recurring cost, so it should read as one. */
.prem-air-price__billing {
  font-size: 15px;
  font-weight: 600;
  color: var(--ink, #1a1a1a);
}
.prem-air-price__billing[hidden] {
  display: none !important;
}
{% endstylesheet %}

{%- comment -%} Product structured data, built from the real variants. {%- endcomment -%}
{%- if air_product != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ air_product.title | json }},
    "description": {{ air_product.description | strip_html | truncate: 300 | json }},
    "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
    "url": {{ air_product.url | prepend: shop.url | json }},
    "offers": [
      {%- for v in air_product.variants -%}
        {
          "@type": "Offer",
          "name": {{ v.title | json }},
          "price": {{ v.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ shop.currency | json }},
          "availability": {% if v.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
          "url": {{ v.url | prepend: shop.url | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

