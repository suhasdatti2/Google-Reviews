<section class="section card-showcase" id="cards">
  <div class="page-width">
    <span class="kicker">{{ section.settings.kicker }}</span>
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    <p class="section-sub">{{ section.settings.subheading }}</p>

    <div class="showcase" data-showcase>
      <div class="showcase__preview">
        {%- assign card_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="showcase__stage{% if card_i == 0 %} is-active{% endif %}" data-showcase-stage data-index="{{ card_i }}" data-card-mode="{{ block.settings.mode }}" {{ block.shopify_attributes }}>
              <div class="showcase__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: alt: block.settings.name }}
                {%- else -%}
                  {% render 'image-placeholder', label: block.settings.name | append: ' (add photo in theme editor)' %}
                {%- endif -%}
                {%- if block.settings.tag != blank -%}
                  <span class="showcase__chip"><span class="showcase__chip-dot"></span>{{ block.settings.tag }}</span>
                {%- endif -%}
              </div>
              <div class="showcase__meta">
                <h3 class="showcase__name">{{ block.settings.name }}</h3>
                {%- if block.settings.note != blank -%}<p class="showcase__note">{{ block.settings.note }}</p>{%- endif -%}
              </div>
            </div>
            {%- assign card_i = card_i | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="showcase__options" data-showcase-options>
        {%- assign opt_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <button type="button" class="showcase__option{% if opt_i == 0 %} is-active{% endif %}" data-showcase-option data-index="{{ opt_i }}" data-card-mode="{{ block.settings.mode }}" aria-label="View {{ block.settings.name }}">
              <span class="showcase__option-media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 200 | image_tag: alt: block.settings.name }}
                {%- else -%}
                  {% render 'image-placeholder', mini: true %}
                {%- endif -%}
              </span>
              <span class="showcase__option-text">
                <span class="showcase__option-name">{{ block.settings.name }}</span>
                {%- if block.settings.badge != blank -%}<span class="showcase__option-badge">{{ block.settings.badge }}</span>{%- endif -%}
              </span>
            </button>
            {%- assign opt_i = opt_i | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {% render 'card-configurator', section: section %}

    <ul class="showcase__trust" aria-label="What's included">
      <li><span class="showcase__trust-ic" aria-hidden="true"></span>Premium, high-quality card</li>
      <li><span class="showcase__trust-ic" aria-hidden="true"></span>Works with Google &amp; Yelp reviews</li>
      <li><span class="showcase__trust-ic" aria-hidden="true"></span>Programmed &amp; tap-tested for you</li>
      <li><span class="showcase__trust-ic" aria-hidden="true"></span>Ships ready to use</li>
    </ul>
    <p class="showcase__compat">Works with compatible iPhone &amp; Android phones. Questions? Email <a href="mailto:{{ settings.contact_email | default: 'sales@optiqservice.com' }}">{{ settings.contact_email | default: 'sales@optiqservice.com' }}</a>.</p>

    {%- if section.settings.show_signature_link -%}
      <p class="showcase__signature-teaser">
        <a class="showcase__signature-link" href="{{ section.settings.signature_link | default: '/pages/signature' }}">
          {{ section.settings.signature_label | default: 'Looking for something more refined? Discover Optiq Signature' }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('[data-showcase]');
  if (!root) { return; }
  var stages = [].slice.call(root.querySelectorAll('[data-showcase-stage]'));
  var options = [].slice.call(root.querySelectorAll('[data-showcase-option]'));

  function select(i) {
    for (var s = 0; s < stages.length; s++) { stages[s].classList.toggle('is-active', s === i); }
    for (var o = 0; o < options.length; o++) { options[o].classList.toggle('is-active', o === i); }
  }

  for (var o = 0; o < options.length; o++) {
    (function (btn) {
      btn.addEventListener('click', function () { select(parseInt(btn.getAttribute('data-index'), 10)); });
    })(options[o]);
  }

  function filterByMode(mode) {
    var firstVisible = -1;
    for (var i = 0; i < options.length; i++) {
      var match = options[i].getAttribute('data-card-mode') === mode;
      options[i].style.display = match ? '' : 'none';
      if (match && firstVisible === -1) { firstVisible = i; }
    }
    if (firstVisible !== -1) { select(firstVisible); }
  }

  document.addEventListener('optiq:mode-change', function (e) {
    filterByMode(e.detail.mode);
  });
})();
</script>

{% stylesheet %}
.showcase__trust {
  list-style: none;
  margin: 28px 0 0;
  padding: 20px 0 0;
  border-top: 1px solid var(--border);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px 22px;
}
.showcase__trust li {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--ink-muted);
  line-height: 1.3;
}
.showcase__trust-ic {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--bg-raised-2);
  border: 1px solid var(--border);
  position: relative;
}
.showcase__trust-ic::after {
  content: "";
  position: absolute;
  left: 6px;
  top: 4px;
  width: 4px;
  height: 8px;
  border: solid var(--ink);
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}
.showcase__compat {
  margin: 16px 0 0;
  font-size: 0.9rem;
  color: var(--ink-faint);
  line-height: 1.5;
}
.showcase__compat a { color: var(--ink-muted); text-decoration: underline; }
.showcase__signature-teaser {
  margin: 22px 0 0;
  padding-top: 22px;
  border-top: 1px solid var(--border);
}
.showcase__signature-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.94rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--ink);
  transition: opacity 0.15s ease, gap 0.15s ease;
}
.showcase__signature-link:hover { opacity: 0.7; gap: 11px; }
.showcase__signature-link svg { width: 15px; height: 15px; flex-shrink: 0; }
@media (max-width: 760px) {
  .showcase__trust {
    grid-template-columns: 1fr 1fr;
    gap: 12px 16px;
  }
  .showcase__trust li { font-size: 0.9rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Card showcase",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pick your card" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See exactly what you're getting" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tap a card to preview it. Every one is programmed with your Google review link before it ships."
    },
    { "type": "header", "content": "Purchase widget" },
    { "type": "text", "id": "counter_mode_label", "label": "Counter mode label", "default": "Counter Cards" },
    { "type": "text", "id": "bulk_mode_label", "label": "Bulk mode label", "default": "Bulk Cards" },
    { "type": "text", "id": "wristband_mode_label", "label": "Wristband mode label", "default": "Wristband" },
    { "type": "text", "id": "membership_label", "label": "Membership button text", "default": "+ Add Membership (optional)" },
    { "type": "url", "id": "membership_link", "label": "Membership link" },
    { "type": "header", "content": "Optiq Signature link" },
    { "type": "checkbox", "id": "show_signature_link", "label": "Show Optiq Signature link", "default": true },
    { "type": "text", "id": "signature_label", "label": "Link text", "default": "Looking for something more refined? Discover Optiq Signature" },
    { "type": "url", "id": "signature_link", "label": "Link URL", "info": "Defaults to /pages/signature" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Colorway / photo",
      "settings": [
        {
          "type": "select",
          "id": "mode",
          "label": "Shows under",
          "info": "Controls which toggle (Counter, Bulk, or Wristband) this photo appears under.",
          "options": [
            { "value": "counter", "label": "Counter Cards" },
            { "value": "bulk", "label": "Bulk Cards" },
            { "value": "wristband", "label": "Wristband" }
          ],
          "default": "counter"
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Counter Card - Black" },
        { "type": "textarea", "id": "note", "label": "Short description", "default": "Our premium counter card in classic matte black." },
        { "type": "image_picker", "id": "image", "label": "Card photo" },
        { "type": "text", "id": "tag", "label": "Image chip label (optional)", "default": "Premium high-quality material" },
        { "type": "text", "id": "badge", "label": "Box badge (optional)" }
      ]
    },
    {
      "type": "qty",
      "name": "Pricing option",
      "settings": [
        {
          "type": "select",
          "id": "mode",
          "label": "Card type",
          "options": [
            { "value": "counter", "label": "Counter Cards (premium)" },
            { "value": "bulk", "label": "Bulk Cards (handout)" },
            { "value": "wristband", "label": "Wristband" }
          ],
          "default": "counter"
        },
        { "type": "text", "id": "qty_label", "label": "Quantity label", "default": "1 Card" },
        { "type": "text", "id": "price", "label": "Price", "default": "$29.99" },
        { "type": "checkbox", "id": "featured", "label": "Preselect this option", "default": false },
        { "type": "text", "id": "variant_id", "label": "Variant ID (for instant add-to-cart)", "info": "Optional. Paste the Shopify variant ID so this button adds straight to the cart. Leave blank to link to the product page instead." },
        { "type": "url", "id": "link", "label": "Product link (used when no variant ID)" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Card showcase",
      "blocks": [
        { "type": "card" },
        { "type": "qty", "settings": { "mode": "counter", "qty_label": "1 Card", "price": "$29.99", "featured": true } },
        { "type": "qty", "settings": { "mode": "counter", "qty_label": "2 Cards", "price": "$49.99" } },
        { "type": "qty", "settings": { "mode": "counter", "qty_label": "3 Cards", "price": "$64.99" } },
        { "type": "qty", "settings": { "mode": "bulk", "qty_label": "10 Cards", "price": "$49.99", "featured": true } },
        { "type": "qty", "settings": { "mode": "bulk", "qty_label": "25 Cards", "price": "$99.99" } },
        { "type": "qty", "settings": { "mode": "bulk", "qty_label": "50 Cards", "price": "$174.99" } },
        { "type": "qty", "settings": { "mode": "bulk", "qty_label": "100 Cards", "price": "$299.99" } }
      ]
    }
  ]
}
{% endschema %}
