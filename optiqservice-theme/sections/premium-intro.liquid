{%- comment -%}
  Premium Products - "Introducing Optiq Signature" split. Text left,
  product lifestyle photo right - matches the reference wireframe's
  second block exactly.
{%- endcomment -%}

<section class="prem-section prem-intro" id="prem-intro" {{ section.shopify_attributes }}>
  <div class="prem-wrap">
    <div class="prem-intro__grid">
      <div>
        <p class="prem-intro__eyebrow">{{ section.settings.eyebrow | default: 'Introducing' | escape }}</p>
        <h2 class="prem-intro__heading">{{ section.settings.heading | default: 'Optiq Signature' }}</h2>
        {%- if section.settings.body != blank -%}
          <p class="prem-intro__body">{{ section.settings.body }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="prem-link" href="{{ section.settings.cta_link | default: '#prem-showcase' }}">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>

      <div class="prem-intro__media">
        {% render 'prem-media', image: section.settings.image, label: 'Product lifestyle image' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Premium intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Introducing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Optiq Signature" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Premium Rings and Metal Cards, crafted for those who lead, build, and leave a lasting impression." },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Discover the collection" },
    { "type": "url", "id": "cta_link", "label": "Link URL", "info": "Defaults to #prem-showcase, which scrolls to the Ring / Metal Cards section below." },
    { "type": "image_picker", "id": "image", "label": "Product lifestyle photo" }
  ],
  "presets": [{ "name": "Premium intro" }]
}
{% endschema %}
