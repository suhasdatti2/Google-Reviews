{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — Coming Soon</title>
  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <div class="password-page">
    <div>
      <span class="kicker">OptiqService</span>
      <h1>Get More Google Reviews With One Tap</h1>
      <p class="section-sub" style="margin: 16px auto 0;">We're putting the finishing touches on the store. Check back soon.</p>
      {% form 'storefront_password' %}
        <input type="password" name="password" placeholder="Store password" aria-label="Store password">
        <button type="submit" class="btn btn--primary">Enter</button>
      {% endform %}
    </div>
  </div>
</body>
</html>
