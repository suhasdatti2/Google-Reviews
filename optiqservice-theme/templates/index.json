    "faq": {
      "type": "faq",
      "blocks": {
        "q1": { "type": "question", "settings": { "question": "How does the card work?", "answer": "Each card has a chip inside, programmed with your review link. When a customer holds their phone near the card, their phone opens your review page automatically - the same tap technology used for contactless payments." } },
        "q2": { "type": "question", "settings": { "question": "Do my customers need an app or a QR code?", "answer": "No. Tap works with the phone's built-in settings on nearly all modern iPhones and Androids - nothing to download, nothing to scan. A printed QR code can be added as an optional backup if you want one." } },
        "q3": { "type": "question", "settings": { "question": "How do you program my review link?", "answer": "At checkout, enter your business name and your Google or Yelp review link. We program your card, test it on iPhone and Android, and ship it ready to use - nothing for you to set up." } },
        "q11": { "type": "question", "settings": { "question": "What comes with my order?", "answer": "You get your review card (or cards), already programmed with your Google or Yelp review link and tested on iPhone and Android. Nothing to set up - just place it where customers can tap it." } },
        "q9": { "type": "question", "settings": { "question": "How fast will my card ship?", "answer": "Every card is programmed with your review link and tap-tested before it ships. Most orders are prepared within a few business days, and you'll get a tracking email as soon as yours is on the way." } },
        "q10": { "type": "question", "settings": { "question": "What if my card arrives faulty?", "answer": "If a card ever arrives damaged or doesn't tap correctly, email sales@optiqservice.com and we'll sort out a replacement. Because each card is custom-programmed with your review link, we can't take back correctly working cards - but if something isn't right, we're happy to help." } },
        "q4": { "type": "question", "settings": { "question": "What's the difference between the Main Counter Card and Mini Bulk Cards?", "answer": "The Main Counter Card is bigger and built to stay on your counter for years - it costs more because it's made to last and be seen every day. Mini Bulk Cards are smaller and cheaper per card, made to hand out with bills, receipts, and takeout orders. Both open the same review page with one tap." } },
        "q5": { "type": "question", "settings": { "question": "What if I don't know my review link?", "answer": "Order anyway. Email us at sales@optiqservice.com and we'll send you a quick guide to finding it, or find it for you if you share your business name and city." } },
        "q6": { "type": "question", "settings": { "question": "Is there a monthly fee?", "answer": "No. Every card is a one-time purchase. The Review Growth Plan is a separate, optional membership - you never need it for your card to work." } },
        "q7": { "type": "question", "settings": { "question": "Which phones does this work with?", "answer": "Almost all iPhones and Android phones released in the last several years support tap by default. Customers with older phones can still search for your business the usual way." } },
        "q8": { "type": "question", "settings": { "question": "Does this guarantee good reviews?", "answer": "No - and we wouldn't trust anyone who claims it does. What the card does is remove the friction: instead of searching for your business and finding the review button, customers get there in one tap. What they write is entirely up to them." } }
